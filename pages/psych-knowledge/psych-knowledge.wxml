<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">情绪知识库</text>
    <text class="page-subtitle">用知识照亮感受，让理解带来改变</text>
  </view>

  <!-- 分类导航 - 思维导图风格 -->
  <view class="category-nav">
    <view
      class="category-branch {{activeCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      bindtap="switchCategory"
      data-id="{{item.id}}"
    >
      <view class="branch-dot" style="background:{{item.color}};"></view>
      <view class="branch-line" style="background:{{item.color}};opacity:{{activeCategory === item.id ? 1 : 0.3}};"></view>
      <view class="branch-content">
        <text class="branch-name">{{item.name}}</text>
        <text class="branch-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 主题列表 -->
  <view class="topics-area">
    <block wx:for="{{categories}}" wx:key="id">
      <block wx:if="{{activeCategory === item.id}}">
        <view class="topic-list">
          <view
            class="topic-card {{expandedTopic === topic.id ? 'expanded' : ''}}"
            wx:for="{{item.topics}}"
            wx:for-item="topic"
            wx:key="id"
          >
            <!-- 主题卡片头部 -->
            <view class="topic-header" bindtap="toggleTopic" data-id="{{topic.id}}">
              <view class="topic-icon">
                <!-- 放大镜：情绪颗粒度 -->
                <block wx:if="{{topic.iconType === 'magnifier'}}">
                  <view class="ticon-magnifier">
                    <view class="mag-lens"></view>
                    <view class="mag-handle"></view>
                  </view>
                </block>
                <!-- 大脑：认知扭曲 -->
                <block wx:elif="{{topic.iconType === 'brain'}}">
                  <view class="ticon-brain">
                    <view class="brain-left"></view>
                    <view class="brain-right"></view>
                    <view class="brain-stem"></view>
                  </view>
                </block>
                <!-- 链接：依恋理论 -->
                <block wx:elif="{{topic.iconType === 'link'}}">
                  <view class="ticon-link">
                    <view class="link-ring lr1"></view>
                    <view class="link-ring lr2"></view>
                  </view>
                </block>
                <!-- 循环：反刍思维 -->
                <block wx:elif="{{topic.iconType === 'loop'}}">
                  <view class="ticon-loop">
                    <view class="loop-circle"></view>
                    <view class="loop-arrow"></view>
                  </view>
                </block>
                <!-- 对话泡泡：非暴力沟通 -->
                <block wx:elif="{{topic.iconType === 'bubble'}}">
                  <view class="ticon-bubble">
                    <view class="bub-main"></view>
                    <view class="bub-tail"></view>
                    <view class="bub-small"></view>
                  </view>
                </block>
              </view>
              <view class="topic-info">
                <text class="topic-title">{{topic.title}}</text>
                <text class="topic-subtitle">{{topic.subtitle}}</text>
              </view>
              <view class="topic-arrow {{expandedTopic === topic.id ? 'rotated' : ''}}">
                <text class="arrow-icon">›</text>
              </view>
            </view>

            <!-- 展开后的知识内容 -->
            <view class="topic-body" wx:if="{{expandedTopic === topic.id}}">
              <!-- section 标签导航 -->
              <scroll-view class="section-tabs" scroll-x>
                <view
                  class="section-tab {{activeSectionIndex === sIndex ? 'active' : ''}}"
                  wx:for="{{topic.sections}}"
                  wx:for-item="section"
                  wx:for-index="sIndex"
                  wx:key="title"
                  bindtap="switchSection"
                  data-index="{{sIndex}}"
                >
                  <text>{{section.title}}</text>
                </view>
              </scroll-view>

              <!-- section 内容 -->
              <block wx:for="{{topic.sections}}" wx:for-item="section" wx:for-index="sIndex" wx:key="title">
                <view class="section-content" wx:if="{{activeSectionIndex === sIndex}}">

                  <!-- 普通文本类型 -->
                  <block wx:if="{{section.type === 'concept' || section.type === 'why' || section.type === 'exercise' || section.type === 'source'}}">
                    <view class="content-card">
                      <text class="content-text">{{section.content}}</text>
                    </view>
                  </block>

                  <!-- 列表类型 -->
                  <block wx:if="{{section.type === 'list'}}">
                    <view class="list-cards">
                      <view class="list-item-card" wx:for="{{section.items}}" wx:for-item="listItem" wx:key="name">
                        <text class="list-item-name">{{listItem.name}}</text>
                        <text class="list-item-desc">{{listItem.desc}}</text>
                        <view class="list-item-example">
                          <text class="example-text">{{listItem.example}}</text>
                        </view>
                      </view>
                    </view>
                  </block>
                </view>
              </block>

              <!-- 底部：和小知聊聊 -->
              <view class="topic-footer">
                <view class="chat-link" bindtap="goToChat" data-topic-id="{{topic.id}}">
                  <text class="chat-link-text">想聊聊这个话题？找小知</text>
                  <text class="chat-link-arrow">→</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>
  </view>

  <!-- 底部说明 -->
  <view class="footer-note">
    <text class="note-text">以上内容基于循证心理学研究，不替代专业心理咨询。</text>
  </view>
</view>
