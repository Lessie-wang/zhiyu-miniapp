/* 知识库页面样式 */
page {
  box-sizing: border-box;
  overflow-x: hidden;
  width: 100%;
}

.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 0 40rpx 60rpx;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 页面标题 */
.page-header {
  padding: 48rpx 0 28rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #6D6A65;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
  margin-top: 8rpx;
}

/* 分类导航 - 思维导图风格 */
.category-nav {
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  position: relative;
  margin-bottom: 32rpx;
}

.category-branch {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 0;
  opacity: 0.5;
  transition: opacity 0.3s;
}

.category-branch.active {
  opacity: 1;
}

.branch-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.category-branch.active .branch-dot {
  width: 24rpx;
  height: 24rpx;
  box-shadow: 0 0 12rpx currentColor;
}

.branch-line {
  width: 32rpx;
  height: 3rpx;
  flex-shrink: 0;
  border-radius: 2rpx;
}

.branch-content {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.branch-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #6D6A65;
}

.category-branch.active .branch-name {
  font-size: 32rpx;
  font-weight: 700;
}

.branch-desc {
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

/* 主题列表 */
.topics-area {
  padding: 0;
  overflow: hidden;
  width: 100%;
}

.topic-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

/* 主题卡片 */
.topic-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(212, 184, 165, 0.1);
  transition: box-shadow 0.3s;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

.topic-card.expanded {
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 165, 0.2);
}

.topic-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 16rpx;
}

.topic-header:active {
  background: #FAF9F7;
}

.topic-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FAF9F7;
  border-radius: 14rpx;
}

/* ==================== 知识库主题 CSS 图标 ==================== */

/* 放大镜 - 情绪颗粒度 */
.ticon-magnifier {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}
.ticon-magnifier .mag-lens {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #D4B8A5;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
}
.ticon-magnifier .mag-handle {
  width: 3rpx;
  height: 12rpx;
  background: #D4B8A5;
  border-radius: 2rpx;
  position: absolute;
  bottom: 0;
  right: 4rpx;
  transform: rotate(-45deg);
}

/* 大脑 - 认知扭曲 */
.ticon-brain {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.ticon-brain .brain-left {
  width: 12rpx;
  height: 18rpx;
  border: 3rpx solid #C4B5D8;
  border-right: none;
  border-radius: 12rpx 0 0 12rpx;
  position: absolute;
  left: 2rpx;
  top: 2rpx;
}
.ticon-brain .brain-right {
  width: 12rpx;
  height: 18rpx;
  border: 3rpx solid #C4B5D8;
  border-left: none;
  border-radius: 0 12rpx 12rpx 0;
  position: absolute;
  right: 2rpx;
  top: 2rpx;
}
.ticon-brain .brain-stem {
  width: 8rpx;
  height: 3rpx;
  background: #C4B5D8;
  border-radius: 2rpx;
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 链接环 - 依恋理论 */
.ticon-link {
  width: 36rpx;
  height: 20rpx;
  position: relative;
  display: flex;
  align-items: center;
}
.ticon-link .link-ring {
  width: 20rpx;
  height: 16rpx;
  border: 3rpx solid #C4B5D8;
  border-radius: 10rpx;
  position: absolute;
}
.ticon-link .link-ring.lr1 {
  left: 0;
}
.ticon-link .link-ring.lr2 {
  right: 0;
}

/* 循环箭头 - 反刍思维 */
.ticon-loop {
  width: 28rpx;
  height: 28rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ticon-loop .loop-circle {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #C4B5D8;
  border-radius: 50%;
  border-top-color: transparent;
}
.ticon-loop .loop-arrow {
  position: absolute;
  top: 1rpx;
  right: 4rpx;
  width: 0;
  height: 0;
  border-left: 5rpx solid transparent;
  border-right: 5rpx solid transparent;
  border-bottom: 7rpx solid #C4B5D8;
}

/* 对话泡泡 - 非暴力沟通 */
.ticon-bubble {
  width: 32rpx;
  height: 28rpx;
  position: relative;
}
.ticon-bubble .bub-main {
  width: 24rpx;
  height: 18rpx;
  background: #D4B8A5;
  border-radius: 12rpx;
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0.7;
}
.ticon-bubble .bub-tail {
  position: absolute;
  bottom: 6rpx;
  left: 4rpx;
  width: 0;
  height: 0;
  border-right: 8rpx solid #D4B8A5;
  border-bottom: 6rpx solid transparent;
  opacity: 0.7;
}
.ticon-bubble .bub-small {
  width: 16rpx;
  height: 12rpx;
  border: 2rpx solid #D4B8A5;
  border-radius: 8rpx;
  position: absolute;
  bottom: 0;
  right: 0;
  opacity: 0.5;
}

.topic-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.topic-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.topic-subtitle {
  font-size: 24rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

.topic-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.3s;
}

.topic-arrow.rotated {
  transform: rotate(90deg);
}

.arrow-icon {
  font-size: 36rpx;
  color: #B8B2A7;
  font-weight: 600;
}

/* 展开后的内容区 */
.topic-body {
  border-top: 1rpx solid rgba(212, 184, 165, 0.15);
  animation: slideDown 0.3s ease-out;
  overflow: hidden;
  max-width: 100%;
  box-sizing: border-box;
}

@keyframes slideDown {
  from { opacity: 0; max-height: 0; }
  to { opacity: 1; max-height: 2000rpx; }
}

/* section 标签导航 */
.section-tabs {
  white-space: nowrap;
  padding: 16rpx 32rpx 0;
  box-sizing: border-box;
}

.section-tab {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 10rpx;
  font-size: 22rpx;
  color: #B8B2A7;
  background: #FAF9F7;
  border-radius: 20rpx;
  font-weight: 500;
}

.section-tab.active {
  color: white;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  font-weight: 600;
}

/* section 内容 */
.section-content {
  padding: 20rpx 32rpx;
  overflow: hidden;
  box-sizing: border-box;
}

/* 普通文本卡片 */
.content-card {
  background: #FAF9F7;
  border-radius: 14rpx;
  padding: 28rpx 32rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.content-text {
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.8;
  word-break: break-word;
}

/* 列表类型卡片 */
.list-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item-card {
  background: #FAF9F7;
  border-radius: 14rpx;
  padding: 24rpx 28rpx;
  border-left: 6rpx solid #D4B8A5;
}

.list-item-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #6D6A65;
}

.list-item-desc {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 6rpx;
  word-break: break-word;
}

.list-item-example {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  background: white;
  border-radius: 10rpx;
}

.example-text {
  font-size: 22rpx;
  color: #8a8278;
  line-height: 1.6;
  font-style: italic;
  word-break: break-word;
}

/* 底部跳转 */
.topic-footer {
  padding: 12rpx 32rpx 24rpx;
}

.chat-link {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(212,184,165,0.1) 0%, rgba(196,168,147,0.1) 100%);
  border-radius: 16rpx;
  border: 1rpx dashed rgba(212, 184, 165, 0.4);
}

.chat-link:active {
  background: linear-gradient(135deg, rgba(212,184,165,0.2) 0%, rgba(196,168,147,0.2) 100%);
}

.chat-link-text {
  font-size: 26rpx;
  color: #C4A893;
  font-weight: 500;
}

.chat-link-arrow {
  font-size: 28rpx;
  color: #C4A893;
}

/* 底部说明 */
.footer-note {
  padding: 32rpx 0;
  text-align: center;
}

.note-text {
  font-size: 22rpx;
  color: #B8B2A7;
  line-height: 1.6;
}
