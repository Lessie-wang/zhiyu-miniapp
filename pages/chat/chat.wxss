/* AI 对话页面样式 - 言心小筑 - 知愈调性增强版 */

page {
  height: 100vh;
  overflow: hidden;
  background: #FAF9F7;
}

.container {
  height: 100vh;
  background:
    radial-gradient(circle at 30% 20%, rgba(245, 198, 203, 0.18) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.15) 0%, transparent 50%),
    radial-gradient(circle at 50% 50%, rgba(196, 181, 216, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse at top left, #FAF9F7 0%, #F5F0EB 40%, #F2E6DF 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* 言心小筑装饰背景 - 水彩纸张纹理 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 3rpx, rgba(212, 184, 165, 0.02) 3rpx, rgba(212, 184, 165, 0.02) 6rpx),
    repeating-linear-gradient(90deg, transparent, transparent 3rpx, rgba(212, 184, 165, 0.02) 3rpx, rgba(212, 184, 165, 0.02) 6rpx);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
}

/* 飘落花瓣装饰 */
.container::after {
  content: '';
  position: fixed;
  top: -10%;
  left: -10%;
  right: -10%;
  bottom: -10%;
  background-image:
    radial-gradient(circle at 15% 20%, rgba(245, 198, 203, 0.15) 0%, transparent 3%),
    radial-gradient(circle at 85% 40%, rgba(196, 181, 216, 0.12) 0%, transparent 3%),
    radial-gradient(circle at 45% 60%, rgba(212, 184, 165, 0.1) 0%, transparent 3%),
    radial-gradient(circle at 75% 80%, rgba(245, 198, 203, 0.13) 0%, transparent 3%);
  animation: petalFloat 20s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

@keyframes petalFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
    opacity: 0.6;
  }
  50% {
    transform: translateY(100rpx) rotate(180deg);
    opacity: 0.9;
  }
}

/* ==================== 顶部小知卡片 - 言心小筑风格 ==================== */
.ai-profile {
  position: relative;
  z-index: 100;
  margin: calc(env(safe-area-inset-top) + 80rpx) 24rpx 0;
  padding: 28rpx 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 253, 250, 0.88) 100%);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 32rpx;
  box-shadow:
    0 12rpx 40rpx rgba(212, 184, 165, 0.18),
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(212, 184, 165, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  animation: cardSlideIn 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

/* 卡片装饰边框 */
.ai-profile::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border: 1rpx solid rgba(245, 198, 203, 0.2);
  border-radius: 24rpx;
  pointer-events: none;
}

/* 卡片光晕效果 */
.ai-profile::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(245, 198, 203, 0.15) 0%, transparent 50%);
  animation: cardGlow 8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes cardGlow {
  0%, 100% {
    transform: translate(0, 0);
    opacity: 0.5;
  }
  50% {
    transform: translate(25%, 25%);
    opacity: 0.8;
  }
}

@keyframes cardSlideIn {
  0% {
    opacity: 0;
    transform: translateY(-40rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 小知头像 + 信息 */
.ai-center {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.ai-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(245, 198, 203, 0.4);
  margin-right: 20rpx;
  box-shadow:
    0 6rpx 20rpx rgba(212, 184, 165, 0.25),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
  animation: avatarGlow 3s ease-in-out infinite;
  position: relative;
  overflow: hidden;
}

/* 头像光晕装饰 */
.ai-avatar::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.4) 0%, transparent 60%);
  animation: avatarShine 4s ease-in-out infinite;
}

@keyframes avatarShine {
  0%, 100% {
    transform: translate(-25%, -25%) scale(0.8);
    opacity: 0.3;
  }
  50% {
    transform: translate(-25%, -25%) scale(1.2);
    opacity: 0.6;
  }
}

@keyframes avatarGlow {
  0%, 100% {
    box-shadow:
      0 6rpx 20rpx rgba(245, 198, 203, 0.25),
      inset 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
  }
  50% {
    box-shadow:
      0 8rpx 28rpx rgba(245, 198, 203, 0.4),
      0 4rpx 16rpx rgba(196, 181, 216, 0.2),
      inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
  }
}

.ai-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ai-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D3D3D;
  line-height: 1.2;
  letter-spacing: 0.5rpx;
}

.ai-desc {
  font-size: 24rpx;
  color: #8B7B6F;
  line-height: 1.3;
}

/* 右侧按钮组 */
.header-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.history-btn,
.end-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.history-btn:active,
.end-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.2);
}

.history-css-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
}

.hbook-spine {
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 4rpx;
  height: 24rpx;
  background: #D4B8A5;
  border-radius: 2rpx;
}

.hbook-body {
  position: absolute;
  left: 4rpx;
  top: 0;
  width: 24rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #F5C6CB 0%, #D4B8A5 100%);
  border-radius: 0 4rpx 4rpx 0;
}

.end-icon {
  font-size: 32rpx;
  color: #D4B8A5;
  font-weight: 700;
}

/* ==================== 情绪标签 - 言心小筑风格 ==================== */
.emotion-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  animation: tagsSlideIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s backwards;
  position: relative;
}

/* 标签区域装饰线 */
.emotion-tags::before {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(212, 184, 165, 0.2), transparent);
}

@keyframes tagsSlideIn {
  0% {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.tag {
  padding: 10rpx 24rpx;
  background:
    linear-gradient(135deg,
      rgba(245, 198, 203, 0.25) 0%,
      rgba(212, 184, 165, 0.2) 100%);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #6D6A65;
  font-weight: 500;
  border: 1rpx solid rgba(245, 198, 203, 0.35);
  box-shadow:
    0 2rpx 8rpx rgba(212, 184, 165, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

/* 标签光晕效果 */
.tag::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.3) 0%, transparent 60%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tag:active::before {
  opacity: 1;
}

.body-tag {
  background:
    linear-gradient(135deg,
      rgba(196, 212, 181, 0.25) 0%,
      rgba(196, 181, 216, 0.2) 100%);
  border-color: rgba(196, 212, 181, 0.35);
}

/* ==================== 对话区域 ==================== */
.chat-area {
  flex: 1;
  padding: 0 24rpx 24rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 20rpx;
}

.chat-messages-bottom {
  justify-content: flex-end;
  min-height: 100%;
}

/* 消息气泡 */
.message {
  display: flex;
  animation: messageSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes messageSlideIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.ai-message {
  justify-content: flex-start;
}

.user-message {
  justify-content: flex-end;
}

.message-content {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  word-wrap: break-word;
}

.ai-message .message-content {
  background:
    linear-gradient(135deg,
      rgba(255, 250, 245, 0.95) 0%,
      rgba(255, 248, 240, 0.92) 50%,
      rgba(250, 243, 237, 0.9) 100%);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
  border: 1rpx solid rgba(212, 184, 165, 0.35);
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

/* AI消息装饰 - 水彩边框 */
.ai-message .message-content::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border: 1rpx solid rgba(245, 198, 203, 0.15);
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  pointer-events: none;
}

.user-message .message-content {
  background:
    linear-gradient(135deg,
      rgba(245, 198, 203, 0.95) 0%,
      rgba(255, 220, 225, 0.9) 50%,
      rgba(255, 230, 235, 0.85) 100%);
  color: white;
  border-radius: 24rpx 24rpx 4rpx 24rpx;
  box-shadow:
    0 4rpx 16rpx rgba(245, 198, 203, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
  position: relative;
  overflow: hidden;
}

/* 用户消息装饰 */
.user-message .message-content::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx 20rpx 4rpx 20rpx;
  pointer-events: none;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #2D2D2D;
  font-weight: 400;
}

.user-message .message-text {
  color: white;
  font-weight: 500;
}

/* 欢迎消息特殊样式 */
.welcome-message {
  justify-content: center;
}

.welcome-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, rgba(244, 235, 225, 0.95) 0%, rgba(250, 243, 237, 0.9) 100%);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(212, 184, 165, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 165, 0.15);
}

.welcome-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.welcome-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.welcome-label {
  display: block;
  font-size: 26rpx;
  color: #B89D8A;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.welcome-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #2D2D2D;
  font-weight: 400;
}

/* 小知思考中 */
.thinking {
  display: flex;
  justify-content: flex-start;
}

.thinking-bubble {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(244, 235, 225, 0.95) 0%, rgba(250, 243, 237, 0.9) 100%);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 24rpx 24rpx 24rpx 4rpx;
  border: 1rpx solid rgba(212, 184, 165, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.thinking-text {
  font-size: 26rpx;
  color: #6D5D51;
  font-weight: 500;
}

.thinking-dots {
  display: flex;
  flex-direction: row;
  gap: 6rpx;
}

.thinking-dots .dot {
  width: 8rpx;
  height: 8rpx;
  background: #D4B8A5;
  border-radius: 50%;
  animation: thinking 1.4s infinite ease-in-out;
}

.thinking-dots .dot:nth-child(1) { animation-delay: 0s; }
.thinking-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.thinking-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes thinking {
  0%, 60%, 100% { transform: scale(1); opacity: 0.5; }
  30% { transform: scale(1.5); opacity: 1; }
}

/* ==================== 历史对话侧边栏 ==================== */
.sidebar-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.history-sidebar {
  position: fixed;
  top: 0;
  left: -85%;
  width: 85%;
  height: 100vh;
  background: linear-gradient(180deg, #FAF9F7 0%, #F2E6DF 100%);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  box-shadow: 8rpx 0 32rpx rgba(0, 0, 0, 0.15);
  transition: left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.history-sidebar.show {
  left: 0;
}

.sidebar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 32rpx 32rpx;
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.2);
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.sidebar-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D3D3D;
  letter-spacing: 0.5rpx;
}

.sidebar-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
}

.sidebar-close:active {
  background: rgba(212, 184, 165, 0.2);
  transform: scale(0.9);
}

.close-icon {
  font-size: 32rpx;
  color: #8B7B6F;
  font-weight: 700;
}

.sidebar-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.new-conversation-btn {
  margin: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #F5C6CB 0%, #E8B8BE 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 198, 203, 0.3);
  transition: all 0.3s ease;
}

.new-conversation-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(245, 198, 203, 0.4);
}

.new-icon {
  font-size: 36rpx;
  color: white;
  font-weight: 300;
}

.new-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}

.conversation-list {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.conversation-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(212, 184, 165, 0.2);
  transition: all 0.3s ease;
}

.conversation-item:active {
  background: rgba(255, 255, 255, 0.95);
  transform: scale(0.98);
}

.conv-emotions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.conv-emotion-tag {
  padding: 4rpx 12rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.conv-preview {
  display: block;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.5;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conv-time {
  font-size: 22rpx;
  color: #B8B2A7;
}

.conversation-empty {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #B8B2A7;
}

/* ==================== 结束对话弹窗 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  z-index: 9998;
  animation: fadeIn 0.3s ease;
}

.end-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 560rpx;
  z-index: 9999;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}

.end-modal.show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  pointer-events: auto;
}

.modal-content {
  background: linear-gradient(135deg, #FAF9F7 0%, #F5F0EB 100%);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.15),
    0 8rpx 32rpx rgba(212, 184, 165, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.modal-header {
  padding: 48rpx 40rpx 24rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.15);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D3D3D;
  letter-spacing: 0.5rpx;
}

.modal-body {
  padding: 32rpx 40rpx;
  text-align: center;
}

.modal-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: #6D6A65;
  font-weight: 400;
}

.modal-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 24rpx 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.modal-btn:active {
  transform: scale(0.96);
}

.cancel-btn {
  background: rgba(255, 255, 255, 0.9);
  color: #6D6A65;
  border: 2rpx solid rgba(212, 184, 165, 0.3);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.cancel-btn:active {
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.confirm-btn {
  background: linear-gradient(135deg, #F5C6CB 0%, #E8B8BE 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(245, 198, 203, 0.35);
  border: none;
}

.confirm-btn:active {
  box-shadow: 0 4rpx 16rpx rgba(245, 198, 203, 0.4);
}

/* ==================== 底部输入区域 ==================== */
.input-area {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(212, 184, 165, 0.15);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.chat-input-wrap {
  flex: 1;
  min-height: 80rpx;
  max-height: 200rpx;
  padding: 20rpx 24rpx;
  background: #FAF9F7;
  border-radius: 24rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.chat-input-wrap:focus-within {
  border-color: #F5C6CB;
  background: white;
  box-shadow: 0 4rpx 12rpx rgba(245, 198, 203, 0.15);
}

.chat-input {
  width: 100%;
  min-height: 40rpx;
  font-size: 28rpx;
  color: #3D3D3D;
  line-height: 1.5;
}

.send-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  background: linear-gradient(135deg, #F5C6CB 0%, #E8B8BE 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(245, 198, 203, 0.3);
  flex-shrink: 0;
  margin-bottom: 4rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.send-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 8rpx rgba(245, 198, 203, 0.4);
}

.send-icon {
  font-size: 32rpx;
  color: white;
  font-weight: 700;
}

/* ==================== 消息操作按钮 ==================== */
.message-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.copy-btn,
.favorite-btn,
.regenerate-btn,
.edit-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  opacity: 0.6;
  transition: opacity 0.3s ease;
}

.copy-btn:active,
.favorite-btn:active,
.regenerate-btn:active,
.edit-btn:active {
  opacity: 1;
}

.favorite-btn.favorited {
  opacity: 1;
}

.copy-text,
.favorite-text,
.regenerate-text,
.edit-text {
  font-size: 22rpx;
  color: #B8B2A7;
}

.user-message .copy-text,
.user-message .edit-text {
  color: rgba(255, 255, 255, 0.8);
}

.favorite-btn.favorited .favorite-text {
  color: #D4B8A5;
  font-weight: 600;
}

/* ==================== CSS 图标 ==================== */

/* 复制图标 */
.copy-css-icon {
  width: 18rpx;
  height: 20rpx;
  position: relative;
}

.clipboard-back {
  position: absolute;
  top: 0;
  left: 0;
  width: 14rpx;
  height: 16rpx;
  border: 1.5rpx solid #B8B2A7;
  border-radius: 2rpx;
}

.clipboard-front {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 14rpx;
  height: 16rpx;
  border: 1.5rpx solid #B8B2A7;
  border-radius: 2rpx;
  background: white;
}

.user-message .clipboard-back,
.user-message .clipboard-front {
  border-color: rgba(255, 255, 255, 0.6);
}

.user-message .clipboard-front {
  background: transparent;
}

/* 收藏图标 */
.star-css-icon {
  width: 18rpx;
  height: 18rpx;
  position: relative;
}

.star-shape {
  width: 18rpx;
  height: 18rpx;
  background: transparent;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  border: 1.5rpx solid #B8B2A7;
}

.favorite-btn.favorited .star-shape {
  background: #D4B8A5;
  border-color: #D4B8A5;
}

/* 刷新图标 */
.regen-css-icon {
  width: 18rpx;
  height: 18rpx;
  position: relative;
}

.regen-circle {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid #B8B2A7;
  border-radius: 50%;
  border-top-color: transparent;
}

.regen-arrow {
  position: absolute;
  top: 0;
  right: 1rpx;
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-bottom: 5rpx solid #B8B2A7;
}

/* 编辑图标 */
.edit-css-icon {
  width: 18rpx;
  height: 20rpx;
  position: relative;
}

.pencil-body {
  width: 6rpx;
  height: 14rpx;
  background: #D4B8A5;
  border-radius: 2rpx 2rpx 0 0;
  transform: rotate(-25deg);
  position: absolute;
  top: 0;
  left: 6rpx;
}

.pencil-tip {
  width: 0;
  height: 0;
  border-left: 3rpx solid transparent;
  border-right: 3rpx solid transparent;
  border-top: 5rpx solid #D4B8A5;
  transform: rotate(-25deg);
  position: absolute;
  top: 13rpx;
  left: 6rpx;
}

.user-message .pencil-body {
  background: rgba(255, 255, 255, 0.7);
}

.user-message .pencil-tip {
  border-top-color: rgba(255, 255, 255, 0.7);
}

/* ==================== 版本切换 ==================== */
.version-indicator {
  margin-top: 8rpx;
}

.version-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.version-btn {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(184, 178, 167, 0.4);
  border-radius: 50%;
  border: 1rpx solid rgba(184, 178, 167, 0.6);
  transition: all 0.3s ease;
}

.version-btn:active {
  background: rgba(184, 178, 167, 0.6);
}

.version-arrow {
  font-size: 28rpx;
  color: #6D6A65;
  font-weight: 700;
}

.version-text {
  font-size: 24rpx;
  color: #6D6A65;
  font-weight: 600;
  min-width: 60rpx;
  text-align: center;
}

.user-message .version-btn {
  background: rgba(255, 255, 255, 0.3);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.user-message .version-btn:active {
  background: rgba(255, 255, 255, 0.5);
}

.user-message .version-arrow,
.user-message .version-text {
  color: white;
}

/* ==================== 编辑模式 ==================== */
.editing-container {
  width: 100%;
}

.edit-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  color: white;
  line-height: 1.6;
  box-sizing: border-box;
}

.edit-actions {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-top: 12rpx;
  justify-content: flex-end;
}

.edit-action-btn {
  padding: 16rpx 40rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.cancel-btn {
  background: rgba(255, 255, 255, 0.9);
  color: #6D6A65;
  border: 1rpx solid rgba(212, 184, 165, 0.3);
}

.confirm-btn {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.3);
}

.edit-action-btn:active {
  transform: scale(0.96);
}
