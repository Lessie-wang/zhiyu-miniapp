    box-shadow:
      0 2rpx 8rpx rgba(212, 184, 165, 0.45),
      0 0 12rpx rgba(212, 184, 165, 0.3),
      inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
  }
  50% {
    box-shadow:
      0 3rpx 10rpx rgba(212, 184, 165, 0.55),
      0 0 16rpx rgba(212, 184, 165, 0.4),
