/* 激活状态 */
.nav-item.active .icon-wujing .moon {
  box-shadow: 10rpx -2rpx 0 0 #D4B8A5;
  filter: drop-shadow(0 3rpx 10rpx rgba(212, 184, 165, 0.35));
  animation: moonGlow 4s ease-in-out infinite;
}

@keyframes moonGlow {
  0%, 100% {
    box-shadow: 10rpx -2rpx 0 0 #D4B8A5;
    filter: drop-shadow(0 3rpx 10rpx rgba(212, 184, 165, 0.35));
  }
  50% {
    box-shadow: 10rpx -2rpx 0 0 #E8C4A8;
