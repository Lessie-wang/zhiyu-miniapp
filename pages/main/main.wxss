  }
  50% {
    transform: translateY(-2rpx);
  }
}

.nav-item.active .icon-jianyu .envelope::before {
  background: linear-gradient(90deg,
    transparent,
    rgba(212, 184, 165, 0.3),
    transparent);
}

.nav-item.active .icon-jianyu .envelope::after {
  background: linear-gradient(90deg,
    transparent,
    rgba(212, 184, 165, 0.25),
    transparent);
}

.nav-item.active .icon-jianyu .flap {
  border-color: #D4B8A5;
  border-width: 2.5rpx;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(255, 250, 247, 0.92) 100%);
  box-shadow:
    -2rpx 2rpx 6rpx rgba(212, 184, 165, 0.2),
