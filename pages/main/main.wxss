/* ==================== 知愈小程序 v3.0 - 高级精致版 ==================== */

/* 引入设计系统 */
@import '/styles/design-tokens.wxss';
@import '/styles/animations.wxss';
@import '/styles/safe-area.wxss';

/* ==================== 一、全局变量系统 ==================== */
page {
  /* 主色调 */
  --color-primary: #D4B8A5;
  --color-primary-dark: #C4A893;
  --color-accent: #E8C4A8;

  /* 文字颜色 */
  --color-text-primary: #6D6A65;
  --color-text-secondary: #8C8780;
  --color-text-tertiary: #B8B2A7;

  /* 背景颜色 */
  --color-bg-primary: #FAF9F7;
  --color-bg-secondary: #F5F0EB;
  --color-bg-tertiary: #F2E6DF;

  /* 间距系统 */
  --spacing-xs: 8rpx;
  --spacing-sm: 12rpx;
  --spacing-md: 16rpx;
  --spacing-lg: 24rpx;
  --spacing-xl: 32rpx;
  --spacing-2xl: 40rpx;
  --spacing-3xl: 48rpx;
  --spacing-4xl: 64rpx;

  /* 圆角系统 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-2xl: 64rpx;
  --radius-full: 50%;

  /* 阴影系统 */
  --shadow-sm: 0 2rpx 8rpx rgba(212, 184, 165, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(212, 184, 165, 0.12);
  --shadow-lg: 0 8rpx 32rpx rgba(212, 184, 165, 0.16);
  --shadow-xl: 0 16rpx 48rpx rgba(212, 184, 165, 0.2);

  /* 过渡时间 */
  --transition-fast: 0.2s;
  --transition-base: 0.3s;
  --transition-slow: 0.5s;

  /* 缓动函数 */
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==================== 二、核心动画系统 ==================== */

/* 呼吸动画 */
@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.85;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

/* 流动渐变 */
@keyframes gradientFlow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* 浮动效果 */
@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-16rpx);
  }
}

/* 波纹扩散 */
@keyframes ripple {
  0% {
    transform: scale(0);
    opacity: 0.8;
  }
  100% {
    transform: scale(4);
    opacity: 0;
  }
}

/* 光晕脉冲 */
@keyframes glowPulse {
  0%, 100% {
    box-shadow: 0 0 24rpx rgba(212, 184, 165, 0.3);
  }
  50% {
    box-shadow: 0 0 48rpx rgba(212, 184, 165, 0.6);
  }
}

/* 闪光扫过 */
@keyframes shimmer {
  0% {
    background-position: -200% 0;
  }
  100% {
    background-position: 200% 0;
  }
}

/* 粒子漂浮 */
@keyframes particleFloat {
  0% {
    transform: translate(0, 0) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 0.6;
  }
  90% {
    opacity: 0.6;
  }
  100% {
    transform: translate(120rpx, -240rpx) rotate(360deg);
    opacity: 0;
  }
}

/* 光晕漂浮 */
@keyframes orbFloat {
  0%, 100% {
    transform: translate(0, 0) scale(1);
  }
  33% {
    transform: translate(60rpx, -100rpx) scale(1.15);
  }
  66% {
    transform: translate(-60rpx, 100rpx) scale(0.85);
  }
}

/* 淡入上升 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 旋转 */
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ==================== 三、主容器 ==================== */
.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 30% 20%, rgba(245, 198, 203, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at top left, var(--color-bg-primary) 0%, var(--color-bg-secondary) 40%, var(--color-bg-tertiary) 100%);
  padding: calc(env(safe-area-inset-top) + 60rpx) var(--spacing-lg) 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ==================== 四、背景装饰层 ==================== */

/* 背景图片层 */
.bg-image-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.5;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(40rpx);
}

/* 背景脉动 */
@keyframes bgPulse {
  0%, 100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.6;
  }
}

/* 背景缩放 */
@keyframes bgZoom {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

/* 粒子容器 */
.particle-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  background: radial-gradient(circle, rgba(212, 184, 165, 0.8), transparent);
  border-radius: var(--radius-full);
  animation: particleFloat 12s ease-in-out infinite, particleTwinkle 3s ease-in-out infinite;
}

/* 粒子闪烁 */
@keyframes particleTwinkle {
  0%, 100% {
    opacity: 0.4;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.2);
  }
}

/* 光晕层 */
.glow-orb {
  position: fixed;
  width: 500rpx;
  height: 500rpx;
  border-radius: var(--radius-full);
  filter: blur(120rpx);
  opacity: 0.3;
  pointer-events: none;
  z-index: 1;
  animation: orbPulse 6s ease-in-out infinite;
}

/* 光晕脉动 */
@keyframes orbPulse {
  0%, 100% {
    opacity: 0.25;
    filter: blur(120rpx);
  }
  50% {
    opacity: 0.4;
    filter: blur(100rpx);
  }
}

.glow-orb-1 {
  background: radial-gradient(circle, #F5C6CB, transparent);
  top: 10%;
  left: -15%;
}

.glow-orb-2 {
  background: radial-gradient(circle, #B8D4E8, transparent);
  bottom: 15%;
  right: -15%;
  animation-delay: -8s;
}

.glow-orb-3 {
  background: radial-gradient(circle, #E8D4C4, transparent);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation-delay: -16s;
}

/* 内容层 */
.content-layer {
  position: relative;
  z-index: 10;
}

/* ==================== 五、顶部日期区域 ==================== */
.date-header {
  text-align: center;
  margin-bottom: var(--spacing-2xl);
  padding: var(--spacing-md) 0;
  animation: fadeInUp 0.8s var(--ease-smooth);
}

/* 时间显示增加脉动 */
.time-text {
  display: block;
  font-size: 96rpx;
  font-weight: 100;
  color: var(--color-text-primary);
  letter-spacing: 8rpx;
  line-height: 1;
  margin-top: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  font-family: "SF Pro Display", "Helvetica Neue", -apple-system, sans-serif;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.1);
  animation: textGlow 4s ease-in-out infinite;
}

/* 文字光晕 */
@keyframes textGlow {
  0%, 100% {
    text-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.1);
  }
  50% {
    text-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.25);
  }
}

.date-text {
  font-size: 30rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  letter-spacing: 2rpx;
  font-family: "PingFang SC", sans-serif;
}

/* 节日祝福 */
.festival-text {
  display: block;
  font-size: 28rpx;
  color: var(--color-primary);
  text-align: center;
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md) var(--spacing-xl);
  background: linear-gradient(135deg,
    rgba(212, 184, 165, 0.15) 0%,
    rgba(232, 212, 196, 0.1) 50%,
    rgba(212, 184, 165, 0.15) 100%
  );
  background-size: 200% 200%;
  animation: gradientFlow 4s ease infinite;
  border-radius: var(--radius-lg);
  max-width: 600rpx;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.8;
  letter-spacing: 1rpx;
  border: 2rpx solid rgba(212, 184, 165, 0.2);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(10rpx);
}

/* ==================== 六、情绪轮盘区域 ==================== */
.emotion-wheel-section {
  margin-bottom: var(--spacing-3xl);
  margin-top: var(--spacing-2xl);
  animation: fadeInUp 1s var(--ease-smooth) 0.2s both;
}

.section-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-lg);
  text-align: center;
  letter-spacing: 2rpx;
  font-family: "Source Han Serif CN", "PingFang SC", serif;
}

.section-hint {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  text-align: center;
  margin-bottom: var(--spacing-xl);
  letter-spacing: 1rpx;
  line-height: 1.8;
}

/* 情绪网格 */
.emotion-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: var(--spacing-4xl);
  padding: 0 var(--spacing-xs);
}

/* ==================== 七、情绪卡片 v3.0 - 高级质感升级 ==================== */
.emotion-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 12rpx;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 253, 248, 0.65) 100%
  );
  backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.15),
    0 2rpx 8rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: all var(--transition-slow) var(--ease-bounce);
  position: relative;
  min-height: 110rpx;
  overflow: hidden;
  transform-style: preserve-3d;
  will-change: transform;
}

.emotion-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.5) 0%,
    transparent 50%,
    rgba(255, 255, 255, 0.3) 100%
  );
  opacity: 0;
  transition: opacity var(--transition-base);
  pointer-events: none;
}

.emotion-card:active::before {
  opacity: 1;
}

.emotion-card:active {
  transform: scale(0.92);
  box-shadow:
    0 2rpx 12rpx rgba(212, 184, 165, 0.15),
    0 1rpx 4rpx rgba(212, 184, 165, 0.1);
}

/* 选中状态 */
.emotion-card.selected {
  background: linear-gradient(135deg,
    var(--emotion-color) 0%,
    var(--emotion-color-light) 50%,
    var(--emotion-color) 100%
  );
  background-size: 200% 200%;
  animation: gradientFlow 3s ease infinite, glowPulse 2.5s ease-in-out infinite;
  transform: translateY(-12rpx) scale(1.06);
  border-color: var(--emotion-color);
  box-shadow:
    0 16rpx 48rpx rgba(212, 184, 165, 0.25),
    0 4rpx 16rpx rgba(212, 184, 165, 0.15),
    0 0 0 4rpx rgba(255, 255, 255, 0.5);
}

/* 情绪图标 */
.emotion-icon {
  width: 52rpx;
  height: 52rpx;
  margin-bottom: 8rpx;
  object-fit: contain;
  filter: drop-shadow(0 4rpx 16rpx rgba(212, 184, 165, 0.25));
  animation: breathe 4.5s ease-in-out infinite;
  transition: all var(--transition-base) var(--ease-smooth);
  will-change: transform, filter;
}

.emotion-card:active .emotion-icon {
  transform: scale(0.85);
  filter: drop-shadow(0 2rpx 8rpx rgba(212, 184, 165, 0.3));
}

.emotion-card.selected .emotion-icon {
  filter: drop-shadow(0 8rpx 24rpx rgba(255, 255, 255, 0.95));
  animation: breathe 4.5s ease-in-out infinite;
  transform: scale(1.1);
}

/* 情绪名称 */
.emotion-name {
  font-size: 24rpx;
  color: var(--color-text-primary);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
  transition: all var(--transition-base) var(--ease-smooth);
  font-family: "PingFang SC", sans-serif;
}

.emotion-card.selected .emotion-name {
  color: white;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transform: scale(1.05);
}

/* 选中标记 */
.check-mark {
  position: absolute;
  top: var(--spacing-sm);
  right: var(--spacing-sm);
  width: 32rpx;
  height: 32rpx;
  background: white;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.3);
  opacity: 0;
  transform: scale(0);
  transition: all var(--transition-base) var(--ease-bounce);
}

.emotion-card.selected .check-mark {
  opacity: 1;
  transform: scale(1);
}

/* 自定义情绪卡片 */
.custom-emotion-card {
  grid-column: 2 / 4;
  border: 3rpx dashed rgba(212, 184, 165, 0.5) !important;
  background: rgba(255, 255, 255, 0.6) !important;
  backdrop-filter: blur(20rpx);
}

.custom-emotion-card:active {
  background: rgba(242, 230, 223, 0.8) !important;
}

/* ==================== 八、身体感受区域 ==================== */
.body-feeling-section {
  margin-bottom: var(--spacing-3xl);
  animation: fadeInUp 1.2s var(--ease-smooth) 0.4s both;
}

.feeling-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-xl);
  justify-content: center;
}

.feeling-tag {
  padding: 20rpx 36rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-radius: 50rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base) var(--ease-bounce);
  border: 2rpx solid rgba(212, 184, 165, 0.2);
  letter-spacing: 1rpx;
  font-weight: 500;
}

.feeling-tag:active {
  transform: scale(0.92);
  box-shadow: 0 1rpx 6rpx rgba(212, 184, 165, 0.15);
}

.feeling-tag.selected {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: white;
  font-weight: 600;
  box-shadow:
    0 8rpx 24rpx rgba(212, 184, 165, 0.35),
    0 2rpx 8rpx rgba(212, 184, 165, 0.2);
  transform: scale(1.05);
  border-color: var(--color-primary);
}

/* ==================== 九、快速记录区域 ==================== */
.quick-note-section {
  margin-top: var(--spacing-3xl);
  margin-bottom: var(--spacing-xl);
  padding: 0 var(--spacing-xs);
  animation: fadeInUp 1.4s var(--ease-smooth) 0.6s both;
}

.letter-paper {
  background: linear-gradient(135deg, #FFFDF8 0%, #FFF9F3 100%);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) var(--spacing-lg);
  box-shadow:
    var(--shadow-md),
    0 2rpx 8rpx rgba(212, 184, 165, 0.08);
  border: 2rpx solid rgba(212, 184, 165, 0.2);
  position: relative;
  overflow: hidden;
}

.letter-paper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 16rpx;
  background: linear-gradient(90deg,
    var(--color-primary) 0%,
    var(--color-accent) 25%,
    var(--color-primary) 50%,
    var(--color-accent) 75%,
    var(--color-primary) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 4s linear infinite;
  opacity: 0.7;
}

.letter-lines {
  background-image: repeating-linear-gradient(
    transparent,
    transparent 56rpx,
    rgba(212, 184, 165, 0.15) 56rpx,
    rgba(212, 184, 165, 0.15) 58rpx
  );
  min-height: 180rpx;
}

.quick-note-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: 58rpx;
  min-height: 180rpx;
  background: transparent;
  font-family: "PingFang SC", sans-serif;
  letter-spacing: 0.5rpx;
}

/* ==================== 十、操作按钮 ==================== */
.action-row {
  display: flex;
  justify-content: space-between;
  gap: var(--spacing-lg);
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-xs);
  animation: fadeInUp 1.6s var(--ease-smooth) 0.8s both;
}

/* 主按钮 */
.action-left-btn {
  flex: 1;
  height: 96rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: 50rpx;
  font-size: 32rpx;
  color: white;
  font-weight: 600;
  letter-spacing: 3rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 28rpx rgba(212, 184, 165, 0.3),
    0 2rpx 8rpx rgba(212, 184, 165, 0.15);
  transition: all var(--transition-base) var(--ease-bounce);
  position: relative;
  overflow: hidden;
}

.action-left-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg,
    transparent,
    rgba(255, 255, 255, 0.4),
    transparent
  );
  transition: left var(--transition-slow);
}

.action-left-btn:active::before {
  left: 100%;
}

.action-left-btn::after {
  border: none;
}

.action-left-btn:active {
  transform: scale(0.96);
  box-shadow:
    0 4rpx 20rpx rgba(212, 184, 165, 0.4),
    0 1rpx 4rpx rgba(212, 184, 165, 0.2);
}

/* 次按钮 */
.action-right-btn {
  flex: 1;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-radius: 50rpx;
  font-size: 32rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
  letter-spacing: 3rpx;
  border: 3rpx solid rgba(212, 184, 165, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base) var(--ease-bounce);
}

.action-right-btn::after {
  border: none;
}

.action-right-btn:active {
  transform: scale(0.96);
  background: rgba(242, 230, 223, 0.98);
  border-color: rgba(212, 184, 165, 0.6);
}

/* ==================== 十一、底部导航 ==================== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(30rpx) saturate(180%);
  border-top: 1rpx solid rgba(242, 230, 223, 0.8);
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding: var(--spacing-md) 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 24rpx rgba(212, 184, 165, 0.12);
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
  flex: 1;
  transition: all var(--transition-base) var(--ease-smooth);
}

.nav-item.active {
  transform: scale(1.1);
}

.nav-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-base) var(--ease-smooth);
  opacity: 0.6;
}

.nav-item.active .nav-icon-wrap {
  opacity: 1;
  animation: breathe 3s ease-in-out infinite;
}

.nav-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  transition: all var(--transition-base) var(--ease-smooth);
  letter-spacing: 1rpx;
}

.nav-item.active .nav-label {
  color: var(--color-primary);
  font-weight: 600;
}

/* ==================== 底部导航CSS图标 v3.0 - 极致精修 ==================== */

/* 印记 —— 精致水滴涟漪 + 光晕 */
.icon-yinji {
  width: 46rpx;
  height: 46rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: drop-shadow(0 2rpx 6rpx rgba(184, 178, 167, 0.18));
}

.icon-yinji .ripple {
