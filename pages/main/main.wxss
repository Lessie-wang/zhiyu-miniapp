  height: 15rpx;
  border: 2.5rpx solid #B8B2A7;
  border-bottom: none;
  border-radius: 13rpx 13rpx 0 0;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(180deg,
