}

.nav-item.active .icon-jianyu .seal {
  background: radial-gradient(circle,
    #D4B8A5 0%,
    #C4A893 100%);
  opacity: 0.95;
  box-shadow:
    0 2rpx 8rpx rgba(212, 184, 165, 0.45),
    0 0 12rpx rgba(212, 184, 165, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
