}

/* 知愈Logo水印 - 融入背景 */
.container::before {
  content: '知愈';
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 280rpx;
  font-weight: 700;
  font-family: "Source Han Serif CN", "STKaiti", serif;
  color: rgba(212, 184, 165, 0.06);
  pointer-events: none;
  z-index: 1;
  letter-spacing: 20rpx;
}

@keyframes logoBreath {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.7;
    transform: translate(-50%, -50%) scale(1.05);
  }
}

/* 信纸区域高级质感升级 */
.letter-paper {
  position: relative;
  background: linear-gradient(135deg,
    rgba(255, 250, 245, 0.95) 0%,
    rgba(255, 248, 240, 0.9) 100%
  );
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.15),
    0 2rpx 8rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(212, 184, 165, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  overflow: hidden;
}

/* 信纸纹理 */
.letter-paper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 48rpx,
      rgba(212, 184, 165, 0.08) 48rpx,
      rgba(212, 184, 165, 0.08) 50rpx
    );
  pointer-events: none;
  z-index: 0;
}

/* 信纸光影效果 */
.letter-paper::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(
    circle at center,
    rgba(255, 255, 255, 0.4) 0%,
    transparent 50%
  );
  pointer-events: none;
  z-index: 1;
  animation: paperShine 6s ease-in-out infinite;
}

@keyframes paperShine {
  0%, 100% {
    transform: translate(0, 0);
    opacity: 0.3;
  }
  50% {
    transform: translate(10%, 10%);
    opacity: 0.5;
  }
}

.letter-lines {
  position: relative;
  z-index: 2;
}

/* 快速记录输入框优化 */
.quick-note-input {
  width: 100%;
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 50rpx;
  background: transparent;
  border: none;
  outline: none;
  font-family: "Source Han Serif CN", "PingFang SC", serif;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 3;
}

.quick-note-input::placeholder {
  color: rgba(184, 178, 167, 0.6);
  font-style: italic;
}

/* 邮筒动画优化 - 增加质感 */
.mailbox-body {
  background: linear-gradient(135deg,
    #D4B8A5 0%,
    #C4A893 50%,
    #B89D8A 100%
  );
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.3),
    inset 0 -2rpx 0 rgba(0, 0, 0, 0.2);
}

.mailbox-front {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.15) 0%,
    rgba(255, 255, 255, 0.05) 100%
  );
}

.mailbox-logo {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(255, 253, 248, 0.85) 100%
  );
  border-radius: 16rpx;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 1);
}

.mailbox-logo-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #D4B8A5;
  font-family: "Source Han Serif CN", serif;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 4rpx rgba(212, 184, 165, 0.2);
}

/* 飞行信纸优化 */
.flying-letter {
  filter: drop-shadow(0 8rpx 24rpx rgba(212, 184, 165, 0.4));
}

.letter-fold {
  background: linear-gradient(135deg,
    #FFF8F0 0%,
    #FFF0E0 100%
  );
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(212, 184, 165, 0.3);
}

.letter-emotion-stamp {
  background: linear-gradient(135deg,
    rgba(245, 198, 203, 0.3) 0%,
    rgba(212, 184, 165, 0.25) 100%
  );
  border: 1rpx dashed rgba(212, 184, 165, 0.4);
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.15);
}

/* ==================== 情绪强度滑块弹窗 ==================== */

/* 弹窗容器 */
.intensity-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 遮罩层 */
.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  animation: fadeIn 0.3s ease;
}

/* 弹窗内容 */
.modal-content {
  position: relative;
  width: 640rpx;
  max-height: 80vh;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(250, 249, 247, 0.98) 100%);
  border-radius: var(--radius-2xl, 32rpx);
  padding: var(--spacing-2xl, 48rpx) var(--spacing-xl, 40rpx);
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.15),
    0 8rpx 24rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

/* 弹窗头部 */
.modal-header {
  text-align: center;
  margin-bottom: var(--spacing-2xl, 48rpx);
  padding-bottom: var(--spacing-lg, 32rpx);
  border-bottom: 2rpx solid rgba(212, 184, 165, 0.15);
}

.modal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: var(--spacing-xs, 12rpx);
  letter-spacing: 0.5rpx;
}

.modal-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary, #9B9892);
  line-height: 1.5;
}

/* 当前强度显示 */
.current-intensity {
  text-align: center;
  margin-bottom: var(--spacing-md, 16rpx);
  padding: var(--spacing-xl, 32rpx) var(--spacing-lg, 24rpx);
  background: linear-gradient(135deg,
    rgba(212, 184, 165, 0.08) 0%,
    rgba(232, 196, 168, 0.08) 100%);
  border-radius: var(--radius-lg, 24rpx);
  border: 2rpx solid rgba(212, 184, 165, 0.15);
}

.current-label {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 2rpx;
  color: var(--color-text-primary, #6D6A65);
}

.current-level {
  text-align: center;
  margin-bottom: var(--spacing-lg, 24rpx);
  padding: var(--spacing-sm, 12rpx) 0;
}

.level-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary, #B8B2A7);
  letter-spacing: 1rpx;
}

.intensity-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary, #9B9892);
  margin-bottom: var(--spacing-xs, 12rpx);
}

.intensity-value {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

/* 滑块容器 */
.slider-container {
  margin-bottom: var(--spacing-2xl, 48rpx);
  padding: 0 var(--spacing-md, 24rpx);
}

/* 微信原生滑块样式 - 加宽滑动条 */
.intensity-slider {
  width: 100%;
  margin: var(--spacing-xl, 40rpx) 0;
  /* 滑动条高度通过 block-size 控制 */
}

/* 滑动条轨道背景 */
.intensity-slider::before {
  height: 12rpx;
  border-radius: 6rpx;
}

/* 刻度标签容器 */
.slider-labels {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: var(--spacing-lg, 32rpx);
  padding: 0 var(--spacing-xs, 12rpx);
}

.slider-label {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary, #B8B5B0);
  line-height: 1.4;
  padding: 0 4rpx;
  transition: all 0.3s ease;
}

.slider-label.active {
  color: var(--color-primary, #D4B8A5);
  font-weight: 600;
  transform: scale(1.1);
}

/* 按钮组 */
.modal-buttons {
  display: flex;
  gap: var(--spacing-md, 24rpx);
  margin-top: var(--spacing-xl, 40rpx);
}

.modal-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-lg, 24rpx);
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
  outline: none;
}

.modal-button-cancel {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 243, 238, 0.9) 100%);
  color: var(--color-text-secondary, #9B9892);
  border: 2rpx solid rgba(212, 184, 165, 0.3);
}

.modal-button-cancel:active {
  transform: scale(0.96);
  background: rgba(248, 243, 238, 0.95);
}

.modal-button-confirm {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: #FFFFFF;
  box-shadow:
    0 8rpx 24rpx rgba(212, 184, 165, 0.35),
    0 2rpx 8rpx rgba(212, 184, 165, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.modal-button-confirm:active {
  transform: scale(0.96);
  box-shadow:
    0 4rpx 12rpx rgba(212, 184, 165, 0.3),
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100rpx) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ==================== 知识库悬浮按钮 ==================== */

.knowledge-fab {
  position: fixed;
  right: var(--spacing-lg, 32rpx);
  bottom: calc(var(--safe-area-bottom, 0rpx) + 160rpx);
  z-index: 999;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 249, 247, 0.95) 100%);
  border-radius: 50%;
  box-shadow:
    0 12rpx 32rpx rgba(212, 184, 165, 0.25),
    0 4rpx 12rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.knowledge-fab:active {
  transform: scale(0.92);
  box-shadow:
    0 8rpx 20rpx rgba(212, 184, 165, 0.2),
    0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.fab-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.fab-book-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fbook-spine {
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  width: 6rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 2rpx 0 0 2rpx;
  box-shadow: -2rpx 0 4rpx rgba(0, 0, 0, 0.1);
}

.fbook-cover {
  position: absolute;
  left: 14rpx;
  top: 4rpx;
  width: 28rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #E8DDD3 0%, #D4B8A5 100%);
  border-radius: 0 4rpx 4rpx 0;
  box-shadow:
    2rpx 2rpx 8rpx rgba(0, 0, 0, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.fbook-line {
  position: absolute;
  right: 6rpx;
  width: 16rpx;
  height: 2rpx;
  background: rgba(196, 168, 147, 0.4);
  border-radius: 1rpx;
}

.fbook-line.fl1 {
  top: 16rpx;
}

.fbook-line.fl2 {
  top: 24rpx;
}

.fab-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text-secondary, #9B9892);
  letter-spacing: 0.5rpx;
}

/* ==================== 邮筒投递动画 ==================== */

/* 动画容器 */
.mailbox-animation {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 遮罩层 */
.animation-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(12rpx);
  animation: fadeIn 0.4s ease;
}

/* 邮筒主体容器 */
.mailbox {
  position: absolute;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%) translateY(150%);
  width: 240rpx;
  height: 360rpx;
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 2;
}

.mailbox.delivering {
  transform: translateX(-50%) translateY(0);
}

.mailbox.delivered {
  transform: translateX(-50%) translateY(10rpx);
}

/* 邮筒顶部（圆顶） */
.mailbox-top {
  position: relative;
  width: 240rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #E8C9A8 0%, #D4B8A5 50%, #C4A893 100%);
  border-radius: 120rpx 120rpx 0 0;
  box-shadow:
    0 -6rpx 24rpx rgba(212, 184, 165, 0.4),
    inset 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
  overflow: visible;
}

/* 邮筒旗帜 */
.mailbox-flag {
  position: absolute;
  top: 20rpx;
  right: -30rpx;
  width: 70rpx;
  height: 50rpx;
  background: linear-gradient(135deg, #E74C3C 0%, #C0392B 100%);
  border-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(231, 76, 60, 0.4);
  transform-origin: left center;
  transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mailbox-flag::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 8rpx;
  background: #FFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.mailbox-flag.raised {
  transform: rotate(-60deg);
}

/* 投递口 */
.mailbox-slot {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 6rpx;
  box-shadow:
    inset 0 2rpx 8rpx rgba(0, 0, 0, 0.6),
    0 1rpx 0 rgba(255, 255, 255, 0.1);
}

/* 邮筒主体 */
.mailbox-body {
  position: relative;
  width: 240rpx;
  height: 220rpx;
  background: linear-gradient(180deg, #D4B8A5 0%, #C4A893 50%, #B89885 100%);
  border-radius: 0 0 24rpx 24rpx;
  box-shadow:
    0 12rpx 40rpx rgba(0, 0, 0, 0.3),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

/* 邮筒正面装饰 */
.mailbox-front {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 180rpx;
  height: 140rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, transparent 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
}

/* 邮筒Logo */
.mailbox-logo {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.mailbox-logo-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #D4B8A5;
  letter-spacing: 2rpx;
}

/* 邮筒底座 */
.mailbox-base {
  width: 260rpx;
  height: 40rpx;
  background: linear-gradient(180deg, #A89080 0%, #8C7A6A 100%);
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
  margin-left: -10rpx;
}

/* 飞行的信纸 */
.flying-letter {
  position: absolute;
  top: -150rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-5deg);
  width: 160rpx;
  height: 120rpx;
  opacity: 0;
  transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 3;
}

/* 信封盖子三角形 - 在信封上方 */
.flying-letter::before {
  content: '';
  position: absolute;
  top: -58rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 80rpx solid transparent;
  border-right: 80rpx solid transparent;
  border-bottom: 60rpx solid #FFF9F0;
  z-index: -1;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.flying-letter.flying {
  opacity: 1;
  top: 180rpx;
  transform: translateX(-50%) rotate(0deg);
}

.flying-letter.dropped {
  top: 220rpx;
  opacity: 0;
  transform: translateX(-50%) scale(0.6) rotate(5deg);
}

/* 信纸折叠效果 */
.letter-fold {
  position: relative;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF5E8 100%);
  border: 3rpx solid #E8DCC8;
  border-radius: 12rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  overflow: hidden;
}

.letter-fold::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 40rpx 40rpx 0;
  border-color: transparent #E8DCC8 transparent transparent;
}

.letter-fold::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 38rpx 38rpx 0;
  border-color: transparent #F5EDE7 transparent transparent;
}

/* 信纸内容 */
.letter-content {
  position: relative;
  z-index: 1;
  padding: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
}

/* 情绪邮票 */
.letter-emotion-stamp {
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #FFE5D9 0%, #FFD4C4 100%);
  border: 2rpx dashed #D4B8A5;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #8C7A6A;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.2);
}

.stamp-text {
  letter-spacing: 1rpx;
}

/* 投递成功提示 */
.delivery-success {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  opacity: 0;
  transition: opacity 0.5s ease;
  z-index: 4;
}

.delivery-success.show {
  opacity: 1;
  animation: successPulse 0.6s ease;
}

/* 成功图标 */
.success-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #52C41A 0%, #389E0D 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(82, 196, 26, 0.4),
    0 0 0 8rpx rgba(82, 196, 26, 0.1);
  animation: iconBounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 对勾 */
.success-checkmark {
  width: 50rpx;
  height: 30rpx;
  border-bottom: 6rpx solid #FFF;
  border-left: 6rpx solid #FFF;
  transform: rotate(-45deg) translateY(-8rpx);
  border-radius: 2rpx;
}

/* 成功文字 */
.success-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.success-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* 动画定义 */
@keyframes successPulse {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.8);
  }
  50% {
    transform: translate(-50%, -50%) scale(1.05);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

@keyframes iconBounce {
  0% {
    transform: scale(0);
  }
  50% {
    transform: scale(1.15);
  }
  100% {
    transform: scale(1);
  }
}

/* ==================== 自定义情绪弹窗 ==================== */

.custom-emotion-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-emotion-content {
  width: 640rpx;
}

/* 信纸风格输入区域 */
.custom-emotion-paper {
  position: relative;
  background: linear-gradient(to bottom,
    #FFFEF9 0%,
    #FFFCF5 100%);
  border-radius: var(--radius-lg, 24rpx);
  padding: var(--spacing-xl, 40rpx) var(--spacing-lg, 32rpx);
  margin-bottom: var(--spacing-lg, 32rpx);
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(212, 184, 165, 0.2);
}

/* 信纸横线背景 */
.paper-lines {
  position: relative;
  background-image: repeating-linear-gradient(
    transparent,
    transparent 79rpx,
    rgba(212, 184, 165, 0.15) 79rpx,
    rgba(212, 184, 165, 0.15) 80rpx
  );
  background-size: 100% 80rpx;
  min-height: 200rpx;
}

/* 多行文本输入框 */
.custom-emotion-textarea {
  width: 100%;
  font-size: 30rpx;
  line-height: 80rpx;
  color: var(--color-text-primary, #6D6A65);
  background: transparent;
  border: none;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* 字数统计 */
.char-count {
  position: absolute;
  bottom: var(--spacing-md, 16rpx);
  right: var(--spacing-lg, 32rpx);
  font-size: 24rpx;
  color: var(--color-text-tertiary, #B8B2A7);
  font-weight: 500;
}
