/* ==================== 十二、其他输入和弹窗 ==================== */
.other-inline-input {
  flex: 1;
  height: 60rpx;
  padding: 0 var(--spacing-lg);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 50rpx;
  border: 2rpx solid rgba(212, 184, 165, 0.4);
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
  animation: fadeInUp var(--transition-base) var(--ease-smooth);
  box-shadow: var(--shadow-sm);
}

.other-inline-input::placeholder {
  color: var(--color-text-tertiary);
}

/* ==================== 十三、性能优化 ==================== */
.animated-element {
  will-change: transform, opacity;
  transform: translateZ(0);
}

.gpu-accelerated {
  transform: translate3d(0, 0, 0);
}

/* ==================== 十四、组件自定义样式 ==================== */

/* 情绪卡片自定义 */
.emotion-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(255, 255, 255, 0.85) 100%);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(212, 184, 165, 0.2);
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.12),
    0 2rpx 8rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

/* 功能卡片自定义 */
.feature-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 243, 238, 0.9) 100%);
  backdrop-filter: blur(15rpx);
  border: 2rpx solid rgba(212, 184, 165, 0.15);
}

/* 按钮自定义 */
.record-button {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  box-shadow:
    0 8rpx 24rpx rgba(212, 184, 165, 0.3),
    0 2rpx 8rpx rgba(212, 184, 165, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.record-button:active {
  transform: scale(0.95);
  box-shadow:
    0 4rpx 12rpx rgba(212, 184, 165, 0.25),
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 情绪标签自定义 */
.emotion-tag-custom {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.8) 0%,
    rgba(248, 243, 238, 0.8) 100%);
  border: 2rpx solid rgba(212, 184, 165, 0.3);
  backdrop-filter: blur(10rpx);
}

.emotion-tag-custom.selected {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-color: #C4A893;
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

/* ==================== 十五、高级质感升级 - 卡片透明度优化 ==================== */

/* 日期卡片 */
.date-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.65) 0%,
    rgba(255, 253, 248, 0.55) 100%
  ) !important;
  backdrop-filter: blur(40rpx) saturate(200%) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.5) !important;
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.12),
    0 2rpx 8rpx rgba(212, 184, 165, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7) !important;
}

/* 情绪轮盘卡片 */
.emotion-wheel-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.7) 0%,
    rgba(255, 253, 248, 0.6) 100%
  ) !important;
  backdrop-filter: blur(40rpx) saturate(200%) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.55) !important;
  box-shadow:
    0 12rpx 48rpx rgba(212, 184, 165, 0.15),
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.75) !important;
}

/* 身体感受卡片 */
.body-feeling-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 253, 248, 0.58) 100%
  ) !important;
  backdrop-filter: blur(40rpx) saturate(200%) !important;
  border: 2rpx solid rgba(255, 255, 255, 0.52) !important;
  box-shadow:
    0 12rpx 48rpx rgba(212, 184, 165, 0.15),
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
