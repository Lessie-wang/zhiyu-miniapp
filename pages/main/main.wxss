    #D4B8A5 0%,
    #C4A893 100%);
  box-shadow: 0 0 10rpx rgba(212, 184, 165, 0.5);
}

.nav-item.active .icon-wujing .star::before,
.nav-item.active .icon-wujing .star::after {
  background: linear-gradient(90deg,
    transparent,
    rgba(255, 255, 255, 0.8),
    transparent);
  opacity: 1;
}

.nav-item.active .icon-wujing .s1 {
  opacity: 1;
  animation: starTwinkleActive 2.5s ease-in-out infinite;
}

.nav-item.active .icon-wujing .s2 {
  opacity: 0.9;
  animation: starTwinkleActive 2.5s ease-in-out infinite 0.8s;
}

.nav-item.active .icon-wujing .s3 {
  opacity: 0.95;
  animation: starTwinkleActive 2.5s ease-in-out infinite 1.6s;
}

@keyframes starTwinkleActive {
