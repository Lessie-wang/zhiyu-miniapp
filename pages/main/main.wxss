/* 心之笺语 —— 精致信封 + 心形封蜡 + 飘动效果 */
.icon-jianyu {
  width: 44rpx;
  height: 36rpx;
  position: relative;
  filter: drop-shadow(0 2rpx 6rpx rgba(184, 178, 167, 0.18));
}

.icon-jianyu .envelope {
  width: 100%;
  height: 100%;
  border: 2.5rpx solid #B8B2A7;
  border-radius: 5rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.15) 0%,
    rgba(250, 249, 247, 0.08) 100%);
  box-shadow: inset 0 1rpx 2rpx rgba(255, 255, 255, 0.2);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

/* 信封纹理线条 */
.icon-jianyu .envelope::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 6rpx;
  right: 6rpx;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(184, 178, 167, 0.2),
    transparent);
}

.icon-jianyu .envelope::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 6rpx;
  right: 6rpx;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(184, 178, 167, 0.15),
    transparent);
}

.icon-jianyu .flap {
  position: absolute;
  top: -1rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 26rpx;
  height: 26rpx;
  border-top: 2.5rpx solid #B8B2A7;
  border-right: 2.5rpx solid #B8B2A7;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(250, 249, 247, 0.85) 100%);
  border-radius: 0 5rpx 0 0;
  box-shadow:
    -2rpx 2rpx 4rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.icon-jianyu .seal {
  position: absolute;
  bottom: 7rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 11rpx;
  height: 11rpx;
  background: radial-gradient(circle,
    #B8B2A7 0%,
    #A89D92 100%);
  opacity: 0.65;
  border-radius: 50%;
  box-shadow:
    0 1rpx 4rpx rgba(184, 178, 167, 0.35),
    inset 0 1rpx 1rpx rgba(255, 255, 255, 0.2);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 封蜡纹理 */
.icon-jianyu .seal::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 6rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

/* 激活状态 */
.nav-item.active .icon-jianyu .envelope {
  border-color: #D4B8A5;
  border-width: 2.5rpx;
  background: linear-gradient(135deg,
    rgba(212, 184, 165, 0.12) 0%,
    rgba(212, 184, 165, 0.05) 100%);
  box-shadow:
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.3),
    0 2rpx 8rpx rgba(212, 184, 165, 0.2);
