}

/* 吾境 —— 精致月牙 + 星辰 + 流星 */
.icon-wujing {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  filter: drop-shadow(0 2rpx 6rpx rgba(184, 178, 167, 0.18));
}

.icon-wujing .moon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  box-shadow: 10rpx -2rpx 0 0 #B8B2A7;
  position: absolute;
  top: 7rpx;
  left: 0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 月牙光晕 */
.icon-wujing .moon::before {
  content: '';
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  box-shadow: 12rpx -2rpx 0 -2rpx rgba(184, 178, 167, 0.15);
  opacity: 0.5;
}

.icon-wujing .star {
  position: absolute;
  background: radial-gradient(circle,
    #B8B2A7 0%,
    #A89D92 100%);
  border-radius: 50%;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  animation: starTwinkle 3s ease-in-out infinite;
  box-shadow: 0 0 4rpx rgba(184, 178, 167, 0.3);
}

/* 星星十字光芒 */
.icon-wujing .star::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 1rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(255, 255, 255, 0.6),
    transparent);
  opacity: 0.8;
}

.icon-wujing .star::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 1rpx;
  height: 100%;
  background: linear-gradient(180deg,
    transparent,
    rgba(255, 255, 255, 0.6),
    transparent);
  opacity: 0.8;
}

.icon-wujing .s1 {
  width: 7rpx;
  height: 7rpx;
  top: 3rpx;
  right: 5rpx;
  opacity: 0.85;
  animation-delay: 0s;
}

.icon-wujing .s2 {
  width: 5rpx;
  height: 5rpx;
  top: 15rpx;
  right: 1rpx;
  opacity: 0.6;
  animation-delay: 0.8s;
}

.icon-wujing .s3 {
  width: 6rpx;
  height: 6rpx;
  top: 27rpx;
  right: 8rpx;
  opacity: 0.7;
  animation-delay: 1.6s;
}

@keyframes starTwinkle {
  0%, 100% {
    transform: scale(1);
    opacity: inherit;
    box-shadow: 0 0 4rpx rgba(184, 178, 167, 0.3);
  }
  50% {
    transform: scale(1.35);
    opacity: 1;
    box-shadow: 0 0 8rpx rgba(184, 178, 167, 0.5);
  }
