  height: 0;
  border-left: 24rpx solid transparent;
  border-right: 24rpx solid transparent;
  border-bottom: 19rpx solid #B8B2A7;
  position: absolute;
  top: 0;
  left: -2rpx;
  opacity: 0.8;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.12));
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 屋顶纹理 */
