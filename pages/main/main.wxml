<view class="container">
  <!-- ==================== 背景装饰层 ==================== -->

  <!-- 背景图片层 -->
  <view class="bg-image-layer">
    <image class="bg-image" src="/images/backgrounds/zhiyu-gradient-mesh.png" mode="aspectFill"></image>
  </view>

  <!-- 粒子容器 -->
  <view class="particle-container">
    <view class="particle" wx:for="{{20}}" wx:key="*this" style="left: {{item * 5}}%; top: {{item * 4}}%; animation-delay: {{item * 0.4}}s;"></view>
  </view>

  <!-- 光晕层 -->
  <view class="glow-orb glow-orb-1"></view>
  <view class="glow-orb glow-orb-2"></view>
  <view class="glow-orb glow-orb-3"></view>

  <!-- ==================== 内容层 ==================== -->
  <view class="content-layer">

    <!-- 游戏式互动引导 -->
    <interactive-guide
      id="interactive-guide"
      visible="{{showGuide}}"
      steps="{{guideSteps}}"
      showSkip="{{true}}"
      bind:complete="onGuideComplete"
    />

    <!-- 顶部日期卡片 -->
    <card type="glass" shadow="{{true}}" custom-class="date-card">
      <view class="date-header">
        <text class="date-text">{{currentDate}}</text>
        <text class="time-text">{{currentTime}}</text>
        <!-- 节日祝福 -->
        <text class="festival-text" wx:if="{{festivalMessage}}">{{festivalMessage}}</text>
      </view>
    </card>

    <!-- 情绪轮盘区域 -->
    <card type="glass" shadow="{{true}}" custom-class="emotion-wheel-card">
      <view class="emotion-wheel-section">
        <text class="section-title">此刻的你，感受到了什么？</text>
        <text class="section-hint">轻触选择，记录当下的情绪</text>

        <view class="emotion-grid">
        <view
          class="emotion-card {{item.selected ? 'selected' : ''}}"
          wx:for="{{emotions}}"
          wx:key="name"
          bindtap="toggleEmotion"
          data-name="{{item.name}}"
          style="--emotion-color: {{item.color}}; --emotion-color-light: {{item.colorLight}};"
        >
          <image class="emotion-icon" src="/images/emotion-icons/{{item.iconType}}.png" mode="aspectFit"></image>
          <text class="emotion-name">{{item.name}}</text>
          <view class="check-mark" wx:if="{{item.selected}}">✓</view>
        </view>

        <!-- 自定义情绪 -->
        <view class="emotion-card custom-emotion-card" bindtap="showCustomEmotionInput">
          <view class="emotion-css-icon emo-add">
            <view class="emo-plus-h" style="background: #D4B8A5;"></view>
            <view class="emo-plus-v" style="background: #D4B8A5;"></view>
          </view>
          <text class="emotion-name">自定义</text>
        </view>
      </view>
      </view>
    </card>

    <!-- 身体感受区域 -->
    <card type="glass" shadow="{{true}}" custom-class="body-feeling-card" wx:if="{{selectedEmotions.length > 0}}">
      <view class="body-feeling-section">
        <text class="section-title">身体有什么感觉吗？</text>
        <text class="section-hint">可选，帮助你更好地理解自己</text>
      <view class="feeling-tags">
        <view
          class="feeling-tag {{item.selected ? 'selected' : ''}}"
          wx:for="{{bodyFeelings}}"
          wx:key="name"
          bindtap="toggleBodyFeeling"
          data-feeling="{{item.name}}"
          wx:if="{{!item.isOther}}"
        >
          {{item.name}}
        </view>
        <!-- "其他"标签 + 内联输入框 -->
        <view class="other-tag-wrapper">
          <view
            class="feeling-tag {{bodyFeelings[bodyFeelings.length - 1].selected ? 'selected' : ''}}"
            bindtap="toggleBodyFeeling"
            data-feeling="其他"
          >其他</view>
          <input
            wx:if="{{showOtherInput}}"
            class="other-inline-input"
            placeholder="描述感受..."
            value="{{otherBodyFeeling}}"
            bindinput="onOtherFeelingInput"
            maxlength="30"
            adjust-position="{{true}}"
            cursor-spacing="150"
          />
        </view>
      </view>

      <!-- 快速记录区域（信纸风格） -->
      <view class="quick-note-section">
        <view class="letter-paper">
          <view class="letter-lines">
            <textarea
              class="quick-note-input"
              placeholder="今天想记点什么..."
              bindinput="onQuickNoteInput"
              maxlength="500"
              auto-height
              style="min-height: 180rpx; max-height: 300rpx;"
              adjust-position="{{true}}"
              cursor-spacing="150"
              hold-keyboard="{{true}}"
            />
          </view>
        </view>
      </view>

        <!-- 操作按钮（左右并排） -->
        <view class="action-row">
          <zh-button type="primary" size="large" custom-class="action-btn" bind:tap="saveRecord">保存记录</zh-button>
          <zh-button type="secondary" size="large" custom-class="action-btn" bind:tap="goToChat">继续对话</zh-button>
        </view>
      </view>
    </card>

    <!-- 情绪强度滑块弹窗 -->
    <view class="intensity-modal" wx:if="{{showIntensitySlider}}">
      <view class="modal-mask" bindtap="closeIntensitySlider"></view>
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title" style="color: {{currentEditingEmotion.intensityColors[currentIntensity]}};">{{currentEditingEmotion.name}}</text>
          <text class="modal-subtitle">滑动选择你的感受程度</text>
        </view>

        <!-- 当前选中的子情绪显示 -->
        <view class="current-intensity" style="border-color: {{currentEditingEmotion.intensityColors[currentIntensity]}};">
          <text class="current-label" style="color: {{currentEditingEmotion.intensityColors[currentIntensity]}};">{{currentEditingEmotion.subEmotions[currentIntensity]}}</text>
        </view>
        <view class="current-level">
          <text class="level-text" style="color: {{currentEditingEmotion.intensityColors[currentIntensity]}};">强度 {{currentIntensity + 1}}/6</text>
        </view>

        <!-- 滑动条 -->
        <view class="slider-container">
          <slider
            class="intensity-slider"
            min="0"
            max="5"
            step="1"
            value="{{currentIntensity}}"
            activeColor="{{currentEditingEmotion.intensityColors[currentIntensity]}}"
            backgroundColor="#F2E6DF"
            block-size="32"
            bindchange="onIntensityChange"
            bindchanging="onIntensityChanging"
          />

          <!-- 刻度标签 -->
          <view class="slider-labels">
            <text
              class="slider-label {{currentIntensity === idx ? 'label-active' : ''}}"
              wx:for="{{currentEditingEmotion.subEmotions}}"
              wx:key="*this"
              wx:for-index="idx"
              style="color: {{currentIntensity === idx ? currentEditingEmotion.intensityColors[currentIntensity] : '#B8B2A7'}};"
            >
              {{item}}
            </text>
          </view>
        </view>

        <!-- 确认和取消按钮 -->
        <view class="modal-buttons">
          <button class="modal-button modal-button-cancel" bindtap="closeIntensitySlider">取消</button>
          <button class="modal-button modal-button-confirm" bindtap="confirmIntensity" style="background: {{currentEditingEmotion.intensityColors[currentIntensity]}};">确认</button>
        </view>
      </view>
    </view>

    <!-- 自定义情绪输入弹窗 -->
    <view class="custom-emotion-modal" wx:if="{{showCustomEmotionModal}}">
      <view class="modal-mask" bindtap="closeCustomEmotionModal"></view>
      <view class="modal-content custom-emotion-content">
        <view class="modal-header">
          <text class="modal-title" style="color: #D4B8A5;">自定义情绪</text>
          <text class="modal-subtitle">用你自己的语言描述此刻的感受</text>
        </view>

        <!-- 信纸风格的多行输入框 -->
        <view class="custom-emotion-paper">
          <view class="paper-lines">
            <textarea
              class="custom-emotion-textarea"
              placeholder="描述你的情绪感受..."
              placeholder-style="color: #B8B2A7; font-size: 28rpx;"
              value="{{customEmotionInput}}"
              bindinput="onCustomEmotionInput"
              maxlength="50"
              auto-height
              auto-focus
              style="min-height: 200rpx; max-height: 400rpx;"
              adjust-position="{{true}}"
              cursor-spacing="150"
              hold-keyboard="{{true}}"
            />
          </view>
          <view class="char-count">{{customEmotionInput.length}}/50</view>
        </view>

        <!-- 确认和取消按钮 -->
        <view class="modal-buttons">
          <button class="modal-button modal-button-cancel" bindtap="closeCustomEmotionModal">取消</button>
          <button class="modal-button modal-button-confirm" bindtap="confirmCustomEmotion" style="background: #D4B8A5;">确认</button>
        </view>
      </view>
    </view>

  </view>

  <!-- 邮筒投递动画 -->
  <view class="mailbox-animation" wx:if="{{showMailboxAnimation}}">
    <view class="animation-mask"></view>

    <!-- 邮筒 -->
    <view class="mailbox {{mailboxState}}">
      <view class="mailbox-top">
        <view class="mailbox-flag {{mailboxState === 'delivered' ? 'raised' : ''}}"></view>
        <view class="mailbox-slot"></view>
      </view>
      <view class="mailbox-body">
        <view class="mailbox-front">
          <view class="mailbox-logo">
            <text class="mailbox-logo-text">知愈</text>
          </view>
        </view>
      </view>
      <view class="mailbox-base"></view>
    </view>

    <!-- 飞行的信纸 -->
    <view class="flying-letter {{letterState}}">
      <view class="letter-fold">
        <view class="letter-content">
          <view class="letter-emotion-stamp" wx:for="{{selectedEmotions}}" wx:key="*this" wx:if="{{index < 3}}">
            <text class="stamp-text">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 成功提示 -->
    <view class="delivery-success {{mailboxState === 'delivered' ? 'show' : ''}}">
      <view class="success-icon">
        <view class="success-checkmark"></view>
      </view>
      <text class="success-text">第 {{recordCount}} 封情绪信件已投递</text>
      <text class="success-subtitle">你的感受已被温柔收藏</text>
    </view>
  </view>

</view>
