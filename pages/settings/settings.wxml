<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">个人设置</text>
    <text class="page-subtitle">设置你的名字、头像和座右铭</text>
  </view>

  <!-- 头像设置 -->
  <view class="section-card avatar-section">
    <text class="section-title">头像</text>
    <view class="avatar-wrapper" bindtap="chooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-placeholder">
        <text class="avatar-placeholder-icon">👤</text>
      </view>
      <view class="avatar-edit-badge">
        <text class="edit-icon">📷</text>
      </view>
    </view>
  </view>

  <!-- 名字设置 -->
  <view class="section-card">
    <text class="section-title">名字</text>
    <text class="section-desc">给自己取一个喜欢的名字吧</text>
    <view class="input-group">
      <input
        class="text-input"
        type="text"
        placeholder="请输入你的名字"
        value="{{nickName}}"
        bindinput="onNickNameInput"
        maxlength="20"
      />
      <text class="input-count">{{nickName.length}}/20</text>
    </view>
  </view>

  <!-- 座右铭设置 -->
  <view class="section-card">
    <text class="section-title">座右铭</text>
    <text class="section-desc">写一句话介绍自己</text>
    <view class="input-group">
      <textarea
        class="motto-input"
        placeholder="写下你的座右铭..."
        value="{{motto}}"
        bindinput="onMottoInput"
        maxlength="50"
        auto-height
      />
      <text class="input-count">{{motto.length}}/50</text>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="button-group">
    <button class="save-btn" bindtap="saveProfile">
      <text class="btn-text">保存</text>
    </button>
  </view>

  <!-- 功能开关 -->
  <view class="section-card">
    <text class="section-title">功能设置</text>
    <view class="switch-item">
      <view class="switch-left">
        <text class="switch-icon">🌸</text>
        <text class="switch-label">她的时间</text>
      </view>
      <switch checked="{{showWomenModule}}" bindchange="toggleWomenModule" color="#D4B8A5" />
    </view>
    <view class="switch-item">
      <view class="switch-left">
        <text class="switch-icon">🎵</text>
        <text class="switch-label">背景音乐</text>
      </view>
      <switch checked="{{bgmEnabled}}" bindchange="toggleBGM" color="#D4B8A5" />
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="section-card">
    <text class="section-title">快捷功能</text>
    <view class="menu-item" bindtap="addToDesktop">
      <view class="menu-left">
        <text class="menu-icon">📱</text>
        <text class="menu-label">添加到桌面</text>
      </view>
      <text class="menu-arrow">→</text>
    </view>
  </view>
</view>
