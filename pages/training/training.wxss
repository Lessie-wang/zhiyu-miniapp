/* 表达训练页面样式 */
page {
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 40rpx 32rpx 120rpx;
  align-items: stretch;
  justify-content: flex-start;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
}

/* 两个主入口卡片 */
.main-entries-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  justify-content: center;
}

.entry-card {
  flex: 1;
  background: white;
  border-radius: 28rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.entry-card:active {
  transform: scale(0.98);
  box-shadow: 0 12rpx 32rpx rgba(212, 184, 165, 0.25);
}

.dialogue-card {
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
}

.writing-card {
  background: linear-gradient(135deg, #E8F4F8 0%, #D4E9F0 100%);
}

/* CSS 入口图标 */
.card-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 对话图标 */
.ci-dialogue {
  width: 48rpx;
  height: 40rpx;
  position: relative;
}
.ci-d-bubble1 {
  width: 34rpx;
  height: 24rpx;
  background: rgba(109, 106, 101, 0.7);
  border-radius: 14rpx;
  position: absolute;
  top: 0;
  left: 0;
}
.ci-d-bubble2 {
  width: 26rpx;
  height: 18rpx;
  border: 3rpx solid rgba(109, 106, 101, 0.5);
  border-radius: 10rpx;
  position: absolute;
  bottom: 0;
  right: 0;
}

/* 写作图标 */
.ci-writing {
  width: 40rpx;
  height: 44rpx;
  position: relative;
}
.ci-w-pen {
  width: 6rpx;
  height: 30rpx;
  background: rgba(109, 106, 101, 0.7);
  border-radius: 2rpx 2rpx 0 0;
  position: absolute;
  top: 0;
  left: 8rpx;
  transform: rotate(-15deg);
  transform-origin: bottom center;
}
.ci-w-line1 {
  width: 28rpx;
  height: 3rpx;
  background: rgba(109, 106, 101, 0.3);
  border-radius: 2rpx;
  position: absolute;
  bottom: 10rpx;
  right: 0;
}
.ci-w-line2 {
  width: 20rpx;
  height: 3rpx;
  background: rgba(109, 106, 101, 0.2);
  border-radius: 2rpx;
  position: absolute;
  bottom: 2rpx;
  right: 0;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #6D6A65;
}

.card-desc {
  font-size: 22rpx;
  color: #8C8780;
  line-height: 1.5;
}

/* 场景列表区域 */
.scenarios-section {
  animation: fadeIn 0.3s ease;
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

/* 场景卡片列表 */
.scenarios-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.scenario-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.scenario-card:active {
  background: #FAF9F7;
}

.scenario-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 复用 dialogue-training 的场景图标 */
.scene-icon-chat { width: 32rpx; height: 26rpx; position: relative; }
.scene-icon-chat .si-part1 { width: 24rpx; height: 16rpx; background: #D4B8A5; border-radius: 8rpx; position: absolute; top: 0; left: 0; opacity: 0.8; }
.scene-icon-chat .si-part2 { position: absolute; bottom: 6rpx; left: 4rpx; width: 0; height: 0; border-right: 6rpx solid #D4B8A5; border-bottom: 5rpx solid transparent; opacity: 0.8; }
.scene-icon-chat .si-part3 { width: 18rpx; height: 12rpx; border: 2rpx solid #C4A893; border-radius: 6rpx; position: absolute; bottom: 0; right: 0; opacity: 0.6; }

.scene-icon-shield { width: 26rpx; height: 30rpx; position: relative; }
.scene-icon-shield .si-part1 { width: 26rpx; height: 26rpx; border: 3rpx solid #D4B8A5; border-radius: 4rpx 4rpx 13rpx 13rpx; position: absolute; top: 0; left: 0; }
.scene-icon-shield .si-part2 { width: 3rpx; height: 14rpx; background: #D4B8A5; position: absolute; top: 8rpx; left: 50%; transform: translateX(-50%); }
.scene-icon-shield .si-part3 { width: 12rpx; height: 3rpx; background: #D4B8A5; position: absolute; top: 13rpx; left: 50%; transform: translateX(-50%); }

.scene-icon-bolt { width: 20rpx; height: 28rpx; position: relative; }
.scene-icon-bolt .si-part1 { width: 12rpx; height: 16rpx; background: #D4B8A5; position: absolute; top: 0; left: 2rpx; clip-path: polygon(100% 0, 0 100%, 60% 100%); }
.scene-icon-bolt .si-part2 { width: 12rpx; height: 16rpx; background: #C4A893; position: absolute; bottom: 0; right: 2rpx; clip-path: polygon(40% 0, 0% 0%, 100% 100%); }
.scene-icon-bolt .si-part3 { display: none; }

.scene-icon-heart { width: 28rpx; height: 26rpx; position: relative; }
.scene-icon-heart .si-part1 { width: 14rpx; height: 14rpx; background: #D4B8A5; border-radius: 50% 50% 0 0; position: absolute; top: 0; left: 2rpx; transform: rotate(-45deg); opacity: 0.8; }
.scene-icon-heart .si-part2 { width: 14rpx; height: 14rpx; background: #D4B8A5; border-radius: 50% 50% 0 0; position: absolute; top: 0; right: 2rpx; transform: rotate(45deg); opacity: 0.8; }
.scene-icon-heart .si-part3 { display: none; }

.scene-icon-custom { width: 26rpx; height: 26rpx; position: relative; }
.scene-icon-custom .si-part1 { width: 5rpx; height: 20rpx; background: #D4B8A5; border-radius: 2rpx 2rpx 0 0; position: absolute; top: 0; left: 50%; transform: translateX(-50%) rotate(-30deg); transform-origin: bottom center; }
.scene-icon-custom .si-part2 { position: absolute; bottom: 2rpx; left: 5rpx; width: 0; height: 0; border-left: 3rpx solid transparent; border-right: 3rpx solid transparent; border-top: 6rpx solid #C4A893; transform: rotate(-30deg); }
.scene-icon-custom .si-part3 { display: none; }

.scenario-info {
  flex: 1;
}

.scenario-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.scenario-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.difficulty-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  font-weight: 500;
}

.scenario-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

.scenario-arrow {
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 32rpx;
  color: #B8B2A7;
}

/* 自定义场景 */
.custom-section {
  margin-top: 8rpx;
}

.custom-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: white;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(212, 184, 165, 0.4);
}

.custom-trigger:active {
  background: #FAF9F7;
}

.custom-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.custom-trigger-text {
  flex: 1;
}

.custom-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.custom-desc {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

.custom-plus {
  font-size: 36rpx;
  color: #D4B8A5;
  font-weight: 300;
  flex-shrink: 0;
}

/* 自定义输入 */
.custom-input-area {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.custom-input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 16rpx;
}

.custom-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.7;
  padding: 16rpx 20rpx;
  background: #FAF9F7;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.custom-submit-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 16rpx;
  border: none;
  color: white;
  box-sizing: border-box;
}

.custom-submit-btn::after {
  border: none;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: white;
}

.btn-arrow {
  font-size: 28rpx;
  color: white;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 训练记录入口 ===== */
.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  margin-top: 32rpx;
}

.history-entry:active {
  background: #FAF9F7;
}

.history-entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-entry-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-entry-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

/* ===== 历史列表 ===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: fadeIn 0.3s ease;
}

.history-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.history-card:active {
  background: #FAF9F7;
}

.history-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.history-card-avatar {
  font-size: 36rpx;
  flex-shrink: 0;
}

.history-card-info {
  flex: 1;
}

.history-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.history-card-date {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

.history-card-score {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-score-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #8C7B6B;
}

.history-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 52rpx;
}

.difficulty-tag.small {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
}

.history-card-rating {
  font-size: 22rpx;
  color: #8C8780;
  font-weight: 500;
}

.history-card-rounds {
  font-size: 22rpx;
  color: #B8B2A7;
}

.back-link {
  text-align: center;
  padding: 32rpx;
  color: #B8B2A7;
  font-size: 28rpx;
}

.back-link:active {
  color: #6D6A65;
}

/* ===== 记录详情 ===== */
.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-score-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: white;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  margin-bottom: 24rpx;
  animation: fadeIn 0.3s ease;
}

.detail-score-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.detail-score-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #8C7B6B;
}

.detail-score-info {
  flex: 1;
}

.detail-score-rating {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 6rpx;
}

.detail-score-focus {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
}

/* 详情区块 */
.detail-section {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.detail-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 20rpx;
}

/* 对话回顾 */
.detail-dialogue {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-msg {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.detail-msg-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.detail-msg-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-msg-user {
  background: linear-gradient(135deg, #F5E6D3 0%, #F0DDD0 100%);
}

.detail-msg-user .detail-msg-label {
  color: #8C7B6B;
}

.detail-msg-user .detail-msg-text {
  color: #6D6A65;
}

.detail-msg-npc {
  background: #FAF9F7;
}

.detail-msg-npc .detail-msg-label {
  color: #8C8780;
}

.detail-msg-npc .detail-msg-text {
  color: #6D6A65;
}

.detail-msg-coach {
  background: linear-gradient(135deg, #E8F4F8 0%, #DFF0F5 100%);
}

.detail-msg-coach .detail-msg-label {
  color: #7BA7B5;
}

.detail-msg-coach .detail-msg-text {
  color: #5A8A99;
  font-size: 24rpx;
}

.detail-round-divider {
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(212, 184, 165, 0.3), transparent);
  margin: 8rpx 0;
}

/* 反馈列表 */
.detail-feedback-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-feedback-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.feedback-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.good-dot {
  background: #A8C5A0;
}

.improve-dot {
  background: #D4B8A5;
}

.feedback-text {
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.7;
  flex: 1;
}

/* 建议卡片 */
.detail-tip-card {
  background: linear-gradient(135deg, #FFF8F0 0%, #FFF3E8 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.detail-tip-text {
  font-size: 26rpx;
  color: #8C7B6B;
  line-height: 1.7;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-bottom: 40rpx;
}

.detail-back-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.detail-back-btn:active {
  background: #FAF9F7;
}

.detail-delete-btn {
  text-align: center;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #C4A893;
}

.detail-delete-btn:active {
  color: #A08070;
}
