/* 表达训练页面样式 - 言心小筑 - 知愈调性增强版 */
@import '/styles/safe-area.wxss';

page {
  box-sizing: border-box;
  background: #FAF9F7;
}

.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 15%, rgba(245, 198, 203, 0.25) 0%, transparent 40%),
    radial-gradient(circle at 80% 25%, rgba(196, 181, 216, 0.2) 0%, transparent 45%),
    radial-gradient(circle at 40% 60%, rgba(212, 184, 165, 0.22) 0%, transparent 50%),
    radial-gradient(circle at 70% 75%, rgba(196, 212, 181, 0.18) 0%, transparent 45%),
    radial-gradient(circle at 30% 85%, rgba(232, 212, 184, 0.2) 0%, transparent 40%),
    radial-gradient(ellipse at 50% 50%, rgba(255, 235, 230, 0.15) 0%, transparent 60%),
    linear-gradient(165deg,
      #FFF5F0 0%,
      #FFEEE5 15%,
      #FFE8E0 30%,
      #FFF0E8 50%,
      #FAF9F7 70%,
      #F8F6F4 100%);
  padding: calc(env(safe-area-inset-top) + 80rpx) 32rpx 40rpx;
  align-items: stretch;
  justify-content: flex-start;
  position: relative;
  overflow: hidden;
  animation: backgroundPulse 15s ease-in-out infinite;
}

@keyframes backgroundPulse {
  0%, 100% {
    background:
      radial-gradient(circle at 20% 15%, rgba(245, 198, 203, 0.25) 0%, transparent 40%),
      radial-gradient(circle at 80% 25%, rgba(196, 181, 216, 0.2) 0%, transparent 45%),
      radial-gradient(circle at 40% 60%, rgba(212, 184, 165, 0.22) 0%, transparent 50%),
      radial-gradient(circle at 70% 75%, rgba(196, 212, 181, 0.18) 0%, transparent 45%),
      radial-gradient(circle at 30% 85%, rgba(232, 212, 184, 0.2) 0%, transparent 40%),
      linear-gradient(165deg, #FFF5F0 0%, #FFEEE5 15%, #FFE8E0 30%, #FFF0E8 50%, #FAF9F7 70%, #F8F6F4 100%);
  }
  33% {
    background:
      radial-gradient(circle at 25% 20%, rgba(196, 181, 216, 0.28) 0%, transparent 45%),
      radial-gradient(circle at 75% 30%, rgba(245, 198, 203, 0.22) 0%, transparent 40%),
      radial-gradient(circle at 45% 55%, rgba(196, 212, 181, 0.2) 0%, transparent 48%),
      radial-gradient(circle at 65% 80%, rgba(232, 212, 184, 0.25) 0%, transparent 42%),
      radial-gradient(circle at 35% 80%, rgba(212, 184, 165, 0.18) 0%, transparent 45%),
      linear-gradient(165deg, #FFF5F0 0%, #F5EBF5 15%, #F0E8F8 30%, #FFF0E8 50%, #FAF9F7 70%, #F8F6F4 100%);
  }
  66% {
    background:
      radial-gradient(circle at 30% 25%, rgba(196, 212, 181, 0.23) 0%, transparent 42%),
      radial-gradient(circle at 70% 35%, rgba(232, 212, 184, 0.26) 0%, transparent 48%),
      radial-gradient(circle at 50% 50%, rgba(245, 198, 203, 0.2) 0%, transparent 50%),
      radial-gradient(circle at 60% 85%, rgba(196, 181, 216, 0.2) 0%, transparent 40%),
      radial-gradient(circle at 40% 75%, rgba(212, 184, 165, 0.22) 0%, transparent 43%),
      linear-gradient(165deg, #F5F8F0 0%, #FFF5E8 15%, #FFE8E0 30%, #F8F0E8 50%, #FAF9F7 70%, #F8F6F4 100%);
  }
}

/* 水彩纸张纹理背景 */
.container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    repeating-linear-gradient(0deg, transparent, transparent 3rpx, rgba(212, 184, 165, 0.03) 3rpx, rgba(212, 184, 165, 0.03) 6rpx),
    repeating-linear-gradient(90deg, transparent, transparent 3rpx, rgba(212, 184, 165, 0.03) 3rpx, rgba(212, 184, 165, 0.03) 6rpx);
  opacity: 0.6;
  pointer-events: none;
  z-index: 0;
}

/* 飘落花瓣装饰 - 增强版 */
.container::after {
  content: '';
  position: fixed;
  top: -10%;
  left: -10%;
  right: -10%;
  bottom: -10%;
  background-image:
    radial-gradient(circle at 12% 18%, rgba(245, 198, 203, 0.2) 0%, transparent 4%),
    radial-gradient(circle at 88% 22%, rgba(196, 181, 216, 0.18) 0%, transparent 4%),
    radial-gradient(circle at 35% 45%, rgba(212, 184, 165, 0.15) 0%, transparent 3.5%),
    radial-gradient(circle at 78% 58%, rgba(196, 212, 181, 0.16) 0%, transparent 3.5%),
    radial-gradient(circle at 22% 72%, rgba(232, 212, 184, 0.19) 0%, transparent 4%),
    radial-gradient(circle at 65% 85%, rgba(245, 198, 203, 0.17) 0%, transparent 3.5%),
    radial-gradient(circle at 45% 28%, rgba(255, 235, 230, 0.14) 0%, transparent 3%),
    radial-gradient(circle at 58% 68%, rgba(196, 181, 216, 0.15) 0%, transparent 3%);
  animation: petalFloat 25s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

@keyframes petalFloat {
  0%, 100% {
    transform: translateY(0) rotate(0deg) scale(1);
    opacity: 0.7;
  }
  33% {
    transform: translateY(80rpx) rotate(120deg) scale(1.1);
    opacity: 0.9;
  }
  66% {
    transform: translateY(40rpx) rotate(240deg) scale(0.95);
    opacity: 0.8;
  }
}

/* 页面标题 - 增强版 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 10;
  animation: headerSlideIn 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes headerSlideIn {
  0% {
    opacity: 0;
    transform: translateY(-30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  background: linear-gradient(135deg,
    rgba(245, 198, 203, 0.9) 0%,
    rgba(212, 184, 165, 0.85) 50%,
    rgba(196, 181, 216, 0.9) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12rpx;
  filter:
    drop-shadow(0 4rpx 12rpx rgba(245, 198, 203, 0.3))
    drop-shadow(0 2rpx 6rpx rgba(196, 181, 216, 0.25));
  animation: titleGlow 4s ease-in-out infinite;
}

@keyframes titleGlow {
  0%, 100% {
    filter:
      drop-shadow(0 4rpx 12rpx rgba(245, 198, 203, 0.3))
      drop-shadow(0 2rpx 6rpx rgba(196, 181, 216, 0.25));
  }
  50% {
    filter:
      drop-shadow(0 6rpx 16rpx rgba(196, 181, 216, 0.4))
      drop-shadow(0 3rpx 8rpx rgba(245, 198, 203, 0.3));
  }
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8B7B6F;
  font-weight: 500;
}

/* 两个主入口卡片 - 玻璃拟态增强版 */
.main-entries-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
  justify-content: center;
  position: relative;
  z-index: 10;
  animation: cardsSlideIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s backwards;
}

@keyframes cardsSlideIn {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.entry-card {
  flex: 1;
  background:
    linear-gradient(135deg,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 253, 250, 0.92) 100%);
  backdrop-filter: blur(30rpx) saturate(180%);
  -webkit-backdrop-filter: blur(30rpx) saturate(180%);
  border-radius: 32rpx;
  padding: 48rpx 24rpx;
  box-shadow:
    0 12rpx 40rpx rgba(212, 184, 165, 0.18),
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -1rpx 0 rgba(212, 184, 165, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 16rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

/* 卡片装饰边框 */
.entry-card::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1rpx solid rgba(245, 198, 203, 0.2);
  border-radius: 24rpx;
  pointer-events: none;
}

/* 卡片光晕效果 */
.entry-card::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at center, rgba(245, 198, 203, 0.15) 0%, transparent 50%);
  animation: cardGlow 8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes cardGlow {
  0%, 100% {
    transform: translate(0, 0);
    opacity: 0.5;
  }
  50% {
    transform: translate(25%, 25%);
    opacity: 0.8;
  }
}

.entry-card:active {
  transform: scale(0.96);
  box-shadow:
    0 8rpx 28rpx rgba(212, 184, 165, 0.25),
    0 3rpx 12rpx rgba(212, 184, 165, 0.15);
}

.dialogue-card {
  background:
    radial-gradient(ellipse at 30% 30%, rgba(245, 198, 203, 0.15) 0%, transparent 50%),
    linear-gradient(135deg,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 250, 245, 0.92) 100%);
}

.writing-card {
  background:
    radial-gradient(ellipse at 70% 70%, rgba(196, 181, 216, 0.12) 0%, transparent 50%),
    linear-gradient(135deg,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(250, 248, 255, 0.92) 100%);
}

/* CSS 入口图标 - 图片版 */
.card-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background:
    radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.9) 0%, transparent 70%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.3) 100%);
  box-shadow:
    0 8rpx 24rpx rgba(212, 184, 165, 0.25),
    inset 0 2rpx 6rpx rgba(255, 255, 255, 0.8);
  position: relative;
  z-index: 1;
  animation: iconFloat 3s ease-in-out infinite;
}

@keyframes iconFloat {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

.card-icon-img {
  width: 72rpx;
  height: 72rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(212, 184, 165, 0.3));
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3D3D3D;
  position: relative;
  z-index: 1;
}

.card-desc {
  font-size: 24rpx;
  color: #8B7B6F;
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

/* 场景列表区域 */
.scenarios-section {
  animation: fadeIn 0.3s ease;
  margin-bottom: 32rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

/* 场景卡片列表 */
.scenarios-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.scenario-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.scenario-card:active {
  background: #FAF9F7;
}

.scenario-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 复用 dialogue-training 的场景图标 */
.scene-icon-chat { width: 32rpx; height: 26rpx; position: relative; }
.scene-icon-chat .si-part1 { width: 24rpx; height: 16rpx; background: #D4B8A5; border-radius: 8rpx; position: absolute; top: 0; left: 0; opacity: 0.8; }
.scene-icon-chat .si-part2 { position: absolute; bottom: 6rpx; left: 4rpx; width: 0; height: 0; border-right: 6rpx solid #D4B8A5; border-bottom: 5rpx solid transparent; opacity: 0.8; }
.scene-icon-chat .si-part3 { width: 18rpx; height: 12rpx; border: 2rpx solid #C4A893; border-radius: 6rpx; position: absolute; bottom: 0; right: 0; opacity: 0.6; }

.scene-icon-shield { width: 26rpx; height: 30rpx; position: relative; }
.scene-icon-shield .si-part1 { width: 26rpx; height: 26rpx; border: 3rpx solid #D4B8A5; border-radius: 4rpx 4rpx 13rpx 13rpx; position: absolute; top: 0; left: 0; }
.scene-icon-shield .si-part2 { width: 3rpx; height: 14rpx; background: #D4B8A5; position: absolute; top: 8rpx; left: 50%; transform: translateX(-50%); }
.scene-icon-shield .si-part3 { width: 12rpx; height: 3rpx; background: #D4B8A5; position: absolute; top: 13rpx; left: 50%; transform: translateX(-50%); }

.scene-icon-bolt { width: 20rpx; height: 28rpx; position: relative; }
.scene-icon-bolt .si-part1 { width: 12rpx; height: 16rpx; background: #D4B8A5; position: absolute; top: 0; left: 2rpx; clip-path: polygon(100% 0, 0 100%, 60% 100%); }
.scene-icon-bolt .si-part2 { width: 12rpx; height: 16rpx; background: #C4A893; position: absolute; bottom: 0; right: 2rpx; clip-path: polygon(40% 0, 0% 0%, 100% 100%); }
.scene-icon-bolt .si-part3 { display: none; }

.scene-icon-heart { width: 28rpx; height: 26rpx; position: relative; }
.scene-icon-heart .si-part1 { width: 14rpx; height: 14rpx; background: #D4B8A5; border-radius: 50% 50% 0 0; position: absolute; top: 0; left: 2rpx; transform: rotate(-45deg); opacity: 0.8; }
.scene-icon-heart .si-part2 { width: 14rpx; height: 14rpx; background: #D4B8A5; border-radius: 50% 50% 0 0; position: absolute; top: 0; right: 2rpx; transform: rotate(45deg); opacity: 0.8; }
.scene-icon-heart .si-part3 { display: none; }

.scene-icon-custom { width: 26rpx; height: 26rpx; position: relative; }
.scene-icon-custom .si-part1 { width: 5rpx; height: 20rpx; background: #D4B8A5; border-radius: 2rpx 2rpx 0 0; position: absolute; top: 0; left: 50%; transform: translateX(-50%) rotate(-30deg); transform-origin: bottom center; }
.scene-icon-custom .si-part2 { position: absolute; bottom: 2rpx; left: 5rpx; width: 0; height: 0; border-left: 3rpx solid transparent; border-right: 3rpx solid transparent; border-top: 6rpx solid #C4A893; transform: rotate(-30deg); }
.scene-icon-custom .si-part3 { display: none; }

.scenario-info {
  flex: 1;
}

.scenario-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.scenario-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.difficulty-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  font-weight: 500;
}

.scenario-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

.scenario-arrow {
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 32rpx;
  color: #B8B2A7;
}

/* 自定义场景 */
.custom-section {
  margin-top: 8rpx;
}

.custom-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: white;
  border-radius: 20rpx;
  border: 2rpx dashed rgba(212, 184, 165, 0.4);
}

.custom-trigger:active {
  background: #FAF9F7;
}

.custom-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.custom-trigger-text {
  flex: 1;
}

.custom-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.custom-desc {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

.custom-plus {
  font-size: 36rpx;
  color: #D4B8A5;
  font-weight: 300;
  flex-shrink: 0;
}

/* 自定义输入 */
.custom-input-area {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.custom-input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 16rpx;
}

.custom-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.7;
  padding: 16rpx 20rpx;
  background: #FAF9F7;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.custom-submit-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 16rpx;
  border: none;
  color: white;
  box-sizing: border-box;
}

.custom-submit-btn::after {
  border: none;
}

.btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: white;
}

.btn-arrow {
  font-size: 28rpx;
  color: white;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 训练记录入口 ===== */
.history-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  margin-top: 32rpx;
}

.history-entry:active {
  background: #FAF9F7;
}

.history-entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.history-entry-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-entry-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

/* ===== 历史列表 ===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  animation: fadeIn 0.3s ease;
}

.history-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.history-card:active {
  background: #FAF9F7;
}

.history-card-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.history-card-avatar {
  font-size: 36rpx;
  flex-shrink: 0;
}

.history-card-info {
  flex: 1;
}

.history-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.history-card-date {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

.history-card-score {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-score-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #8C7B6B;
}

.history-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 52rpx;
}

.difficulty-tag.small {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
}

.history-card-rating {
  font-size: 22rpx;
  color: #8C8780;
  font-weight: 500;
}

.history-card-rounds {
  font-size: 22rpx;
  color: #B8B2A7;
}

.back-link {
  text-align: center;
  padding: 32rpx;
  color: #B8B2A7;
  font-size: 28rpx;
}

.back-link:active {
  color: #6D6A65;
}

/* ===== 记录详情 ===== */
.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-score-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: white;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  margin-bottom: 24rpx;
  animation: fadeIn 0.3s ease;
}

.detail-score-ring {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.detail-score-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #8C7B6B;
}

.detail-score-info {
  flex: 1;
}

.detail-score-rating {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 6rpx;
}

.detail-score-focus {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
}

/* 详情区块 */
.detail-section {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.detail-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 20rpx;
}

/* 对话回顾 */
.detail-dialogue {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-msg {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.detail-msg-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.detail-msg-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-msg-user {
  background: linear-gradient(135deg, #F5E6D3 0%, #F0DDD0 100%);
}

.detail-msg-user .detail-msg-label {
  color: #8C7B6B;
}

.detail-msg-user .detail-msg-text {
  color: #6D6A65;
}

.detail-msg-npc {
  background: #FAF9F7;
}

.detail-msg-npc .detail-msg-label {
  color: #8C8780;
}

.detail-msg-npc .detail-msg-text {
  color: #6D6A65;
}

.detail-msg-coach {
  background: linear-gradient(135deg, #E8F4F8 0%, #DFF0F5 100%);
}

.detail-msg-coach .detail-msg-label {
  color: #7BA7B5;
}

.detail-msg-coach .detail-msg-text {
  color: #5A8A99;
  font-size: 24rpx;
}

.detail-round-divider {
  height: 1rpx;
  background: linear-gradient(to right, transparent, rgba(212, 184, 165, 0.3), transparent);
  margin: 8rpx 0;
}

/* 反馈列表 */
.detail-feedback-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-feedback-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.feedback-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.good-dot {
  background: #A8C5A0;
}

.improve-dot {
  background: #D4B8A5;
}

.feedback-text {
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.7;
  flex: 1;
}

/* 建议卡片 */
.detail-tip-card {
  background: linear-gradient(135deg, #FFF8F0 0%, #FFF3E8 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  animation: fadeIn 0.3s ease;
}

.detail-tip-text {
  font-size: 26rpx;
  color: #8C7B6B;
  line-height: 1.7;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-bottom: 40rpx;
}

.detail-back-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  background: white;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.detail-back-btn:active {
  background: #FAF9F7;
}

.detail-delete-btn {
  text-align: center;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #C4A893;
}

.detail-delete-btn:active {
  color: #A08070;
}
