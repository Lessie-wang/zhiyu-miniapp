/* 联系知愈页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 40rpx;
  padding-bottom: 80rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #D4B8A5;
  letter-spacing: 2rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  margin-top: 16rpx;
}

/* 功能列表 */
.menu-list {
  margin-bottom: 48rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  transition: all 0.3s ease;
  /* 重置 button 默认样式 */
  border: none;
  text-align: left;
  line-height: normal;
  font-size: inherit;
}

.menu-item::after {
  border: none;
}

.menu-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.menu-icon {
  font-size: 44rpx;
  width: 60rpx;
  text-align: center;
}

.menu-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.menu-title {
  font-size: 30rpx;
  color: #6D6A65;
  font-weight: 600;
}

.menu-desc {
  font-size: 24rpx;
  color: #B8B2A7;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #D4B8A5;
  font-weight: 600;
}

/* NEW 标签 */
.new-badge {
  font-size: 20rpx;
  color: white;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

/* 底部危险操作区 */
.danger-section {
  margin-top: 24rpx;
  margin-bottom: 48rpx;
}

.menu-item.danger {
  background: #FFFBFA;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.08);
}

.danger-text {
  color: #E8836B;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 24rpx 0;
}

.version-text {
  font-size: 22rpx;
  color: #C4BDB5;
}
