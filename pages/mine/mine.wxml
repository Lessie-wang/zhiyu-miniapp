<view class="container">
  <!-- 落叶特效 -->
  <view class="falling-leaves">
    <view class="leaf leaf1"></view>
    <view class="leaf leaf2"></view>
    <view class="leaf leaf3"></view>
    <view class="leaf leaf4"></view>
    <view class="leaf leaf5"></view>
    <view class="leaf leaf6"></view>
    <view class="leaf leaf7"></view>
    <view class="leaf leaf8"></view>
  </view>

  <!-- 用户信息卡片 -->
  <view class="user-card" hover-class="card-hover">
    <view class="user-avatar">
      <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="avatar-css-icon">
        <view class="avi-head"></view>
        <view class="avi-body"></view>
      </view>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickName || '知愈用户'}}</text>
      <text class="user-motto">每一种感受都值得被看见</text>
    </view>
    <view class="edit-profile" bindtap="editProfile">
      <text class="edit-icon">›</text>
    </view>
  </view>

  <!-- 知愈之树 - 水彩渐变背景 -->
  <view class="tree-section">
    <!-- 树周围的光晕 -->
    <view class="tree-glow"></view>

    <!-- 功能按钮 -->
    <view class="tree-node node-1" hover-class="node-active" bindtap="goToEmotionLibrary">
      <view class="node-circle">
        <image class="node-icon-img" src="/assets/images/icons/icon-emotion-library.jpg" mode="aspectFit"></image>
      </view>
      <text class="node-label">情绪库</text>
    </view>

    <view class="tree-node node-2" hover-class="node-active" bindtap="goToSettings">
      <view class="node-circle">
        <image class="node-icon-img" src="/assets/images/icons/icon-settings.jpg" mode="aspectFit"></image>
      </view>
      <text class="node-label">设置</text>
    </view>

    <view class="tree-node node-3" hover-class="node-active" bindtap="goToAbout">
      <view class="node-circle">
        <image class="node-icon-img" src="/assets/images/icons/icon-about.jpg" mode="aspectFit"></image>
      </view>
      <text class="node-label">关于知愈</text>
    </view>
  </view>

  <view class="version-info">
    <text class="version-text">知愈 FeelingMosaic v1.2.0</text>
  </view>
</view>
