<view class="container">
  <!-- 背景图层 -->
  <image class="bg-image" src="/assets/images/index/welcome-bg.jpg" mode="aspectFill"></image>

  <!-- 玻璃态遮罩 -->
  <view class="glass-overlay"></view>

  <!-- BGM 开关按钮 -->
  <view class="bgm-toggle" bindtap="toggleBGM">
    <view class="icon-music {{bgmEnabled ? '' : 'muted'}}">
      <view class="music-note"></view>
      <view class="music-wave music-wave-1" wx:if="{{bgmEnabled}}"></view>
      <view class="music-wave music-wave-2" wx:if="{{bgmEnabled}}"></view>
      <view class="mute-line" wx:if="{{!bgmEnabled}}"></view>
    </view>
  </view>

  <!-- 最上层：半透明信封 -->
  <view class="envelope-layer {{envelopeOpened ? 'opened' : ''}}"
        bindtouchmove="onTouchMove"
        bindtouchstart="onTouchStart"
        bindtouchend="onTouchEnd">

    <!-- 信封上方：Logo 文字 -->
    <view class="logo-above-envelope">
      <text class="logo-text-main">知愈</text>
      <text class="logo-text-sub">FeelingMosaic</text>
    </view>

    <!-- 信封主体 -->
    <view class="envelope-body">
      <!-- 信封背面 - 使用水彩图片 -->
      <image class="envelope-back-img" src="/assets/images/index/envelope-main.png" mode="aspectFit"></image>

      <!-- 信封封口 - 使用水彩图片 -->
      <image class="envelope-flap-img {{envelopeOpened ? 'opening' : ''}}" src="/assets/images/index/envelope-seal.png" mode="aspectFit"></image>
    </view>

    <!-- 信封下方：随机名言 -->
    <view class="quote-below-envelope" bindtap="onQuoteTap">
      <text class="quote-text">{{currentQuote}}</text>
    </view>

    <!-- 手指向上滑动提示 -->
    <view class="swipe-hint {{envelopeOpened ? 'hidden' : ''}}">
      <view class="hand-icon">
        <view class="finger"></view>
      </view>
      <view class="hint-arrow">
        <view class="arrow-line"></view>
        <view class="arrow-head"></view>
      </view>
      <text class="hint-text">向上滑动开启</text>
    </view>
  </view>
</view>
