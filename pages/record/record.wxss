/* 情绪记录页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 40rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.page-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #D4B8A5;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #B8B2A7;
  line-height: 1.6;
}

/* 区块标签 */
.section-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 24rpx;
}

/* 情绪选择区域 */
.emotion-select-section {
  margin-bottom: 48rpx;
}

.emotion-tags-scroll {
  width: 100%;
  white-space: nowrap;
}

.emotion-tags {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.emotion-tag {
  display: inline-block;
  padding: 20rpx 32rpx;
  background: white;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #6D6A65;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.1);
  transition: all 0.3s ease;
  white-space: nowrap;
}

.emotion-tag.active {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.3);
  transform: scale(1.05);
}

/* 强度选择区域 */
.intensity-section {
  margin-bottom: 48rpx;
  background: white;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(212, 184, 165, 0.15);
}

.intensity-slider {
  margin: 32rpx 0;
}

.intensity-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.intensity-label {
  font-size: 24rpx;
  color: #B8B2A7;
}

/* 文字记录区域 */
.note-section {
  margin-bottom: 48rpx;
  background: white;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(212, 184, 165, 0.15);
}

.note-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.8;
  margin-top: 16rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #B8B2A7;
  margin-top: 16rpx;
}

/* 保存按钮 */
.action-footer {
  margin-top: 40rpx;
}

.save-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(212, 184, 165, 0.3);
  border: none;
}

.save-btn[disabled] {
  background: #E8E8E8;
  box-shadow: none;
  opacity: 0.6;
}

.save-btn::after {
  border: none;
}

.btn-text {
  font-size: 32rpx;
  color: white;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.save-btn[disabled] .btn-text {
  color: #B8B2A7;
}

/* 感官写作引导弹窗 */
.writing-prompt-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.writing-prompt-card {
  width: 100%;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  padding: 48rpx 40rpx 80rpx;
  text-align: center;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.prompt-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.prompt-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.prompt-desc {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.prompt-buttons {
  display: flex;
  gap: 20rpx;
}

.prompt-btn {
  flex: 1;
  padding: 26rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.prompt-btn::after {
  border: none;
}

.prompt-btn.primary {
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.3);
}

.prompt-btn.secondary {
  background: #FAF9F7;
  color: #B8B2A7;
}

.prompt-btn:active {
  transform: scale(0.97);
}
