/* 她的时间页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 40rpx 32rpx 120rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #B8B2A7;
}

/* AI 关怀卡片 */
.ai-care-card {
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  text-align: center;
}

.care-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.care-message {
  display: block;
  font-size: 30rpx;
  color: #6D6A65;
  line-height: 1.6;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.care-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.chat-btn, .companion-btn {
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  border-radius: 48rpx;
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.3);
  flex: 1;
}

.companion-btn {
  background: linear-gradient(90deg, #B8A490 0%, #A89580 100%);
}

.chat-btn:active, .companion-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  color: white;
}

/* 生理期状态卡片 */
.period-status-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.record-btn {
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  border: none;
}

.status-content {
  margin-top: 20rpx;
}

.status-info {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #B8B2A7;
  margin-right: 12rpx;
}

.info-value {
  font-size: 28rpx;
  color: #6D6A65;
  font-weight: 600;
}

.edit-link {
  font-size: 24rpx;
  color: #D4B8A5;
  margin-left: 16rpx;
  text-decoration: underline;
}

/* 周期可视化 */
.cycle-visual {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
}

.cycle-indicator {
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
}

.cycle-indicator.before {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3CC 100%);
}

.cycle-indicator.during {
  background: linear-gradient(135deg, #FFE8E8 0%, #FFD6D6 100%);
}

.cycle-indicator.after {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.indicator-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.status-empty {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #B8B2A7;
}

/* 痛经管理 */
.pain-management-section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

/* 经期情绪提示卡片 */
.emotion-tip-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.tip-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tip-phase-icon {
  font-size: 36rpx;
}

.tip-phase-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.tip-emotions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tip-emotion-tag {
  background: #F2E6DF;
  color: #8C8780;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.tip-message {
  display: block;
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.7;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
}

.tip-suggestions {
  padding: 0 4rpx;
}

.tip-suggestion-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8C8780;
  margin-bottom: 12rpx;
}

.tip-suggestion-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.tip-suggestion-item:last-child {
  margin-bottom: 0;
}

.suggestion-dot {
  font-size: 28rpx;
  color: #D4B8A5;
  margin-right: 12rpx;
  line-height: 1.6;
}

.suggestion-text {
  font-size: 26rpx;
  color: #8C8780;
  line-height: 1.6;
  flex: 1;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.section-hint {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
  margin-bottom: 24rpx;
}

.pain-scale {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  gap: 8rpx;
}

.pain-level {
  flex: 1;
  aspect-ratio: 1;
  background: #FAF9F7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.pain-level.selected {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-color: #B8A490;
  transform: scale(1.1);
}

.level-number {
  font-size: 24rpx;
  font-weight: 600;
  color: #B8B2A7;
}

.pain-level.selected .level-number {
  color: white;
}

.pain-legend {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
}

.legend-item {
  font-size: 22rpx;
  color: #B8B2A7;
}

/* 护理知识 */
.care-knowledge-section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.section-header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.section-badge {
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.knowledge-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.knowledge-card {
  background: #FAF9F7;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.knowledge-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.15);
}

.knowledge-icon {
  display: block;
  font-size: 56rpx;
}

.knowledge-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.knowledge-desc {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  line-height: 1.4;
}

/* 舒缓音乐 */
.music-section {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.music-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.music-item {
  background: #FAF9F7;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 0.3s ease;
}

.music-item:active {
  transform: scale(0.98);
  background: #F2E6DF;
}

.music-icon {
  font-size: 48rpx;
}

.music-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.music-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.music-duration {
  font-size: 24rpx;
  color: #B8B2A7;
}

.play-icon {
  font-size: 32rpx;
}

/* 情绪报告 */
.emotion-report-section {
  margin-bottom: 24rpx;
}

.report-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.report-icon {
  font-size: 56rpx;
}

.report-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.report-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.report-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

.view-report-btn {
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  border-radius: 32rpx;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  white-space: nowrap;
}

.view-report-btn:active {
  transform: scale(0.98);
}

/* 功能开发中遮罩 */
.dev-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(250, 249, 247, 0.45);
  backdrop-filter: blur(8rpx);
  animation: fadeIn 0.3s ease;
}

.dev-overlay-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 48rpx;
  background: white;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(212, 184, 165, 0.25);
  animation: slideUp 0.3s ease;
}

.dev-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.dev-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 16rpx;
}

.dev-desc {
  display: block;
  font-size: 28rpx;
  color: #B8B2A7;
  text-align: center;
  line-height: 1.8;
  margin-bottom: 40rpx;
}

.dev-close-btn {
  width: 280rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: white;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev-close-btn::after {
  border: none;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(100rpx); }
  to { opacity: 1; transform: translateY(0); }
}
