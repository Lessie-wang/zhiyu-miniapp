/* 商店页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 40rpx 6rpx 80rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
}

/* 我的订单入口 */
.order-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.order-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-icon {
  font-size: 40rpx;
}

.order-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #6D6A65;
}

.order-arrow {
  font-size: 28rpx;
  color: #C4BDB5;
  font-weight: 600;
}

/* 分类标题 */
.section-title {
  margin-bottom: 28rpx;
  text-align: center;
}

.title-text {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 8rpx;
  text-align: center;
}

.title-desc {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
  text-align: center;
}

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  padding: 0 4rpx;
}

.product-card {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  box-sizing: border-box;
  aspect-ratio: 0.5;
  display: flex;
  flex-direction: column;
}

.product-card.coming-soon {
  opacity: 0.85;
}

.product-image-placeholder {
  width: 100%;
  flex: 1;
  background: linear-gradient(135deg, #F5EDE8 0%, #EDE3DC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 96rpx;
}

.product-info {
  padding: 20rpx 24rpx 24rpx;
  text-align: center;
}

.product-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 10rpx;
  text-align: center;
}

.product-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: linear-gradient(135deg, #E8C4D8 0%, #D4B8E8 100%);
  color: white;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

/* 底部提示 */
.bottom-hint {
  text-align: center;
  padding: 48rpx 0 20rpx;
}

.hint-text {
  font-size: 24rpx;
  color: #C4BDB5;
}
