.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding-bottom: 80rpx;
}

.emotion-header {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.emotion-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translate(0, 0);
  }
  50% {
    transform: translate(20rpx, 20rpx);
  }
}

.emotion-icon {
  display: block;
  font-size: 120rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.emotion-name {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: white;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
}

.sub-emotions-section {
  padding: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 24rpx;
}

.sub-emotions-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sub-emotion-item {
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.1);
}

.sub-emotion-name {
  font-size: 28rpx;
  font-weight: 600;
  color: white;
}

.intensity-level {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.interpretation-section {
  padding: 0 40rpx 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
}

.content-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.content-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #6D6A65;
  text-align: justify;
}

.story-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 20rpx;
}

.image-section {
  padding: 0 40rpx 40rpx;
}

.image-placeholder {
  background: white;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  border: 4rpx dashed #D4B8A5;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.placeholder-text {
  display: block;
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.placeholder-hint {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
}
