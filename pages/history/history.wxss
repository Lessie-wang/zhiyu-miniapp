  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-tag {
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.section-caption {
  font-size: 22rpx;
  color: #A49B92;
}

.report-card-main {
  border-radius: 28rpx;
  padding: 32rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.95) 0%, rgba(255,247,243,0.92) 100%);
  box-shadow: 0 8rpx 30rpx rgba(212, 184, 165, 0.14);
}

