/* ==================== 心脏藤蔓盆栽养成系统 v2.0 - 极致精修 ==================== */

/* 盆栽容器 - 彩色玻璃花园围栏 */
.plant-section {
  margin: 0 var(--spacing-xl) 32rpx;
  padding: 32rpx var(--spacing-lg) 28rpx;
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 250, 247, 0.68) 50%,
    rgba(255, 245, 240, 0.72) 100%);
  border-radius: 24rpx;
  box-shadow:
    0 20rpx 60rpx rgba(212, 184, 165, 0.25),
    0 8rpx 24rpx rgba(212, 184, 165, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.6),
    inset 0 -2rpx 8rpx rgba(212, 184, 165, 0.08);
  border: 2rpx solid transparent;
  background-clip: padding-box;
  backdrop-filter: blur(40rpx) saturate(150%);
  -webkit-backdrop-filter: blur(40rpx) saturate(150%);
  animation: fadeInUp 0.5s var(--ease-smooth);
  position: relative;
  overflow: visible;
  z-index: 20;
}

/* 背景装饰光晕 - 温柔呼吸感 */
.plant-section::before {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  background: linear-gradient(135deg,
    rgba(245, 198, 203, 0.6) 0%,
    rgba(196, 181, 216, 0.5) 25%,
    rgba(196, 212, 181, 0.5) 50%,
    rgba(232, 212, 184, 0.6) 75%,
    rgba(245, 198, 203, 0.6) 100%);
  border-radius: 26rpx;
  z-index: -1;
  animation: gardenGlow 8s ease-in-out infinite;
}

@keyframes gardenGlow {
  0%, 100% {
    background: linear-gradient(135deg,
      rgba(245, 198, 203, 0.6) 0%,
      rgba(196, 181, 216, 0.5) 25%,
      rgba(196, 212, 181, 0.5) 50%,
      rgba(232, 212, 184, 0.6) 75%,
      rgba(245, 198, 203, 0.6) 100%);
  }
  50% {
    background: linear-gradient(135deg,
      rgba(196, 212, 181, 0.6) 0%,
      rgba(232, 212, 184, 0.5) 25%,
      rgba(245, 198, 203, 0.5) 50%,
      rgba(196, 181, 216, 0.6) 75%,
      rgba(196, 212, 181, 0.6) 100%);
  }
}

/* 彩色玻璃花园围栏装饰 */
.plant-section::after {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border: 2rpx dashed rgba(212, 184, 165, 0.3);
  border-radius: 18rpx;
  pointer-events: none;
  z-index: 0;
  background:
    linear-gradient(90deg, transparent 0%, transparent 48%, rgba(245, 198, 203, 0.15) 48%, rgba(245, 198, 203, 0.15) 52%, transparent 52%, transparent 100%),
    linear-gradient(0deg, transparent 0%, transparent 48%, rgba(196, 181, 216, 0.15) 48%, rgba(196, 181, 216, 0.15) 52%, transparent 52%, transparent 100%);
  background-size: 60rpx 100%, 100% 60rpx;
  background-position: 0 0, 0 0;
  box-shadow:
    inset 0 0 30rpx rgba(245, 198, 203, 0.1),
    inset 0 0 20rpx rgba(196, 181, 216, 0.1);
}

@keyframes plantGlow {
  0%, 100% {
    opacity: 0.8;
  }
  50% {
    opacity: 1;
  }
}

.plant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
  position: relative;
  z-index: 1;
}

.plant-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-shadow: 0 2rpx 8rpx rgba(245, 198, 203, 0.2);
  letter-spacing: 0.5rpx;
}

.plant-stage-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg,
    rgba(245, 198, 203, 0.25) 0%,
    rgba(212, 184, 165, 0.18) 100%);
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(245, 198, 203, 0.2);
  backdrop-filter: blur(10rpx);
}

.plant-canvas {
  position: relative;
  width: 100%;
  height: 320rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1;
  margin: 8rpx 0;
}

/* ========== 花盆 - 精致陶瓷质感 ========== */
.plant-pot {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 120rpx;
  z-index: 1;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.15));
}

.pot-body {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 180rpx;
  height: 100rpx;
  background: linear-gradient(180deg,
    rgba(212, 184, 165, 0.9) 0%,
    rgba(196, 168, 147, 0.95) 50%,
    rgba(184, 154, 127, 0.98) 100%);
  border-radius: 0 0 20rpx 20rpx;
  clip-path: polygon(15% 0%, 85% 0%, 100% 100%, 0% 100%);
  box-shadow:
    inset 0 3rpx 12rpx rgba(0, 0, 0, 0.15),
    inset -2rpx 0 8rpx rgba(0, 0, 0, 0.08),
    inset 2rpx 0 8rpx rgba(255, 255, 255, 0.1),
    0 6rpx 16rpx rgba(212, 184, 165, 0.35);
}

/* 花盆高光 */
.pot-body::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 20rpx;
  width: 30rpx;
  height: 60rpx;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.15) 0%,
    transparent 100%);
  border-radius: 50%;
  filter: blur(4rpx);
}

.pot-rim {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 26rpx;
  background: linear-gradient(180deg,
    rgba(235, 210, 190, 0.98) 0%,
    rgba(225, 200, 180, 0.95) 50%,
    rgba(212, 184, 165, 0.92) 100%);
  border-radius: 13rpx;
  box-shadow:
    0 3rpx 8rpx rgba(212, 184, 165, 0.45),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.1);
}

/* 花盆边缘高光 */
.pot-rim::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 10%;
  right: 10%;
  height: 8rpx;
  background: linear-gradient(90deg,
    transparent,
    rgba(255, 255, 255, 0.3),
    transparent);
  border-radius: 50%;
  filter: blur(2rpx);
}

.pot-soil {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 180rpx;
  height: 28rpx;
  background: radial-gradient(ellipse,
    rgba(155, 128, 108, 0.85) 0%,
    rgba(145, 118, 98, 0.9) 100%);
  border-radius: 50%;
  box-shadow:
    inset 0 3rpx 8rpx rgba(0, 0, 0, 0.2),
    0 1rpx 3rpx rgba(0, 0, 0, 0.1);
}

/* 泥土颗粒纹理 */
.pot-soil::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(0, 0, 0, 0.1) 1rpx, transparent 1rpx),
    radial-gradient(circle at 60% 50%, rgba(0, 0, 0, 0.08) 1rpx, transparent 1rpx),
    radial-gradient(circle at 80% 70%, rgba(0, 0, 0, 0.09) 1rpx, transparent 1rpx);
  border-radius: 50%;
}

/* ========== 阶段1：种子 (0-5次) - 生命萌芽 ========== */
.plant-stage-1 .seed {
  position: absolute;
  top: 35rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 22rpx;
  background: linear-gradient(135deg,
    rgba(212, 184, 165, 0.95) 0%,
    rgba(196, 168, 147, 1) 100%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  box-shadow:
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.25),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.2),
    0 3rpx 8rpx rgba(212, 184, 165, 0.4);
  animation: seedBreath 5s ease-in-out infinite;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.15));
}

/* 种子纹理 */
.plant-stage-1 .seed::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 50%;
}

@keyframes seedBreath {
  0%, 100% {
    transform: translateX(-50%) scale(1);
    opacity: 0.95;
    box-shadow:
      inset 0 2rpx 4rpx rgba(0, 0, 0, 0.25),
      inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.2),
      0 3rpx 8rpx rgba(212, 184, 165, 0.4);
  }
  50% {
    transform: translateX(-50%) scale(1.08);
    opacity: 1;
    box-shadow:
      inset 0 2rpx 4rpx rgba(0, 0, 0, 0.25),
      inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.3),
      0 4rpx 12rpx rgba(212, 184, 165, 0.5);
  }
}

/* ========== 阶段2：发芽 (6-15次) - 破土而出 ========== */
.plant-stage-2 .sprout {
  position: absolute;
  bottom: 120rpx;
  width: 9rpx;
  background: linear-gradient(180deg,
    rgba(200, 220, 200, 0.9) 0%,
    rgba(188, 208, 188, 0.85) 50%,
    rgba(170, 190, 170, 0.95) 100%);
  border-radius: 5rpx 5rpx 0 0;
  transform-origin: bottom center;
  animation: sproutGrow 1.8s ease-out forwards,
             sproutSway 4s ease-in-out infinite;
  box-shadow:
    inset 1rpx 0 2rpx rgba(255, 255, 255, 0.3),
    inset -1rpx 0 2rpx rgba(0, 0, 0, 0.1),
    0 2rpx 6rpx rgba(188, 208, 188, 0.3);
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

/* 嫩芽高光 */
.plant-stage-2 .sprout::before {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 2rpx;
  width: 3rpx;
  height: 8rpx;
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.4) 0%,
    transparent 100%);
  border-radius: 50%;
  filter: blur(1rpx);
}

.sprout-1 {
  left: calc(50% - 20rpx);
  height: 42rpx;
  animation-delay: 0s, 0.6s;
}

.sprout-2 {
  left: 50%;
  height: 52rpx;
  animation-delay: 0.4s, 1s;
}

.sprout-3 {
  left: calc(50% + 20rpx);
  height: 37rpx;
  animation-delay: 0.8s, 1.4s;
}

@keyframes sproutGrow {
  0% {
    height: 0;
    opacity: 0;
    transform: scaleY(0);
  }
  60% {
    opacity: 1;
    transform: scaleY(1.1);
  }
  100% {
    opacity: 1;
    transform: scaleY(1);
  }
}

@keyframes sproutSway {
  0%, 100% {
    transform: rotate(0deg);
  }
  25% {
    transform: rotate(4deg);
  }
  75% {
    transform: rotate(-4deg);
  }
}

/* ========== 阶段3：小苗 (16-30次) - 心形初现 ========== */
.plant-stage-3 .vine {
  position: absolute;
  bottom: 120rpx;
  width: 7rpx;
  background: linear-gradient(180deg,
    rgba(200, 220, 200, 0.9) 0%,
    rgba(188, 208, 188, 0.88) 50%,
    rgba(170, 190, 170, 0.98) 100%);
  border-radius: 4rpx;
  transform-origin: bottom center;
  animation: vineGrow 2.5s ease-out forwards,
             vineSway 5s ease-in-out infinite;
  box-shadow:
    inset 1rpx 0 3rpx rgba(255, 255, 255, 0.35),
    inset -1rpx 0 2rpx rgba(0, 0, 0, 0.12),
    0 2rpx 8rpx rgba(188, 208, 188, 0.35);
  filter: drop-shadow(0 2rpx 6rpx rgba(0, 0, 0, 0.12));
}

/* 藤蔓纹理 */
.plant-stage-3 .vine::before {
  content: '';
  position: absolute;
  top: 0;
  left: 2rpx;
  width: 2rpx;
  height: 100%;
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.3) 0%,
    transparent 100%);
  border-radius: 50%;
  filter: blur(1rpx);
}

/* 心形轮廓初现 - 7根藤蔓 */
.vine-1 { left: calc(50% - 60rpx); height: 82rpx; animation-delay: 0s, 0.6s; }
.vine-2 { left: calc(50% - 40rpx); height: 102rpx; animation-delay: 0.3s, 1s; }
.vine-3 { left: calc(50% - 20rpx); height: 112rpx; animation-delay: 0.6s, 1.4s; }
.vine-4 { left: 50%; height: 122rpx; animation-delay: 0.9s, 1.8s; }
.vine-5 { left: calc(50% + 20rpx); height: 112rpx; animation-delay: 1.2s, 2.2s; }
.vine-6 { left: calc(50% + 40rpx); height: 102rpx; animation-delay: 1.5s, 2.6s; }
.vine-7 { left: calc(50% + 60rpx); height: 82rpx; animation-delay: 1.8s, 3s; }

@keyframes vineGrow {
  0% {
    height: 0;
    opacity: 0;
    transform: scaleY(0);
  }
  60% {
    opacity: 1;
    transform: scaleY(1.08);
  }
  100% {
    opacity: 1;
    transform: scaleY(1);
  }
}

@keyframes vineSway {
  0%, 100% {
    transform: rotate(0deg) scaleY(1);
  }
  25% {
    transform: rotate(3deg) scaleY(1.03);
  }
  75% {
    transform: rotate(-3deg) scaleY(1.03);
  }
}

/* 小叶片 - 精致质感 */
.vine-leaf {
  position: absolute;
  width: 13rpx;
  height: 9rpx;
  background: linear-gradient(135deg,
    rgba(210, 230, 210, 0.9) 0%,
    rgba(200, 220, 200, 0.85) 50%,
    rgba(188, 208, 188, 0.95) 100%);
  border-radius: 0 50% 50% 50%;
  animation: leafBreath 6s ease-in-out infinite;
  box-shadow:
    inset 1rpx 1rpx 2rpx rgba(255, 255, 255, 0.4),
    inset -1rpx -1rpx 2rpx rgba(0, 0, 0, 0.1),
    0 1rpx 3rpx rgba(188, 208, 188, 0.3);
}

/* 叶脉 */
.vine-leaf::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 3rpx;
  right: 2rpx;
  height: 1rpx;
  background: linear-gradient(90deg,
    rgba(170, 190, 170, 0.4),
    transparent);
  transform: rotate(-30deg);
}

@keyframes leafBreath {
  0%, 100% {
    transform: scale(1) rotate(0deg);
    opacity: 0.9;
  }
  50% {
    transform: scale(1.05) rotate(2deg);
    opacity: 1;
  }
}

/* ========== 阶段4：茂盛 (31-50次) - 完整心形 ========== */
.plant-stage-4 .vine {
  width: 8rpx;
  filter: drop-shadow(0 3rpx 8rpx rgba(0, 0, 0, 0.15));
  background: linear-gradient(180deg,
    rgba(200, 220, 200, 0.92) 0%,
    rgba(188, 208, 188, 0.9) 50%,
    rgba(170, 190, 170, 1) 100%);
}

/* 完整心形 - 15根藤蔓 */
.plant-stage-4 .vine-1 { left: calc(50% - 90rpx); height: 62rpx; }
.plant-stage-4 .vine-2 { left: calc(50% - 75rpx); height: 92rpx; }
.plant-stage-4 .vine-3 { left: calc(50% - 60rpx); height: 122rpx; }
.plant-stage-4 .vine-4 { left: calc(50% - 45rpx); height: 142rpx; }
.plant-stage-4 .vine-5 { left: calc(50% - 30rpx); height: 152rpx; }
.plant-stage-4 .vine-6 { left: calc(50% - 15rpx); height: 157rpx; }
.plant-stage-4 .vine-7 { left: 50%; height: 162rpx; }
.plant-stage-4 .vine-8 { left: calc(50% + 15rpx); height: 157rpx; }
.plant-stage-4 .vine-9 { left: calc(50% + 30rpx); height: 152rpx; }
.plant-stage-4 .vine-10 { left: calc(50% + 45rpx); height: 142rpx; }
.plant-stage-4 .vine-11 { left: calc(50% + 60rpx); height: 122rpx; }
.plant-stage-4 .vine-12 { left: calc(50% + 75rpx); height: 92rpx; }
.plant-stage-4 .vine-13 { left: calc(50% + 90rpx); height: 62rpx; }
.plant-stage-4 .vine-14 { left: calc(50% - 105rpx); height: 42rpx; }
.plant-stage-4 .vine-15 { left: calc(50% + 105rpx); height: 42rpx; }

/* 更多叶片 - 精致质感 */
.plant-stage-4 .vine-leaf {
  width: 15rpx;
  height: 11rpx;
  box-shadow:
    inset 1rpx 1rpx 3rpx rgba(255, 255, 255, 0.4),
    inset -1rpx -1rpx 2rpx rgba(0, 0, 0, 0.12),
    0 2rpx 4rpx rgba(188, 208, 188, 0.35);
}

/* ========== 阶段5：开花 (51+次) - 绽放生命 ========== */
.plant-stage-5 .vine {
  width: 9rpx;
  filter: drop-shadow(0 3rpx 10rpx rgba(0, 0, 0, 0.18));
  background: linear-gradient(180deg,
    rgba(210, 230, 210, 0.95) 0%,
    rgba(200, 220, 200, 0.92) 50%,
    rgba(188, 208, 188, 1) 100%);
}

/* 花朵 - 精致五瓣花 */
.flower {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  animation: flowerBloom 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
             flowerSparkle 8s ease-in-out infinite;
  filter: drop-shadow(0 3rpx 8rpx rgba(245, 198, 203, 0.4));
}

@keyframes flowerBloom {
  0% {
    transform: scale(0) rotate(-90deg);
    opacity: 0;
  }
  60% {
    transform: scale(1.25) rotate(10deg);
    opacity: 0.95;
  }
  80% {
    transform: scale(0.95) rotate(-5deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

@keyframes flowerSparkle {
  0%, 90%, 100% {
    filter: drop-shadow(0 3rpx 8rpx rgba(245, 198, 203, 0.4)) brightness(1);
  }
  94% {
    filter: drop-shadow(0 4rpx 16rpx rgba(245, 198, 203, 0.7)) brightness(1.3);
  }
  97% {
    filter: drop-shadow(0 6rpx 20rpx rgba(245, 198, 203, 0.9)) brightness(1.5);
  }
}

/* 花心 - 立体质感 */
.flower-center {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: radial-gradient(circle at 30% 30%,
    rgba(255, 230, 200, 1) 0%,
    rgba(245, 210, 180, 1) 40%,
    rgba(238, 196, 165, 0.98) 100%);
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  box-shadow:
    0 2rpx 6rpx rgba(0, 0, 0, 0.25),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.5),
    inset 0 -1rpx 2rpx rgba(0, 0, 0, 0.15);
  z-index: 2;
}

/* 花心纹理 */
.flower-center::before {
  content: '';
  position: absolute;
  top: 2rpx;
  left: 2rpx;
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  filter: blur(1rpx);
}

/* 花瓣 - 精致渐变 */
.flower-petal {
  position: absolute;
  width: 11rpx;
  height: 16rpx;
  background: linear-gradient(135deg,
    rgba(255, 220, 230, 0.95) 0%,
    rgba(245, 198, 203, 0.92) 40%,
    rgba(232, 196, 216, 0.88) 100%);
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  top: 50%;
  left: 50%;
  transform-origin: center center;
  box-shadow:
    inset 1rpx 1rpx 3rpx rgba(255, 255, 255, 0.5),
    inset -1rpx -1rpx 2rpx rgba(232, 196, 216, 0.4),
    0 1rpx 4rpx rgba(245, 198, 203, 0.3);
  z-index: 1;
}

/* 花瓣纹理 */
.flower-petal::before {
  content: '';
  position: absolute;
  top: 3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 1rpx;
  height: 8rpx;
  background: linear-gradient(180deg,
    rgba(232, 196, 216, 0.3) 0%,
    transparent 100%);
  border-radius: 50%;
}

/* 花瓣位置 - 五瓣对称 */
.petal-1 { transform: translate(-50%, -50%) translateY(-10rpx) rotate(0deg); }
.petal-2 { transform: translate(-50%, -50%) translateX(-9.5rpx) translateY(-3rpx) rotate(72deg); }
.petal-3 { transform: translate(-50%, -50%) translateX(-5.9rpx) translateY(8.1rpx) rotate(144deg); }
.petal-4 { transform: translate(-50%, -50%) translateX(5.9rpx) translateY(8.1rpx) rotate(216deg); }
.petal-5 { transform: translate(-50%, -50%) translateX(9.5rpx) translateY(-3rpx) rotate(288deg); }

/* 花朵位置 - 心形分布 */
.flower-1 { bottom: 185rpx; left: calc(50% - 72rpx); animation-delay: 0s, 1.2s; }
.flower-2 { bottom: 205rpx; left: calc(50% - 32rpx); animation-delay: 0.4s, 1.8s; }
.flower-3 { bottom: 215rpx; left: 50%; animation-delay: 0.8s, 2.4s; }
.flower-4 { bottom: 205rpx; left: calc(50% + 32rpx); animation-delay: 1.2s, 3s; }
.flower-5 { bottom: 185rpx; left: calc(50% + 72rpx); animation-delay: 1.6s, 3.6s; }
.flower-6 { bottom: 155rpx; left: calc(50% - 52rpx); animation-delay: 2s, 4.2s; }
.flower-7 { bottom: 155rpx; left: calc(50% + 52rpx); animation-delay: 2.4s, 4.8s; }
.flower-8 { bottom: 125rpx; left: 50%; animation-delay: 2.8s, 5.4s; }

/* 花朵呼吸动画 */
@keyframes flowerBreath {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.flower-1, .flower-3, .flower-5, .flower-7 {
  animation: flowerBloom 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards,
             flowerSparkle 8s ease-in-out infinite,
             flowerBreath 6s ease-in-out infinite;
}

/* 盆栽说明 */
.plant-description {
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: rgba(242, 230, 223, 0.5);
  border-radius: var(--radius-lg);
  text-align: center;
}

.plant-desc-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.plant-progress {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.progress-bar {
  flex: 1;
  height: 10rpx;
  background: rgba(242, 230, 223, 0.8);
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg,
    var(--color-primary) 0%,
    var(--color-primary-dark) 100%);
  border-radius: 5rpx;
  transition: width 0.8s var(--ease-smooth);
}

.progress-text {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  font-weight: 600;
  white-space: nowrap;
}

/* ==================== v2.1 视觉精修：每阶段动效增强 ==================== */

/* 阶段1：种子能量光环 - 模拟生命萌动的呼吸光晕 */
.plant-stage-1 .seed::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background: radial-gradient(circle,
    rgba(245, 198, 203, 0.5) 0%,
    rgba(212, 184, 165, 0.3) 35%,
    rgba(196, 212, 181, 0.1) 65%,
    transparent 80%);
  border-radius: 50%;
  filter: blur(10rpx);
  z-index: -1;
  animation: seedAura 5s ease-in-out infinite;
  pointer-events: none;
}

@keyframes seedAura {
  0%, 100% {
    opacity: 0.4;
    transform: translate(-50%, -50%) scale(0.85);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.5);
  }
}

/* 阶段2：嫩芽尖端露珠光点 - 像清晨的晨露 */
.plant-stage-2 .sprout-1::after,
.plant-stage-2 .sprout-2::after,
.plant-stage-2 .sprout-3::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translate(-50%, -30%);
  width: 12rpx;
  height: 12rpx;
  background: radial-gradient(circle,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(196, 212, 181, 0.5) 50%,
    transparent 100%);
  border-radius: 50%;
  box-shadow:
    0 0 8rpx rgba(255, 255, 255, 0.8),
    0 0 16rpx rgba(196, 212, 181, 0.4);
  animation: dewSparkle 3.2s ease-in-out infinite;
  pointer-events: none;
}

.plant-stage-2 .sprout-1::after {
  animation-delay: 0s;
}
.plant-stage-2 .sprout-2::after {
  animation-delay: 0.6s;
}
.plant-stage-2 .sprout-3::after {
  animation-delay: 1.2s;
}

@keyframes dewSparkle {
  0%, 100% {
    opacity: 0;
    transform: translate(-50%, -30%) scale(0.5);
  }
  20% {
    opacity: 1;
    transform: translate(-50%, -40%) scale(1.2);
  }
  60% {
    opacity: 0.8;
    transform: translate(-50%, -30%) scale(1);
  }
}

/* 阶段3 & 4：心形整体光晕 - 心脏脉动般的呼吸 */
.plant-stage-3,
.plant-stage-4 {
  position: relative;
}

.plant-stage-3::before,
.plant-stage-4::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 320rpx;
  height: 300rpx;
  background: radial-gradient(ellipse at center,
    rgba(245, 198, 203, 0.25) 0%,
    rgba(196, 212, 181, 0.15) 40%,
    rgba(212, 184, 165, 0.08) 70%,
    transparent 100%);
  border-radius: 50%;
  filter: blur(20rpx);
  z-index: -1;
  animation: heartGlow 4s ease-in-out infinite;
  pointer-events: none;
}

.plant-stage-4::before {
  width: 360rpx;
  height: 340rpx;
  background: radial-gradient(ellipse at center,
    rgba(245, 198, 203, 0.35) 0%,
    rgba(196, 212, 181, 0.2) 40%,
    rgba(212, 184, 165, 0.1) 70%,
    transparent 100%);
  animation-duration: 3.2s;
}

@keyframes heartGlow {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(0.92);
  }
  30% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.05);
  }
  50% {
    opacity: 0.7;
    transform: translate(-50%, -50%) scale(0.95);
  }
  70% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.05);
  }
}

/* 阶段5：花朵阶段花粉粒子飘浮 - 治愈完成的礼赞 */
.plant-stage-5 {
  position: relative;
}

.plant-stage-5::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(255, 215, 130, 0.8) 0%, transparent 1.5%),
    radial-gradient(circle at 75% 20%, rgba(255, 215, 130, 0.6) 0%, transparent 1%),
    radial-gradient(circle at 50% 50%, rgba(255, 215, 130, 0.7) 0%, transparent 1.2%),
    radial-gradient(circle at 30% 75%, rgba(255, 215, 130, 0.65) 0%, transparent 1%),
    radial-gradient(circle at 85% 65%, rgba(255, 215, 130, 0.75) 0%, transparent 1.3%),
    radial-gradient(circle at 60% 85%, rgba(255, 215, 130, 0.6) 0%, transparent 1%),
    radial-gradient(circle at 15% 55%, rgba(255, 215, 130, 0.55) 0%, transparent 0.9%),
    radial-gradient(circle at 90% 40%, rgba(255, 215, 130, 0.7) 0%, transparent 1.1%);
  filter: blur(0.5rpx);
  z-index: -1;
  animation: pollenFloat 9s ease-in-out infinite;
  pointer-events: none;
}

.plant-stage-5::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 380rpx;
  height: 360rpx;
  background: radial-gradient(ellipse at center,
    rgba(255, 215, 130, 0.2) 0%,
    rgba(245, 198, 203, 0.18) 35%,
    rgba(196, 212, 181, 0.1) 65%,
    transparent 100%);
  border-radius: 50%;
  filter: blur(24rpx);
  z-index: -2;
  animation: bloomAura 5s ease-in-out infinite;
  pointer-events: none;
}

@keyframes pollenFloat {
  0%, 100% {
    transform: translate(0, 0) rotate(0deg);
    opacity: 0.6;
  }
  25% {
    transform: translate(-8rpx, -12rpx) rotate(2deg);
    opacity: 1;
  }
  50% {
    transform: translate(6rpx, -16rpx) rotate(-1deg);
    opacity: 0.8;
  }
  75% {
    transform: translate(-4rpx, -8rpx) rotate(1deg);
    opacity: 0.9;
  }
}

@keyframes bloomAura {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(0.95);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }
}
