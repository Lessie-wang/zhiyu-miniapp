/* 陪伴者管理页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(to bottom, #FAF9F7 0%, #F2E6DF 100%);
  padding: 40rpx 40rpx 160rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.6;
}

/* 添加陪伴者卡片 */
.add-companion-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.add-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.add-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #6D6A65;
}

.add-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

.add-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.25);
}

.add-btn::after {
  border: none;
}

.add-btn .btn-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}

/* 陪伴者列表 */
.companions-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 24rpx;
}

.companion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.companion-card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.companion-avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: white;
  font-weight: 700;
}

.companion-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.companion-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
}

.companion-relation {
  font-size: 24rpx;
  color: #B8B2A7;
}

.companion-status {
  font-size: 24rpx;
  color: #B8B2A7;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
}

.status-dot.active {
  background: #7BC96F;
}

.status-dot.pending {
  background: #F5A623;
}

.companion-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: #F2E6DF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 28rpx;
}

.remove-btn:active {
  background: #FFE5E5;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
}

.empty-desc {
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.6;
  max-width: 500rpx;
}

/* 权限设置说明 */
.permission-info-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.info-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 24rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-icon {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-text {
  flex: 1;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.6;
}

/* 功能介绍 */
.features-section {
  margin-bottom: 40rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.feature-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}
