/* 知识库页面样式 - 整合情绪库的深度知识系统 */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF9F7 0%, #F5EDE6 100%);
  padding-bottom: 120rpx;
}

/* ==================== 顶部导航栏 ==================== */
.top-nav {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.1);
  padding: 16rpx 0;
}

.nav-scroll {
  width: 100%;
  white-space: nowrap;
}

.nav-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 32rpx;
}

.nav-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: rgba(245, 198, 203, 0.1);
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.nav-tab.active {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.3);
}

.nav-icon {
  font-size: 28rpx;
}

.nav-name {
  font-size: 26rpx;
  color: #6D6A65;
  font-weight: 600;
  white-space: nowrap;
}

.nav-tab.active .nav-name {
  color: white;
}

/* ==================== 搜索栏 ==================== */
.search-bar {
  padding: 24rpx 32rpx;
  position: relative;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: white;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.12);
}

.search-icon {
  font-size: 32rpx;
  color: #B8B2A7;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #6D6A65;
}

.clear-icon {
  font-size: 28rpx;
  color: #B8B2A7;
  padding: 8rpx;
}

/* 搜索建议 */
.search-suggestions {
  position: absolute;
  top: 100rpx;
  left: 32rpx;
  right: 32rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(212, 184, 165, 0.2);
  overflow: hidden;
  z-index: 10;
}

.suggestion-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.1);
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-icon {
  font-size: 24rpx;
  color: #B8B2A7;
}

.suggestion-text {
  font-size: 26rpx;
  color: #6D6A65;
}

/* ==================== 用户学习统计卡片 ==================== */
.stats-card {
  margin: 0 32rpx 32rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, rgba(245, 198, 203, 0.15) 0%, rgba(212, 184, 165, 0.15) 100%);
  border-radius: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

.stats-left {
  display: flex;
  gap: 40rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #D4B8A5;
}

.stat-label {
  font-size: 22rpx;
  color: #8B7B6F;
}

.stats-right {
  display: flex;
  align-items: center;
}

.stats-arrow {
  font-size: 40rpx;
  color: #D4B8A5;
  font-weight: 700;
}

/* ==================== 区域标题 ==================== */
.section {
  margin-bottom: 48rpx;
}

.section-header {
  padding: 0 32rpx 24rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-top: 4rpx;
}

.section-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.section-subtitle {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

/* ==================== 情绪筛选器 ==================== */
.emotion-filter {
  padding: 0 32rpx 24rpx;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: white;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #6D6A65;
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.1);
  transition: all 0.3s ease;
}

.filter-item.active {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.3);
}

/* ==================== 文章列表 ==================== */
.article-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx;
}

/* ==================== 文章卡片 ==================== */
.article-card {
  position: relative;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  transition: all 0.3s ease;
}

.article-card:active {
  transform: scale(0.98);
}

/* 付费标签 */
.premium-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 215, 0, 0.4);
  z-index: 2;
}

.badge-icon {
  font-size: 20rpx;
}

.badge-text {
  font-size: 22rpx;
  color: white;
  font-weight: 700;
}

/* 情绪标签 */
.emotion-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 16rpx;
  background: rgba(196, 181, 216, 0.9);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: white;
  font-weight: 600;
  z-index: 2;
}

/* 封面图 */
.article-cover {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
}

/* 文章内容 */
.article-content {
  padding: 28rpx;
}

/* 难度标签 */
.level-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.level-basic {
  background: rgba(196, 212, 181, 0.2);
  color: #8BA876;
}

.level-intermediate {
  background: rgba(212, 184, 165, 0.2);
  color: #C4A893;
}

.level-advanced {
  background: rgba(196, 181, 216, 0.2);
  color: #9B88B8;
}

/* 文章标题 */
.article-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.article-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.article-summary {
  display: block;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.6;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

/* ==================== 作者信息 ==================== */
.author-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: rgba(245, 198, 203, 0.05);
  border-radius: 16rpx;
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
}

.author-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.author-name-wrapper {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.author-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #6D6A65;
}

.verified-icon {
  width: 28rpx;
  height: 28rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: white;
  font-weight: 700;
}

.author-title {
  font-size: 22rpx;
  color: #B8B2A7;
  line-height: 1.4;
}

.author-credentials {
  font-size: 20rpx;
  color: #C4A893;
  margin-top: 4rpx;
}

/* ==================== 目录预览 ==================== */
.toc-preview {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: rgba(212, 184, 165, 0.05);
  border-radius: 16rpx;
  border-left: 4rpx solid #D4B8A5;
}

.toc-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.toc-items {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.toc-item {
  font-size: 22rpx;
  color: #8B7B6F;
  line-height: 1.5;
  padding-left: 16rpx;
  position: relative;
}

.toc-item::before {
  content: '•';
  position: absolute;
  left: 0;
  color: #D4B8A5;
}

.toc-more {
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
  padding-left: 16rpx;
}

/* ==================== 标签 ==================== */
.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 16rpx;
  background: rgba(212, 184, 165, 0.1);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #C4A893;
  font-weight: 500;
}

/* ==================== 文章底部 ==================== */
.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(212, 184, 165, 0.1);
}

.footer-left {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.read-time,
.likes,
.collections,
.purchase-count,
.rating {
  font-size: 24rpx;
  color: #B8B2A7;
}

.footer-right {
  display: flex;
  align-items: center;
}

.collect-btn {
  padding: 8rpx;
}

.collect-icon {
  font-size: 32rpx;
  color: #D4B8A5;
}

/* 进阶版本提示 */
.upgrade-hint {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 165, 0, 0.2) 100%);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.upgrade-icon {
  font-size: 20rpx;
}

.upgrade-text {
  font-size: 22rpx;
  color: #FFA500;
  font-weight: 600;
}

/* ==================== 付费内容预览弹窗 ==================== */
.premium-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
}

.modal-content {
  position: relative;
  width: 640rpx;
  max-height: 80vh;
  background: white;
  border-radius: 32rpx;
  overflow: hidden;
  animation: modalSlideUp 0.3s ease;
}

@keyframes modalSlideUp {
  0% {
    opacity: 0;
    transform: translateY(100rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #B8B2A7;
  border-radius: 50%;
  background: rgba(212, 184, 165, 0.1);
}

.modal-body {
  padding: 32rpx;
  max-height: calc(80vh - 120rpx);
  overflow-y: auto;
}

.premium-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.premium-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.premium-author {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding: 20rpx;
  background: rgba(245, 198, 203, 0.05);
  border-radius: 16rpx;
}

/* 价值点 */
.value-points {
  margin-bottom: 32rpx;
}

.value-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 16rpx;
}

.value-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.value-icon {
  width: 32rpx;
  height: 32rpx;
  background: #4CAF50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
}

.value-text {
  flex: 1;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.5;
}

/* 价格 */
.premium-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.1) 0%, rgba(255, 165, 0, 0.1) 100%);
  border-radius: 16rpx;
}

.price-label {
  font-size: 24rpx;
  color: #FFA500;
  font-weight: 600;
}

.price-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B00;
}

/* 购买按钮 */
.purchase-btn {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 50rpx;
  font-size: 30rpx;
  color: white;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 165, 0, 0.4);
  border: none;
}

.purchase-btn::after {
  border: none;
}

.preview-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-top: 16rpx;
}
