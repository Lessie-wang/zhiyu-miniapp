/* 陪的时间 - 经期情绪监测页面 - 高级质感版 */

page {
  background:
    radial-gradient(circle at 50% 20%, rgba(255, 192, 203, 0.15) 0%, transparent 40%),
    radial-gradient(circle at 80% 80%, rgba(245, 198, 203, 0.12) 0%, transparent 35%),
    radial-gradient(circle at 20% 60%, rgba(255, 220, 220, 0.1) 0%, transparent 30%),
    linear-gradient(180deg, #FFF5F7 0%, #FAF9F7 100%);
}

.container {
  min-height: 100vh;
  padding: 0 32rpx 160rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(245, 198, 203, 0.15);
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  letter-spacing: 1rpx;
}

/* 经期状态卡片 - 高级透明质感 */
.period-status-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.7) 0%,
    rgba(255, 253, 248, 0.6) 100%
  );
  backdrop-filter: blur(40rpx) saturate(200%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 12rpx 48rpx rgba(245, 198, 203, 0.18),
    0 4rpx 16rpx rgba(245, 198, 203, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.75);
  border: 2rpx solid rgba(255, 192, 203, 0.35);
}

.status-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.status-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FFB6C1 0%, #FFC0CB 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 193, 0.3);
}

.moon-icon {
  font-size: 40rpx;
}

.status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.status-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.status-desc {
  font-size: 24rpx;
  color: #B8B2A7;
}

/* 倒计时区域 */
.countdown-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.15);
}

.countdown-circle {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, rgba(255, 182, 193, 0.2) 0%, rgba(255, 192, 203, 0.15) 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  border: 3rpx solid rgba(255, 182, 193, 0.3);
}

.countdown-number {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFB6C1;
  line-height: 1;
}

.countdown-unit {
  font-size: 24rpx;
  color: #B8B2A7;
  margin-top: 4rpx;
}

.countdown-label {
  font-size: 26rpx;
  color: #8B7B6F;
}

/* 经期信息行 */
.period-info-row {
  display: flex;
  gap: 16rpx;
}

.info-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: rgba(245, 198, 203, 0.08);
  border-radius: 16rpx;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-bottom: 8rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

/* 日历区域 - 高级透明质感 */
.calendar-section {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.7) 0%,
    rgba(255, 253, 248, 0.6) 100%
  );
  backdrop-filter: blur(40rpx) saturate(200%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 12rpx 48rpx rgba(212, 184, 165, 0.15),
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.75);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.month-nav {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(212, 184, 165, 0.1);
  transition: all 0.3s ease;
}

.month-nav:active {
  background: rgba(212, 184, 165, 0.2);
  transform: scale(0.95);
}

.nav-arrow {
  font-size: 32rpx;
  color: #8B7B6F;
  font-weight: 700;
}

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #B8B2A7;
  padding: 8rpx 0;
}

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
  transition: all 0.3s ease;
}

.day-cell.today {
  background: rgba(212, 184, 165, 0.15);
  border: 2rpx solid #D4B8A5;
}

.day-cell.period-day {
  background: linear-gradient(135deg, rgba(255, 182, 193, 0.3) 0%, rgba(255, 192, 203, 0.25) 100%);
  border: 2rpx solid rgba(255, 182, 193, 0.5);
}

.day-cell.other-month {
  opacity: 0.3;
}

.day-number {
  font-size: 26rpx;
  color: #6D6A65;
  font-weight: 500;
}

.day-indicator {
  position: absolute;
  bottom: 4rpx;
  display: flex;
  gap: 2rpx;
}

.emotion-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
}

/* 情绪分析区域 - 高级透明质感 */
.emotion-analysis-section {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 253, 248, 0.58) 100%
  );
  backdrop-filter: blur(40rpx) saturate(200%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 12rpx 48rpx rgba(212, 184, 165, 0.15),
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.73);
  border: 2rpx solid rgba(255, 255, 255, 0.52);
}

.section-header {
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.section-subtitle {
  font-size: 24rpx;
  color: #B8B2A7;
}

.section-action {
  font-size: 26rpx;
  color: #F5C6CB;
  font-weight: 600;
}

.chart-legend {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
  justify-content: center;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.period {
  background: #FFB6C1;
}

.legend-dot.pre-period {
  background: #FFC0CB;
}

.legend-dot.normal {
  background: #D4B8A5;
}

.legend-text {
  font-size: 22rpx;
  color: #8B7B6F;
}

.emotion-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.emotion-bar-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.emotion-name {
  width: 80rpx;
  font-size: 24rpx;
  color: #6D6A65;
  flex-shrink: 0;
}

.bar-container {
  flex: 1;
  height: 24rpx;
  background: rgba(212, 184, 165, 0.1);
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.bar-fill.period {
  background: linear-gradient(90deg, #FFB6C1 0%, #FF9AA2 100%);
}

.bar-fill.pre-period {
  background: linear-gradient(90deg, #FFC0CB 0%, #FFB6C1 100%);
}

.bar-fill.normal {
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
}

.emotion-count {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: #B8B2A7;
  flex-shrink: 0;
}

/* 症状记录区域 - 高级透明质感 */
.symptoms-section {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 253, 248, 0.58) 100%
  );
  backdrop-filter: blur(40rpx) saturate(200%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 12rpx 48rpx rgba(212, 184, 165, 0.15),
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.73);
  border: 2rpx solid rgba(255, 255, 255, 0.52);
}

.symptoms-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.symptom-tag {
  padding: 20rpx 16rpx;
  background: rgba(245, 198, 203, 0.08);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.symptom-tag.selected {
  background: rgba(255, 182, 193, 0.2);
  border-color: #FFB6C1;
}

.symptom-icon {
  font-size: 32rpx;
}

.symptom-name {
  font-size: 22rpx;
  color: #6D6A65;
}

/* 健康建议区域 - 高级透明质感 */
.tips-section {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.68) 0%,
    rgba(255, 253, 248, 0.58) 100%
  );
  backdrop-filter: blur(40rpx) saturate(200%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 12rpx 48rpx rgba(212, 184, 165, 0.15),
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.73);
  border: 2rpx solid rgba(255, 255, 255, 0.52);
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tip-icon {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #C4D4B5 0%, #A8C090 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.tip-text {
  flex: 1;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.6;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(212, 184, 165, 0.15);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FFB6C1 0%, #FFC0CB 100%);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 182, 193, 0.4);
}

.action-btn.secondary {
  background: rgba(212, 184, 165, 0.15);
  color: #6D6A65;
}

.action-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* ==================== 知愈风格输入弹窗（单行） ==================== */

.zh-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  animation: fadeIn 0.3s ease;
}

.modal-content {
  position: relative;
  width: 640rpx;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(250, 249, 247, 0.98) 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.15),
    0 8rpx 24rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.modal-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(212, 184, 165, 0.15);
}

.modal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.modal-subtitle {
  display: block;
  font-size: 26rpx;
  color: #9B9892;
  line-height: 1.5;
}

.input-paper {
  position: relative;
  background: linear-gradient(to bottom,
    #FFFEF9 0%,
    #FFFCF5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(212, 184, 165, 0.2);
}

.zh-input {
  width: 100%;
  font-size: 32rpx;
  line-height: 1.5;
  color: #6D6A65;
  background: transparent;
  border: none;
  padding: 0;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 32rpx;
  font-size: 24rpx;
  color: #B8B2A7;
  font-weight: 500;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
}

.modal-button-cancel {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 243, 238, 0.9) 100%);
  color: #9B9892;
  border: 2rpx solid rgba(212, 184, 165, 0.3);
}

.modal-button-cancel:active {
  transform: scale(0.96);
  background: rgba(248, 243, 238, 0.95);
}

.modal-button-confirm {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: #FFFFFF;
  box-shadow:
    0 8rpx 24rpx rgba(212, 184, 165, 0.35),
    0 2rpx 8rpx rgba(212, 184, 165, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.modal-button-confirm:active {
  transform: scale(0.96);
  box-shadow:
    0 4rpx 12rpx rgba(212, 184, 165, 0.3),
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
