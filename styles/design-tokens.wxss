/**
 * 知愈小程序 - 设计Token系统 v3.0
 *
 * 这是整个小程序的设计基础，定义了所有可复用的设计变量
 * 所有页面和组件都应该引用这些Token，而不是硬编码值
 *
 * 创建时间: 2026-04-29
 * 版本: v3.0
 */

/* ==================== 色彩系统 ==================== */

/* 主色调 - Morandi色系 */
page {
  --color-primary: #D4B8A5;
  --color-primary-light: #E8C4A8;
  --color-primary-dark: #C4A893;
  --color-primary-darker: #B49880;

  /* 辅助色 */
  --color-accent: #E8C4A8;
  --color-accent-light: #F2D4B8;
  --color-accent-dark: #D8B498;

  /* 背景色 */
  --color-bg-primary: #FAF9F7;
  --color-bg-secondary: #F2E6DF;
  --color-bg-tertiary: #EBE0D8;
  --color-bg-card: rgba(255, 255, 255, 0.85);
  --color-bg-overlay: rgba(250, 249, 247, 0.95);

  /* 文字颜色 */
  --color-text-primary: #6D6A65;
  --color-text-secondary: #8C8780;
  --color-text-tertiary: #B8B2A7;
  --color-text-quaternary: #D4CFC4;
  --color-text-inverse: #FFFFFF;

  /* 边框颜色 */
  --color-border-light: rgba(212, 184, 165, 0.15);
  --color-border-medium: rgba(212, 184, 165, 0.25);
  --color-border-strong: rgba(212, 184, 165, 0.4);

  /* 状态颜色 */
  --color-success: #A8D4B8;
  --color-warning: #E8D4A8;
  --color-error: #E8B8A8;
  --color-info: #A8C4D4;

  /* 情绪色彩 - 24种情绪 */
  --emotion-happy: #FFE5B4;
  --emotion-happy-light: #FFF5E1;
  --emotion-calm: #B8D4E8;
  --emotion-calm-light: #D8E8F4;
  --emotion-sad: #A8B8C8;
  --emotion-sad-light: #C8D4E0;
  --emotion-tired: #C8C4B8;
  --emotion-tired-light: #E0DCD4;
  --emotion-irritated: #E8C4A8;
  --emotion-irritated-light: #F4D8C4;
  --emotion-anxious: #D4B8C8;
  --emotion-anxious-light: #E8D4DC;
  --emotion-angry: #E8A8A8;
  --emotion-angry-light: #F4C4C4;
  --emotion-touched: #F4D4E8;
  --emotion-touched-light: #FAE8F4;
  --emotion-confused: #C8B8D4;
  --emotion-confused-light: #DCD4E8;
  --emotion-bored: #B8C4B8;
  --emotion-bored-light: #D4DCD4;
  --emotion-shocked: #E8D4B8;
  --emotion-shocked-light: #F4E8D4;
  --emotion-unknown: #C8C8C8;
  --emotion-unknown-light: #E0E0E0;
}

/* ==================== 字体系统 ==================== */

page {
  /* 字体族 */
  --font-family-base: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --font-family-display: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  --font-family-mono: "SF Mono", Monaco, Consolas, "Liberation Mono", "Courier New", monospace;

  /* 字体大小 */
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 32rpx;
  --font-size-lg: 36rpx;
  --font-size-xl: 40rpx;
  --font-size-2xl: 48rpx;
  --font-size-3xl: 56rpx;
  --font-size-4xl: 64rpx;
  --font-size-5xl: 72rpx;
  --font-size-6xl: 96rpx;

  /* 字重 */
  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  /* 行高 */
  --line-height-tight: 1.2;
  --line-height-snug: 1.4;
  --line-height-normal: 1.6;
  --line-height-relaxed: 1.8;
  --line-height-loose: 2.0;

  /* 字间距 */
  --letter-spacing-tight: -0.02em;
  --letter-spacing-normal: 0;
  --letter-spacing-wide: 0.02em;
  --letter-spacing-wider: 0.05em;
}

/* ==================== 间距系统 ==================== */

page {
  /* 基础间距 - 8px网格系统 */
  --spacing-0: 0;
  --spacing-1: 4rpx;
  --spacing-2: 8rpx;
  --spacing-3: 12rpx;
  --spacing-4: 16rpx;
  --spacing-5: 20rpx;
  --spacing-6: 24rpx;
  --spacing-7: 28rpx;
  --spacing-8: 32rpx;
  --spacing-10: 40rpx;
  --spacing-12: 48rpx;
  --spacing-14: 56rpx;
  --spacing-16: 64rpx;
  --spacing-20: 80rpx;
  --spacing-24: 96rpx;
  --spacing-28: 112rpx;
  --spacing-32: 128rpx;

  /* 语义化间距 */
  --spacing-xs: var(--spacing-2);
  --spacing-sm: var(--spacing-3);
  --spacing-md: var(--spacing-4);
  --spacing-lg: var(--spacing-6);
  --spacing-xl: var(--spacing-8);
  --spacing-2xl: var(--spacing-10);
  --spacing-3xl: var(--spacing-12);
  --spacing-4xl: var(--spacing-16);
}

/* ==================== 圆角系统 ==================== */

page {
  --radius-none: 0;
  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-xl: 48rpx;
  --radius-2xl: 64rpx;
  --radius-3xl: 96rpx;
  --radius-full: 50%;
  --radius-round: 9999rpx;
}

/* ==================== 阴影系统 ==================== */

page {
  /* 基础阴影 */
  --shadow-xs: 0 2rpx 4rpx rgba(212, 184, 165, 0.06);
  --shadow-sm: 0 2rpx 8rpx rgba(212, 184, 165, 0.08);
  --shadow-md: 0 4rpx 16rpx rgba(212, 184, 165, 0.12);
  --shadow-lg: 0 8rpx 32rpx rgba(212, 184, 165, 0.16);
  --shadow-xl: 0 16rpx 48rpx rgba(212, 184, 165, 0.2);
  --shadow-2xl: 0 24rpx 64rpx rgba(212, 184, 165, 0.24);

  /* 内阴影 */
  --shadow-inner: inset 0 2rpx 8rpx rgba(212, 184, 165, 0.08);
  --shadow-inner-lg: inset 0 4rpx 16rpx rgba(212, 184, 165, 0.12);

  /* 光晕效果 */
  --glow-sm: 0 0 16rpx rgba(212, 184, 165, 0.3);
  --glow-md: 0 0 32rpx rgba(212, 184, 165, 0.4);
  --glow-lg: 0 0 48rpx rgba(212, 184, 165, 0.5);

  /* 双层阴影（更立体） */
  --shadow-double-sm:
    0 2rpx 8rpx rgba(212, 184, 165, 0.08),
    0 8rpx 24rpx rgba(212, 184, 165, 0.06);
  --shadow-double-md:
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    0 12rpx 32rpx rgba(212, 184, 165, 0.08);
  --shadow-double-lg:
    0 8rpx 32rpx rgba(212, 184, 165, 0.16),
    0 16rpx 48rpx rgba(212, 184, 165, 0.12);
}

/* ==================== 尺寸系统 ==================== */

page {
  /* 图标尺寸 */
  --icon-xs: 32rpx;
  --icon-sm: 40rpx;
  --icon-md: 48rpx;
  --icon-lg: 64rpx;
  --icon-xl: 80rpx;
  --icon-2xl: 96rpx;
  --icon-3xl: 128rpx;

  /* 按钮尺寸 */
  --button-height-sm: 64rpx;
  --button-height-md: 80rpx;
  --button-height-lg: 96rpx;
  --button-height-xl: 112rpx;

  /* 输入框尺寸 */
  --input-height-sm: 64rpx;
  --input-height-md: 80rpx;
  --input-height-lg: 96rpx;

  /* 卡片尺寸 */
  --card-padding-sm: var(--spacing-4);
  --card-padding-md: var(--spacing-6);
  --card-padding-lg: var(--spacing-8);
  --card-padding-xl: var(--spacing-10);
}

/* ==================== 过渡系统 ==================== */

page {
  /* 过渡时间 */
  --transition-faster: 0.1s;
  --transition-fast: 0.2s;
  --transition-base: 0.3s;
  --transition-slow: 0.5s;
  --transition-slower: 0.8s;

  /* 缓动函数 */
  --ease-linear: linear;
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-out: cubic-bezier(0, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-spring: cubic-bezier(0.68, -0.55, 0.265, 1.55);

  /* 组合过渡 */
  --transition-all: all var(--transition-base) var(--ease-smooth);
  --transition-transform: transform var(--transition-base) var(--ease-smooth);
  --transition-opacity: opacity var(--transition-base) var(--ease-smooth);
  --transition-colors: background-color var(--transition-base) var(--ease-smooth),
                       color var(--transition-base) var(--ease-smooth),
                       border-color var(--transition-base) var(--ease-smooth);
}

/* ==================== Z-index系统 ==================== */

page {
  --z-base: 0;
  --z-dropdown: 100;
  --z-sticky: 200;
  --z-fixed: 300;
  --z-modal-backdrop: 400;
  --z-modal: 500;
  --z-popover: 600;
  --z-tooltip: 700;
  --z-notification: 800;
  --z-max: 999;
}

/* ==================== 模糊效果 ==================== */

page {
  --blur-none: 0;
  --blur-sm: 8rpx;
  --blur-md: 16rpx;
  --blur-lg: 24rpx;
  --blur-xl: 32rpx;
  --blur-2xl: 48rpx;
  --blur-3xl: 64rpx;
}

/* ==================== 透明度系统 ==================== */

page {
  --opacity-0: 0;
  --opacity-5: 0.05;
  --opacity-10: 0.1;
  --opacity-20: 0.2;
  --opacity-30: 0.3;
  --opacity-40: 0.4;
  --opacity-50: 0.5;
  --opacity-60: 0.6;
  --opacity-70: 0.7;
  --opacity-80: 0.8;
  --opacity-90: 0.9;
  --opacity-95: 0.95;
  --opacity-100: 1;
}

/* ==================== 渐变系统 ==================== */

page {
  /* 背景渐变 */
  --gradient-primary: linear-gradient(135deg, #FAF9F7 0%, #F2E6DF 100%);
  --gradient-secondary: linear-gradient(135deg, #F2E6DF 0%, #EBE0D8 100%);
  --gradient-accent: linear-gradient(135deg, #E8C4A8 0%, #D4B8A5 100%);

  /* 径向渐变 */
  --gradient-radial-primary: radial-gradient(circle at 30% 20%, rgba(232, 196, 168, 0.15) 0%, transparent 60%);
  --gradient-radial-secondary: radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.12) 0%, transparent 60%);

  /* 光晕渐变 */
  --gradient-glow: radial-gradient(circle, rgba(232, 196, 168, 0.4) 0%, transparent 70%);

  /* 遮罩渐变 */
  --gradient-mask-top: linear-gradient(to bottom, rgba(0,0,0,0.8) 0%, transparent 100%);
  --gradient-mask-bottom: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%);
}

/* ==================== 毛玻璃效果 ==================== */

page {
  --glass-light: rgba(255, 255, 255, 0.7);
  --glass-medium: rgba(255, 255, 255, 0.5);
  --glass-strong: rgba(255, 255, 255, 0.3);

  /* 毛玻璃组合效果 */
  --glass-effect-light:
    background: var(--glass-light);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));

  --glass-effect-medium:
    background: var(--glass-medium);
    backdrop-filter: blur(var(--blur-lg));
    -webkit-backdrop-filter: blur(var(--blur-lg));

  --glass-effect-strong:
    background: var(--glass-strong);
    backdrop-filter: blur(var(--blur-xl));
    -webkit-backdrop-filter: blur(var(--blur-xl));
}

/* ==================== 断点系统（响应式） ==================== */

page {
  --breakpoint-xs: 320px;
  --breakpoint-sm: 375px;
  --breakpoint-md: 414px;
  --breakpoint-lg: 768px;
  --breakpoint-xl: 1024px;
}

/* ==================== 安全区域 ==================== */

page {
  --safe-area-inset-top: env(safe-area-inset-top);
  --safe-area-inset-right: env(safe-area-inset-right);
  --safe-area-inset-bottom: env(safe-area-inset-bottom);
  --safe-area-inset-left: env(safe-area-inset-left);
}
