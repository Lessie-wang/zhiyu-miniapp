/**
 * 知愈小程序 - 统一卡片样式系统 v1.0
 *
 * 目标：确保所有页面的卡片、背景、透明度、阴影完全统一
 * 使用方法：在页面WXSS中 @import '/styles/unified-cards.wxss';
 *
 * 创建时间: 2026-05-07
 */

/* ==================== 统一背景系统 ==================== */

/* 标准页面背景 - 3层径向渐变 */
.zhiyu-bg-standard {
  background:
    radial-gradient(circle at 30% 20%, rgba(245, 198, 203, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at top left, #FAF9F7 0%, #F5F0EB 40%, #F2E6DF 100%);
}

/* 温暖背景 - 粉色调 */
.zhiyu-bg-warm {
  background:
    radial-gradient(circle at 50% 20%, rgba(245, 198, 203, 0.2) 0%, transparent 40%),
    radial-gradient(circle at 30% 80%, rgba(255, 220, 220, 0.15) 0%, transparent 35%),
    linear-gradient(180deg, #FFF0F0 0%, #FAF9F7 100%);
}

/* 清新背景 - 绿色调 */
.zhiyu-bg-fresh {
  background:
    radial-gradient(circle at 25% 35%, rgba(196, 212, 181, 0.12) 0%, transparent 45%),
    radial-gradient(circle at 75% 65%, rgba(196, 181, 216, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 50% 85%, rgba(245, 198, 203, 0.08) 0%, transparent 40%),
    linear-gradient(180deg, #FFE8E0 0%, #FAF9F7 50%, #F5E6D3 100%);
}

/* 知愈Logo水印 - 统一呼吸动画 */
.zhiyu-watermark::before {
  content: '知愈';
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 320rpx;
  font-weight: 700;
  font-family: 'STKaiti', 'KaiTi', serif;
  color: rgba(212, 184, 165, 0.05);
  letter-spacing: 32rpx;
  pointer-events: none;
  z-index: 0;
  animation: zhiyuWatermarkBreath 10s ease-in-out infinite;
}

@keyframes zhiyuWatermarkBreath {
  0%, 100% {
    opacity: 0.4;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(1.05);
  }
}

/* ==================== 统一卡片系统 ==================== */

/* 主卡片 - 高透明度 + 强模糊 */
.zhiyu-card-primary {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 253, 248, 0.65) 100%);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.zhiyu-card-primary:active {
  transform: scale(0.99);
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

/* 次级卡片 - 中等透明度 */
.zhiyu-card-secondary {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.85) 0%,
    rgba(248, 243, 238, 0.75) 100%);
  backdrop-filter: blur(30rpx) saturate(160%);
  -webkit-backdrop-filter: blur(30rpx) saturate(160%);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 浮动卡片 - 轻盈感 */
.zhiyu-card-float {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Hero卡片 - 最高级质感 */
.zhiyu-card-hero {
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 0.95) 0%,
    rgba(255, 250, 247, 0.92) 100%);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  animation: fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 内容卡片 - 信纸质感 */
.zhiyu-card-paper {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(180, 160, 140, 0.3);
  border-left: 6rpx solid #E8C4B8;
  font-family: 'STKaiti', 'KaiTi', '楷体', serif;
}

/* ==================== 统一按钮系统 ==================== */

/* 主按钮 - 渐变 */
.zhiyu-btn-primary {
  width: 100%;
  min-height: 88rpx;
  background: linear-gradient(135deg, #D6B19A 0%, #C79A83 100%);
  border-radius: 999rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(212, 184, 165, 0.24);
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.zhiyu-btn-primary::after {
  border: none;
}

.zhiyu-btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 16rpx rgba(212, 184, 165, 0.2);
}

/* 次级按钮 - 描边 */
.zhiyu-btn-secondary {
  width: 100%;
  min-height: 88rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 999rpx;
  color: #B28771;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border: 1.5rpx solid rgba(212, 184, 165, 0.42);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.zhiyu-btn-secondary::after {
  border: none;
}

.zhiyu-btn-secondary:active {
  background: rgba(255, 255, 255, 0.95);
  transform: scale(0.98);
}

/* 小按钮 */
.zhiyu-btn-small {
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: 48rpx;
}

/* ==================== 统一标题系统 ==================== */

/* 页面主标题 */
.zhiyu-title-page {
  font-size: 52rpx;
  font-weight: 700;
  color: #6D5D52;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(212, 184, 165, 0.2);
  text-align: center;
  margin-bottom: 16rpx;
}

/* 卡片标题 */
.zhiyu-title-card {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

/* 小标题 */
.zhiyu-title-small {
  font-size: 28rpx;
  font-weight: 600;
  color: #8C8780;
  margin-bottom: 8rpx;
}

/* 副标题 */
.zhiyu-subtitle {
  font-size: 28rpx;
  color: #B8B2A7;
  line-height: 1.6;
  text-align: center;
}

/* ==================== 统一标签系统 ==================== */

/* 标签 - 主色 */
.zhiyu-tag-primary {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(212, 184, 165, 0.16);
  color: #D4B8A5;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 标签 - 浅色 */
.zhiyu-tag-light {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(242, 230, 223, 0.6);
  color: #8C8780;
  font-size: 24rpx;
  font-weight: 500;
}

/* 标签 - 徽章 */
.zhiyu-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.2);
}

/* ==================== 统一输入框系统 ==================== */

/* 输入区域 */
.zhiyu-input-area {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 253, 248, 0.65) 100%);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4rpx 16rpx rgba(212, 184, 165, 0.1);
}

/* 输入框 */
.zhiyu-input {
  width: 100%;
  min-height: 80rpx;
  background: rgba(250, 249, 247, 0.8);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #6D6A65;
  border: 1rpx solid rgba(212, 184, 165, 0.2);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.zhiyu-input:focus {
  background: rgba(255, 255, 255, 0.95);
  border-color: rgba(212, 184, 165, 0.4);
  box-shadow: 0 0 0 4rpx rgba(212, 184, 165, 0.1);
}

/* ==================== 统一分隔线系统 ==================== */

/* 实线分隔 */
.zhiyu-divider-solid {
  height: 1rpx;
  background: rgba(212, 184, 165, 0.2);
  margin: 24rpx 0;
}

/* 虚线分隔 */
.zhiyu-divider-dashed {
  height: 1rpx;
  background: linear-gradient(to right,
    transparent,
    rgba(212, 184, 165, 0.3),
    transparent);
  margin: 28rpx 0;
}

/* 渐变分隔 */
.zhiyu-divider-gradient {
  height: 1rpx;
  background: linear-gradient(to right,
    transparent,
    #E0D5C8,
    transparent);
  margin: 28rpx 0;
}

/* ==================== 统一动画系统 ==================== */

/* 淡入 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.zhiyu-anim-fadeIn {
  animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 上滑淡入 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.zhiyu-anim-fadeInUp {
  animation: fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 缩放淡入 */
@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.zhiyu-anim-fadeInScale {
  animation: fadeInScale 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 呼吸动画 */
@keyframes breathe {
  0%, 100% {
    opacity: 0.8;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.02);
  }
}

.zhiyu-anim-breathe {
  animation: breathe 4s ease-in-out infinite;
}

/* 脉冲动画 */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.05);
  }
}

.zhiyu-anim-pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* ==================== 统一图标系统 ==================== */

/* 图标容器 */
.zhiyu-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.zhiyu-icon-xs { width: 32rpx; height: 32rpx; font-size: 32rpx; }
.zhiyu-icon-sm { width: 40rpx; height: 40rpx; font-size: 40rpx; }
.zhiyu-icon-md { width: 48rpx; height: 48rpx; font-size: 48rpx; }
.zhiyu-icon-lg { width: 64rpx; height: 64rpx; font-size: 64rpx; }
.zhiyu-icon-xl { width: 80rpx; height: 80rpx; font-size: 80rpx; }

/* ==================== 统一间距系统 ==================== */

/* 页面容器 */
.zhiyu-container {
  min-height: 100vh;
  padding: 0 32rpx 120rpx;
}

/* 内容区域 */
.zhiyu-section {
  margin-bottom: 28rpx;
}

/* 大间距 */
.zhiyu-section-lg {
  margin-bottom: 48rpx;
}

/* ==================== 统一文本样式 ==================== */

/* 主文本 */
.zhiyu-text-primary {
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.7;
}

/* 次要文本 */
.zhiyu-text-secondary {
  font-size: 24rpx;
  color: #8C8780;
  line-height: 1.6;
}

/* 提示文本 */
.zhiyu-text-tertiary {
  font-size: 22rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

/* 强调文本 */
.zhiyu-text-emphasis {
  font-weight: 600;
  color: #D4B8A5;
}

/* ==================== 统一状态样式 ==================== */

/* 加载中 */
.zhiyu-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
  color: #B8B2A7;
  font-size: 28rpx;
}

/* 空状态 */
.zhiyu-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: #B8B2A7;
  font-size: 28rpx;
}

.zhiyu-empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

/* ==================== 统一遮罩系统 ==================== */

/* 模态遮罩 */
.zhiyu-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4rpx);
  -webkit-backdrop-filter: blur(4rpx);
  z-index: 1000;
  animation: fadeIn 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 弹窗容器 */
.zhiyu-modal-content {
  position: relative;
  background: white;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 24rpx 64rpx rgba(212, 184, 165, 0.3);
  animation: fadeInScale 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
