/* ==================== 游戏化通用组件库 ==================== */
/* 用于表达训练和感官写作页面的共享样式 */

/* ==================== 升级动画 ==================== */
@keyframes levelUp {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.2);
    opacity: 0.8;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ==================== 徽章解锁动画 ==================== */
@keyframes badgeUnlock {
  0% {
    transform: scale(0) rotate(0deg);
    opacity: 0;
  }
  50% {
    transform: scale(1.3) rotate(180deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) rotate(360deg);
    opacity: 1;
  }
}

/* ==================== 经验值增加动画 ==================== */
@keyframes expGain {
  0% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  50% {
    transform: translateY(-40rpx) scale(1.5);
    opacity: 1;
  }
  100% {
    transform: translateY(-80rpx) scale(0.5);
    opacity: 0;
  }
}

/* ==================== 关卡完成庆祝动画 ==================== */
@keyframes celebrate {
  0%, 100% {
    transform: rotate(0deg) scale(1);
  }
  25% {
    transform: rotate(-10deg) scale(1.1);
  }
  75% {
    transform: rotate(10deg) scale(1.1);
  }
}

/* ==================== 星星闪烁动画 ==================== */
@keyframes starTwinkle {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(0.8);
  }
}

/* ==================== 粒子爆炸效果 ==================== */
.particle-burst {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.particle {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  animation: particleFloat 1s ease-out forwards;
}

@keyframes particleFloat {
  0% {
    transform: translate(0, 0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translate(var(--tx), var(--ty)) scale(0);
    opacity: 0;
  }
}

/* ==================== 进度条填充动画 ==================== */
.progress-fill-animated {
  animation: progressFill 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

@keyframes progressFill {
  0% {
    width: 0%;
  }
  100% {
    width: var(--target-width);
  }
}

/* ==================== 成就提示弹窗 ==================== */
.achievement-toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #F5C6CB 0%, #E8B8BE 100%);
  border-radius: 48rpx;
  box-shadow: 0 12rpx 48rpx rgba(245, 198, 203, 0.5);
  display: flex;
  align-items: center;
  gap: 16rpx;
  animation: toastSlideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes toastSlideIn {
  0% {
    transform: translateX(-50%) translateY(-100rpx);
    opacity: 0;
  }
  100% {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
}

.achievement-icon {
  width: 64rpx;
  height: 64rpx;
  font-size: 48rpx;
  animation: celebrate 0.6s ease-in-out infinite;
}

.achievement-text {
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

/* ==================== 连击计数器 ==================== */
.combo-counter {
  position: fixed;
  top: 200rpx;
  right: 40rpx;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: comboAppear 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes comboAppear {
  0% {
    transform: scale(0);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.combo-number {
  font-size: 72rpx;
  font-weight: 900;
  color: #F5C6CB;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
  animation: comboPulse 0.5s ease-in-out;
}

@keyframes comboPulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.3);
  }
}

.combo-label {
  font-size: 24rpx;
  color: #8B7B6F;
  font-weight: 600;
  margin-top: 8rpx;
}

/* ==================== 关卡解锁特效 ==================== */
.unlock-effect {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 215, 0, 0.6) 0%, transparent 70%);
  animation: unlockPulse 1s ease-out;
  pointer-events: none;
}

@keyframes unlockPulse {
  0% {
    transform: translate(-50%, -50%) scale(0);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(3);
    opacity: 0;
  }
}

/* ==================== 等级提升特效 ==================== */
.level-up-effect {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9998;
  pointer-events: none;
  background: radial-gradient(circle at center, rgba(255, 215, 0, 0.3) 0%, transparent 70%);
  animation: levelUpFlash 1.5s ease-out;
}

@keyframes levelUpFlash {
  0%, 100% {
    opacity: 0;
  }
  50% {
    opacity: 1;
  }
}

/* ==================== 关卡星级评价 ==================== */
.star-rating {
  display: flex;
  gap: 8rpx;
  justify-content: center;
  margin-top: 16rpx;
}

.star {
  width: 48rpx;
  height: 48rpx;
  font-size: 40rpx;
  color: #FFD700;
  animation: starAppear 0.3s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.star:nth-child(1) { animation-delay: 0.1s; }
.star:nth-child(2) { animation-delay: 0.2s; }
.star:nth-child(3) { animation-delay: 0.3s; }

@keyframes starAppear {
  0% {
    transform: scale(0) rotate(-180deg);
    opacity: 0;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

.star.empty {
  color: #E0E0E0;
}

/* ==================== 每日任务提示 ==================== */
.daily-quest-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF5252 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: white;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.2);
  }
}

/* ==================== 加载骨架屏 ==================== */
.skeleton {
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: skeletonLoading 1.5s ease-in-out infinite;
}

@keyframes skeletonLoading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* ==================== 触觉反馈增强 ==================== */
.haptic-feedback:active {
  transform: scale(0.95);
  transition: transform 0.1s ease;
}

/* ==================== 关卡路径连线动画 ==================== */
.path-line-animated {
  background: linear-gradient(180deg,
    rgba(245, 198, 203, 0.3) 0%,
    rgba(212, 184, 165, 0.3) 50%,
    rgba(196, 181, 216, 0.3) 100%
  );
  animation: pathGlow 3s ease-in-out infinite;
}

@keyframes pathGlow {
  0%, 100% {
    opacity: 0.5;
  }
  50% {
    opacity: 1;
  }
}

/* ==================== 新手引导高亮 ==================== */
.tutorial-highlight {
  position: relative;
  z-index: 10000;
}

.tutorial-highlight::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  right: -16rpx;
  bottom: -16rpx;
  border: 4rpx solid #F5C6CB;
  border-radius: 50%;
  animation: tutorialPulse 1.5s ease-in-out infinite;
}

@keyframes tutorialPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.5;
  }
}

/* ==================== 音效可视化反馈 ==================== */
.sound-wave {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2rpx solid rgba(245, 198, 203, 0.5);
  animation: soundWave 1s ease-out;
}

@keyframes soundWave {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}
