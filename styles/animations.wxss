/**
 * 知愈小程序 - 动画系统 v3.0
 *
 * 这是整个小程序的动画库，定义了所有可复用的动画效果
 * 所有页面和组件都应该引用这些动画，确保动画风格统一
 *
 * 创建时间: 2026-04-29
 * 版本: v3.0
 */

/* ==================== 核心动画 ==================== */

/* 1. 呼吸动画 - 用于卡片、图标等元素 */
@keyframes breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.02);
    opacity: 0.95;
  }
}

/* 2. 流动渐变 - 用于背景、按钮等 */
@keyframes gradientFlow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* 3. 浮动效果 - 用于装饰元素 */
@keyframes float {
  0%, 100% {
    transform: translateY(0) translateX(0);
  }
  25% {
    transform: translateY(-10rpx) translateX(5rpx);
  }
  50% {
    transform: translateY(-20rpx) translateX(0);
  }
  75% {
    transform: translateY(-10rpx) translateX(-5rpx);
  }
}

/* 4. 光晕脉冲 - 用于强调元素 */
@keyframes glowPulse {
  0%, 100% {
    box-shadow: 0 0 16rpx rgba(232, 196, 168, 0.3);
  }
  50% {
    box-shadow: 0 0 32rpx rgba(232, 196, 168, 0.6);
  }
}

/* 5. 粒子漂浮 - 用于背景粒子 */
@keyframes particleFloat {
  0% {
    transform: translate(0, 0) rotate(0deg);
    opacity: 0.3;
  }
  25% {
    transform: translate(20rpx, -30rpx) rotate(90deg);
    opacity: 0.5;
  }
  50% {
    transform: translate(0, -60rpx) rotate(180deg);
    opacity: 0.3;
  }
  75% {
    transform: translate(-20rpx, -30rpx) rotate(270deg);
    opacity: 0.5;
  }
  100% {
    transform: translate(0, 0) rotate(360deg);
    opacity: 0.3;
  }
}

/* 6. 光晕漂浮 - 用于背景光晕 */
@keyframes orbFloat {
  0% {
    transform: translate(0, 0) scale(1);
    opacity: 0.15;
  }
  33% {
    transform: translate(30rpx, -40rpx) scale(1.1);
    opacity: 0.25;
  }
  66% {
    transform: translate(-30rpx, -20rpx) scale(0.9);
    opacity: 0.2;
  }
  100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.15;
  }
}

/* 7. 闪光扫过 - 用于按钮、卡片高光 */
@keyframes shimmer {
  0% {
    background-position: -200% center;
  }
  100% {
    background-position: 200% center;
  }
}

/* 8. 淡入上升 - 用于页面元素入场 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 交互动画 ==================== */

/* 点击反馈 - 缩小 */
@keyframes tapShrink {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.92);
  }
  100% {
    transform: scale(1);
  }
}

/* 点击反馈 - 放大 */
@keyframes tapGrow {
  0% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.08);
  }
  100% {
    transform: scale(1);
  }
}

/* 点击波纹 */
@keyframes ripple {
  0% {
    transform: scale(0);
    opacity: 0.6;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

/* 长按反馈 */
@keyframes longPress {
  0% {
    transform: scale(1);
  }
  100% {
    transform: scale(0.95);
  }
}

/* ==================== 加载动画 ==================== */

/* 旋转加载 */
@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 脉冲加载 */
@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 弹跳加载 */
@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

/* 波浪加载 */
@keyframes wave {
  0%, 100% {
    transform: scaleY(1);
  }
  50% {
    transform: scaleY(1.5);
  }
}

/* ==================== 状态动画 ==================== */

/* 成功动画 */
@keyframes success {
  0% {
    transform: scale(0) rotate(0deg);
    opacity: 0;
  }
  50% {
    transform: scale(1.2) rotate(180deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) rotate(360deg);
    opacity: 1;
  }
}

/* 错误抖动 */
@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  10%, 30%, 50%, 70%, 90% {
    transform: translateX(-10rpx);
  }
  20%, 40%, 60%, 80% {
    transform: translateX(10rpx);
  }
}

/* 警告闪烁 */
@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}

/* ==================== 背景动画 ==================== */

/* 背景脉动 */
@keyframes bgPulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.85;
  }
}

/* 背景缩放 */
@keyframes bgZoom {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

/* 背景旋转 */
@keyframes bgRotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* 粒子闪烁 */
@keyframes particleTwinkle {
  0%, 100% {
    opacity: 0.2;
  }
  50% {
    opacity: 0.6;
  }
}

/* ==================== 文字动画 ==================== */

/* 文字光晕 */
@keyframes textGlow {
  0%, 100% {
    text-shadow: 0 0 8rpx rgba(232, 196, 168, 0.3);
  }
  50% {
    text-shadow: 0 0 16rpx rgba(232, 196, 168, 0.6);
  }
}

/* 文字渐显 */
@keyframes textFadeIn {
  from {
    opacity: 0;
    letter-spacing: 0.2em;
  }
  to {
    opacity: 1;
    letter-spacing: 0;
  }
}

/* 文字打字机 */
@keyframes typing {
  from {
    width: 0;
  }
  to {
    width: 100%;
  }
}

/* ==================== 过渡动画 ==================== */

/* 淡入 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 淡出 */
@keyframes fadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

/* 从左滑入 */
@keyframes slideInLeft {
  from {
    transform: translateX(-100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* 从右滑入 */
@keyframes slideInRight {
  from {
    transform: translateX(100%);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

/* 从上滑入 */
@keyframes slideInDown {
  from {
    transform: translateY(-100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 从下滑入 */
@keyframes slideInUp {
  from {
    transform: translateY(100%);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 缩放进入 */
@keyframes zoomIn {
  from {
    transform: scale(0);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* 缩放退出 */
@keyframes zoomOut {
  from {
    transform: scale(1);
    opacity: 1;
  }
  to {
    transform: scale(0);
    opacity: 0;
  }
}

/* ==================== 特殊效果动画 ==================== */

/* 心跳动画 v2.0 - 精致升级版 */
@keyframes heartbeat {
  0%, 100% {
    transform: scale(1);
    filter: drop-shadow(0 4rpx 12rpx rgba(245, 198, 203, 0.2));
  }
  10%, 30% {
    transform: scale(1.15);
    filter: drop-shadow(0 8rpx 24rpx rgba(245, 198, 203, 0.4));
  }
  20%, 40% {
    transform: scale(1.05);
    filter: drop-shadow(0 6rpx 16rpx rgba(245, 198, 203, 0.3));
  }
  50% {
    transform: scale(1);
    filter: drop-shadow(0 4rpx 12rpx rgba(245, 198, 203, 0.2));
  }
}

/* 情绪之心专用动画 - 更柔和的呼吸效果 */
@keyframes emotionHeartPulse {
  0%, 100% {
    transform: scale(1) translateY(0);
    opacity: 1;
    filter: drop-shadow(0 4rpx 16rpx rgba(245, 198, 203, 0.25));
  }
  25% {
    transform: scale(1.08) translateY(-4rpx);
    opacity: 0.95;
    filter: drop-shadow(0 8rpx 24rpx rgba(245, 198, 203, 0.35));
  }
  50% {
    transform: scale(1.12) translateY(-6rpx);
    opacity: 0.98;
    filter: drop-shadow(0 12rpx 32rpx rgba(245, 198, 203, 0.45));
  }
  75% {
    transform: scale(1.08) translateY(-4rpx);
    opacity: 0.95;
    filter: drop-shadow(0 8rpx 24rpx rgba(245, 198, 203, 0.35));
  }
}

/* 情绪之心光晕效果 */
@keyframes emotionHeartGlow {
  0%, 100% {
    box-shadow:
      0 0 20rpx rgba(245, 198, 203, 0.3),
      0 0 40rpx rgba(245, 198, 203, 0.2),
      0 4rpx 16rpx rgba(212, 184, 165, 0.15);
  }
  50% {
    box-shadow:
      0 0 30rpx rgba(245, 198, 203, 0.5),
      0 0 60rpx rgba(245, 198, 203, 0.3),
      0 8rpx 24rpx rgba(212, 184, 165, 0.25);
  }
}

/* 情绪之心涟漪扩散 */
@keyframes emotionHeartRipple {
  0% {
    transform: scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.5);
    opacity: 0.4;
  }
  100% {
    transform: scale(2.2);
    opacity: 0;
  }
}

/* 情绪之心闪烁 */
@keyframes emotionHeartSparkle {
  0%, 100% {
    opacity: 0;
    transform: scale(0) rotate(0deg);
  }
  10% {
    opacity: 1;
    transform: scale(1) rotate(45deg);
  }
  90% {
    opacity: 1;
    transform: scale(1) rotate(315deg);
  }
}

/* 摇摆 */
@keyframes swing {
  0%, 100% {
    transform: rotate(0deg);
  }
  20% {
    transform: rotate(15deg);
  }
  40% {
    transform: rotate(-10deg);
  }
  60% {
    transform: rotate(5deg);
  }
  80% {
    transform: rotate(-5deg);
  }
}

/* 翻转 */
@keyframes flip {
  from {
    transform: perspective(800rpx) rotateY(0);
  }
  to {
    transform: perspective(800rpx) rotateY(360deg);
  }
}

/* 橡皮筋 */
@keyframes rubberBand {
  0%, 100% {
    transform: scale(1);
  }
  30% {
    transform: scaleX(1.25) scaleY(0.75);
  }
  40% {
    transform: scaleX(0.75) scaleY(1.25);
  }
  50% {
    transform: scaleX(1.15) scaleY(0.85);
  }
  65% {
    transform: scaleX(0.95) scaleY(1.05);
  }
  75% {
    transform: scaleX(1.05) scaleY(0.95);
  }
}

/* ==================== 工具类 ==================== */

/* 动画延迟类 */
.animate-delay-100 { animation-delay: 0.1s; }
.animate-delay-200 { animation-delay: 0.2s; }
.animate-delay-300 { animation-delay: 0.3s; }
.animate-delay-400 { animation-delay: 0.4s; }
.animate-delay-500 { animation-delay: 0.5s; }
.animate-delay-600 { animation-delay: 0.6s; }
.animate-delay-700 { animation-delay: 0.7s; }
.animate-delay-800 { animation-delay: 0.8s; }
.animate-delay-900 { animation-delay: 0.9s; }
.animate-delay-1000 { animation-delay: 1s; }

/* 动画时长类 */
.animate-duration-fast { animation-duration: 0.2s; }
.animate-duration-base { animation-duration: 0.3s; }
.animate-duration-slow { animation-duration: 0.5s; }
.animate-duration-slower { animation-duration: 0.8s; }

/* 动画次数类 */
.animate-once { animation-iteration-count: 1; }
.animate-twice { animation-iteration-count: 2; }
.animate-infinite { animation-iteration-count: infinite; }

/* 动画填充模式类 */
.animate-fill-forwards { animation-fill-mode: forwards; }
.animate-fill-backwards { animation-fill-mode: backwards; }
.animate-fill-both { animation-fill-mode: both; }

/* 动画播放状态类 */
.animate-paused { animation-play-state: paused; }
.animate-running { animation-play-state: running; }

/* ==================== 预设动画组合 ==================== */

/* 卡片入场 */
.card-enter {
  animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* 按钮点击 */
.button-tap {
  animation: tapShrink 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 图标呼吸 */
.icon-breathe {
  animation: breathe 4.5s ease-in-out infinite;
}

/* 背景流动 */
.bg-flow {
  animation: gradientFlow 3s ease infinite;
  background-size: 200% 200%;
}

/* 加载旋转 */
.loading-spin {
  animation: spin 1s linear infinite;
}

/* 成功提示 */
.success-pop {
  animation: success 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* 错误提示 */
.error-shake {
  animation: shake 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}
