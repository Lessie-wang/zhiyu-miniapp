.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F0 0%, #FFFFFF 100%);
  padding: calc(env(safe-area-inset-top) + 60rpx) 32rpx 200rpx;
}

/* 页面标题 */
.page-header {
  margin-bottom: 48rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 16rpx;
}

.page-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 隐私政策内容 */
.policy-content {
  max-height: calc(100vh - 280rpx);
}

/* 章节 */
.section {
  margin-bottom: 56rpx;
}

.section-intro {
  display: block;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.section-intro.highlight {
  background: #FFF3E0;
  padding: 24rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #FF9800;
  color: #E65100;
  font-weight: 500;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2C2C;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #E0E0E0;
}

/* 子章节 */
.subsection {
  margin-bottom: 32rpx;
  padding-left: 24rpx;
}

.subsection-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.subsection-text {
  display: block;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.subsection-text.important {
  background: #FFF3E0;
  padding: 16rpx;
  border-radius: 8rpx;
  color: #E65100;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

/* 底部空白 */
.bottom-spacer {
  height: 80rpx;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.primary-btn {
  background: linear-gradient(135deg, #FF9A8B 0%, #FF6A88 100%);
  color: #FFFFFF;
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  background: #F5F5F5;
  color: #666666;
}

.secondary-btn::after {
  border: none;
}

.btn-text {
  font-size: 30rpx;
}
