.container {
  min-height: 100vh;
  background:
    repeating-linear-gradient(90deg, transparent, transparent 100rpx, rgba(212, 184, 165, 0.03) 100rpx, rgba(212, 184, 165, 0.03) 102rpx),
    radial-gradient(circle at 80% 20%, rgba(212, 184, 165, 0.08) 0%, transparent 40%),
    linear-gradient(180deg, #FAF9F7 0%, #F2E6DF 100%);
  padding: calc(env(safe-area-inset-top) + 60rpx) 32rpx 80rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
}

/* 情绪列表 */
.emotion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.emotion-item {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(212, 184, 165, 0.1);
  transition: all 0.3s ease;
}

.emotion-item.expanded {
  box-shadow: 0 12rpx 36rpx rgba(212, 184, 165, 0.2);
}

/* 情绪头部 */
.emotion-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.emotion-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.emotion-color-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.emotion-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.emotion-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sub-range {
  font-size: 22rpx;
  color: #C4BDB5;
}

.arrow {
  font-size: 32rpx;
  color: #C4BDB5;
  transform: rotate(90deg);
  transition: transform 0.3s ease;
  display: inline-block;
}

.arrow-up {
  transform: rotate(-90deg);
}

/* 子情绪标签 */
.sub-emotion-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 0 8rpx;
  animation: fadeIn 0.3s ease;
}

.sub-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 详情区域 */
.emotion-detail {
  margin-top: 24rpx;
  animation: fadeIn 0.3s ease;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #F5F2EF;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #B8B2A7;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.tab-active {
  background: white;
  color: #6D6A65;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 内容区域 */
.detail-content {
  padding: 24rpx;
  background: #FAFAF8;
  border-radius: 16rpx;
  animation: fadeIn 0.2s ease;
}

.detail-text {
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.8;
}

.story-source {
  margin-top: 20rpx;
  text-align: right;
}

.source-text {
  font-size: 22rpx;
  color: #C4BDB5;
  font-style: italic;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 情绪库 CSS 图标 ==================== */

/* 图标容器 */
.elib-css-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- 开心 happy --- */
.elib-happy .el-eye {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  position: absolute;
  top: 12rpx;
}
.elib-happy .el-eye.ell { left: 12rpx; }
.elib-happy .el-eye.elr { right: 12rpx; }
.elib-happy .el-smile {
  width: 18rpx;
  height: 10rpx;
  border: 2.5rpx solid;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* --- 平静 calm --- */
.elib-calm {
  flex-direction: column;
  gap: 6rpx;
}
.elib-calm .el-wave {
  height: 2.5rpx;
  border-radius: 2rpx;
}
.elib-calm .el-wave.ew1 { width: 22rpx; opacity: 0.5; }
.elib-calm .el-wave.ew2 { width: 28rpx; opacity: 0.8; }
.elib-calm .el-wave.ew3 { width: 18rpx; opacity: 0.5; }

/* --- 难过 sad --- */
.elib-sad .el-drop {
  width: 16rpx;
  height: 22rpx;
  border-radius: 50% 50% 50% 50% / 30% 30% 70% 70%;
}

/* --- 累 tired --- */
.elib-tired .el-droop {
  width: 22rpx;
  height: 16rpx;
  border: 2.5rpx solid;
  border-bottom: none;
  border-radius: 22rpx 22rpx 0 0;
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}
.elib-tired .el-droop-dot {
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* --- 烦躁 irritated --- */
.elib-irritated {
  flex-direction: row;
  gap: 2rpx;
}
.elib-irritated .el-zig {
  width: 3rpx;
  border-radius: 2rpx;
}
.elib-irritated .el-zig.ez1 { height: 16rpx; transform: rotate(-25deg); }
.elib-irritated .el-zig.ez2 { height: 22rpx; transform: rotate(25deg); }
.elib-irritated .el-zig.ez3 { height: 12rpx; transform: rotate(-25deg); }

/* --- 焦虑 anxious --- */
.elib-anxious .el-spiral-outer {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid;
  border-radius: 50%;
  position: absolute;
}
.elib-anxious .el-spiral-inner {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid;
  border-radius: 50%;
  position: absolute;
}
.elib-anxious .el-spiral-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  position: absolute;
}

/* --- 愤怒 angry --- */
.elib-angry .el-bolt-top {
  width: 12rpx;
  height: 18rpx;
  clip-path: polygon(50% 0%, 100% 100%, 30% 100%);
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-40%);
}
.elib-angry .el-bolt-bottom {
  width: 12rpx;
  height: 18rpx;
  clip-path: polygon(70% 0%, 50% 100%, 0% 0%);
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-60%);
}

/* --- 感动 touched --- */
.elib-touched .el-heart-l,
.elib-touched .el-heart-r {
  width: 12rpx;
  height: 18rpx;
  border-radius: 12rpx 12rpx 0 0;
  position: absolute;
  bottom: 10rpx;
}
.elib-touched .el-heart-l { transform: rotate(-45deg); left: 10rpx; }
.elib-touched .el-heart-r { transform: rotate(45deg); right: 10rpx; }

/* --- 困惑 confused --- */
.elib-confused .el-q-curve {
  width: 14rpx;
  height: 18rpx;
  border: 2.5rpx solid;
  border-left: none;
  border-bottom: none;
  border-radius: 0 14rpx 0 0;
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}
.elib-confused .el-q-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* --- 无聊 bored --- */
.elib-bored .el-line {
  width: 22rpx;
  height: 2.5rpx;
  border-radius: 2rpx;
  position: absolute;
  top: 14rpx;
  opacity: 0.5;
}
.elib-bored .el-yawn {
  width: 14rpx;
  height: 8rpx;
  border: 2.5rpx solid;
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
  position: absolute;
  bottom: 12rpx;
  opacity: 0.7;
}

/* --- 震惊 shocked --- */
.elib-shocked .el-star-circle {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  position: absolute;
}
.elib-shocked .el-ray {
  position: absolute;
  width: 2.5rpx;
  height: 10rpx;
  border-radius: 2rpx;
}
.elib-shocked .el-ray.er1 { top: 4rpx; transform: rotate(0deg); }
.elib-shocked .el-ray.er2 { bottom: 4rpx; transform: rotate(0deg); }
.elib-shocked .el-ray.er3 { left: 6rpx; transform: rotate(90deg); }
.elib-shocked .el-ray.er4 { right: 6rpx; transform: rotate(90deg); }

/* --- 不知道 unknown --- */
.elib-unknown .el-cloud-main {
  width: 20rpx;
  height: 10rpx;
  border-radius: 10rpx;
  position: absolute;
  bottom: 14rpx;
  opacity: 0.5;
}
.elib-unknown .el-cloud-top {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  opacity: 0.4;
}
.elib-unknown .el-cloud-q {
  width: 3rpx;
  height: 3rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  opacity: 0.6;
}

/* ==================== 标签页 CSS 图标 ==================== */

.tab-icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 大脑图标（理论解读） */
.tab-icon-brain {
  width: 22rpx;
  height: 20rpx;
  display: flex;
  gap: 2rpx;
}
.tab-icon-brain .brain-l,
.tab-icon-brain .brain-r {
  flex: 1;
  border: 2rpx solid #B8B2A7;
  border-radius: 10rpx 0 0 10rpx;
}
.tab-icon-brain .brain-r {
  border-radius: 0 10rpx 10rpx 0;
}
.tab-active .tab-icon-brain .brain-l,
.tab-active .tab-icon-brain .brain-r {
  border-color: #6D6A65;
}

/* 书本图标（故事解读） */
.tab-icon-book {
  width: 22rpx;
  height: 18rpx;
  display: flex;
  align-items: center;
}
.tab-icon-book .tbook-spine {
  width: 3rpx;
  height: 18rpx;
  background: #B8B2A7;
  border-radius: 2rpx;
  flex-shrink: 0;
}
.tab-icon-book .tbook-body {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #B8B2A7;
  border-left: none;
  border-radius: 0 4rpx 4rpx 0;
  margin-left: 1rpx;
}
.tab-active .tab-icon-book .tbook-spine {
  background: #6D6A65;
}
.tab-active .tab-icon-book .tbook-body {
  border-color: #6D6A65;
}
