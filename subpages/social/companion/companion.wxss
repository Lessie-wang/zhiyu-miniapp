/* 陪伴者管理页面样式 */
.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 30% 20%, rgba(245, 198, 203, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at top left, #FAF9F7 0%, #F5F0EB 40%, #F2E6DF 100%);
  padding: calc(env(safe-area-inset-top) + 60rpx) 40rpx 160rpx;
  position: relative;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #6D6A65;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.6;
}

/* 添加陪伴者卡片 */
.add-companion-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-icon custom-icon {
  color: white;
}

.add-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.add-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #6D6A65;
}

.add-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

.add-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 40rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.25);
}

.add-btn::after {
  border: none;
}

.add-btn .btn-text {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
}

/* 分享绑定说明卡片 */
.share-guide-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  border: 1rpx solid rgba(245, 198, 203, 0.3);
}

.guide-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.guide-icon {
  flex-shrink: 0;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.guide-steps {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-number {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #F5C6CB 0%, #E8B8BE 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.6;
  padding-top: 6rpx;
}

/* 陪伴者列表 */
.companions-section {
  margin-bottom: 40rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 24rpx;
}

.companion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.companion-card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.companion-avatar {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 40rpx;
  color: white;
  font-weight: 700;
}

.companion-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.companion-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
}

.companion-relation {
  font-size: 24rpx;
  color: #B8B2A7;
}

.companion-status {
  font-size: 24rpx;
  color: #B8B2A7;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  display: inline-block;
}

.status-dot.active {
  background: #7BC96F;
}

.status-dot.pending {
  background: #F5A623;
}

.companion-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: #F2E6DF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.action-btn::after {
  border: none;
}

.action-icon {
  font-size: 28rpx;
}

.remove-btn:active {
  background: #FFE5E5;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
}

.empty-desc {
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.6;
  max-width: 500rpx;
}

/* 权限设置说明 */
.permission-info-card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.info-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 24rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-icon {
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-text {
  flex: 1;
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.6;
}

/* 功能介绍 */
.features-section {
  margin-bottom: 40rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
}

.feature-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.feature-desc {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

/* ==================== 知愈风格输入弹窗（单行） ==================== */

.zh-input-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8rpx);
  animation: fadeIn 0.3s ease;
}

.modal-content {
  position: relative;
  width: 640rpx;
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.98) 0%,
    rgba(250, 249, 247, 0.98) 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow:
    0 24rpx 64rpx rgba(0, 0, 0, 0.15),
    0 8rpx 24rpx rgba(0, 0, 0, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.modal-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid rgba(212, 184, 165, 0.15);
}

.modal-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.modal-subtitle {
  display: block;
  font-size: 26rpx;
  color: #9B9892;
  line-height: 1.5;
}

/* 单行输入区域 */
.input-paper {
  position: relative;
  background: linear-gradient(to bottom,
    #FFFEF9 0%,
    #FFFCF5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(212, 184, 165, 0.2);
}

.zh-input {
  width: 100%;
  font-size: 32rpx;
  line-height: 1.5;
  color: #6D6A65;
  background: transparent;
  border: none;
  padding: 0;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 32rpx;
  font-size: 24rpx;
  color: #B8B2A7;
  font-weight: 500;
}

/* 按钮组 */
.modal-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  border: none;
}

.modal-button-cancel {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 243, 238, 0.9) 100%);
  color: #9B9892;
  border: 2rpx solid rgba(212, 184, 165, 0.3);
}

.modal-button-cancel:active {
  transform: scale(0.96);
  background: rgba(248, 243, 238, 0.95);
}

.modal-button-confirm {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: #FFFFFF;
  box-shadow:
    0 8rpx 24rpx rgba(212, 184, 165, 0.35),
    0 2rpx 8rpx rgba(212, 184, 165, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
}

.modal-button-confirm:active {
  transform: scale(0.96);
  box-shadow:
    0 4rpx 12rpx rgba(212, 184, 165, 0.3),
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
