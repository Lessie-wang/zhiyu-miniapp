/* 陪伴者接受邀请页面样式 */
@import '/styles/card-system.wxss';

.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 30% 20%, rgba(245, 198, 203, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at top left, #FAF9F7 0%, #F5F0EB 40%, #F2E6DF 100%);
  padding: calc(env(safe-area-inset-top) + 60rpx) 40rpx 160rpx;
}

/* 邀请信息卡片 */
.invite-card {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(212, 184, 165, 0.15);
  margin-bottom: 40rpx;
}

.invite-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.invite-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.invite-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #6D6A65;
  line-height: 1.5;
}

.invite-content {
  margin-bottom: 40rpx;
}

.invite-desc {
  display: block;
  font-size: 28rpx;
  color: #8C8780;
  margin-bottom: 24rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
}

.feature-icon {
  flex-shrink: 0;
}

.feature-text {
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.6;
  flex: 1;
}

.invite-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.accept-btn,
.decline-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.accept-btn {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.3);
}

.accept-btn .btn-text {
  color: white;
}

.accept-btn[disabled] {
  opacity: 0.6;
}

.decline-btn {
  background: white;
  border: 2rpx solid #E8E3DD;
}

.decline-btn .btn-text {
  color: #8C8780;
}

.accept-btn::after,
.decline-btn::after {
  border: none;
}

/* 输入邀请码卡片 */
.input-code-card {
  background: white;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(212, 184, 165, 0.15);
  margin-bottom: 40rpx;
}

.input-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.input-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.input-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #6D6A65;
}

.input-content {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.code-input {
  flex: 1;
  height: 88rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
  text-align: center;
  letter-spacing: 4rpx;
}

.verify-btn {
  width: 160rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.25);
}

.verify-btn .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: white;
}

.verify-btn[disabled] {
  opacity: 0.5;
}

.verify-btn::after {
  border: none;
}

.input-hint {
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.6;
}

/* 隐私说明卡片 */
.privacy-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(245, 198, 203, 0.3);
}

.privacy-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 20rpx;
}

.privacy-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.privacy-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.privacy-icon {
  width: 28rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: white;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.privacy-text {
  flex: 1;
  font-size: 24rpx;
  color: #6D6A65;
  line-height: 1.6;
}
