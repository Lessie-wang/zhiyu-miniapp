/* 陪伴者视图页面样式 */
@import '/styles/card-system.wxss';
@import '/styles/animations.wxss';

.container {
  min-height: 100vh;
  background:
    radial-gradient(circle at 30% 20%, rgba(245, 198, 203, 0.12) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(212, 184, 165, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at top left, #FAF9F7 0%, #F5F0EB 40%, #F2E6DF 100%);
  padding: calc(env(safe-area-inset-top) + 60rpx) 40rpx 160rpx;
}

/* 用户信息卡片 */
.user-info-card {
  background: white;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(212, 184, 165, 0.15);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  color: white;
  font-weight: 700;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 8rpx;
}

.user-relation {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
}

/* 经期状态卡片 */
.period-status-card {
  background: white;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.card-icon {
  flex-shrink: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #6D6A65;
}

.period-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #8C8780;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.period-phase {
  text-align: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #FFE8E8 0%, #FFD6D6 100%);
  border-radius: 20rpx;
  margin-top: 20rpx;
}

.phase-icon {
  display: block;
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.phase-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
}

.phase-desc {
  display: block;
  font-size: 24rpx;
  color: #8C8780;
  margin-top: 8rpx;
}

/* 情绪趋势卡片 */
.emotion-trend-card {
  background: white;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.trend-chart {
  margin-top: 24rpx;
}

.chart-placeholder {
  height: 400rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 16rpx;
}

.placeholder-icon {
  font-size: 64rpx;
}

.placeholder-text {
  font-size: 26rpx;
  color: #B8B2A7;
}

.emotion-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.emotion-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
}

.emotion-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.emotion-info {
  flex: 1;
}

.emotion-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 4rpx;
}

.emotion-time {
  display: block;
  font-size: 24rpx;
  color: #B8B2A7;
}

.emotion-intensity {
  display: flex;
  gap: 4rpx;
}

.intensity-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E8E3DD;
}

.intensity-dot.active {
  background: #D4B8A5;
}

/* 关怀建议卡片 */
.care-suggestion-card {
  background: linear-gradient(135deg, #F5E6D3 0%, #E8D4BF 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.12);
}

.suggestion-content {
  margin-top: 20rpx;
}

.suggestion-text {
  display: block;
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.suggestion-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  background: white;
  border-radius: 40rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(212, 184, 165, 0.15);
}

.action-btn .btn-icon {
  flex-shrink: 0;
}

.action-btn .btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D6A65;
}

.action-btn::after {
  border: none;
}

/* 痛经提醒 */
.pain-alert {
  background: linear-gradient(135deg, #FFE8E8 0%, #FFD6D6 100%);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  animation: pulse 2s ease-in-out infinite;
}

.alert-icon {
  flex-shrink: 0;
}

.alert-content {
  flex: 1;
}

.alert-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #E74C3C;
  margin-bottom: 8rpx;
}

.alert-desc {
  display: block;
  font-size: 24rpx;
  color: #8C8780;
  line-height: 1.6;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 4rpx 12rpx rgba(231, 76, 60, 0.15);
  }
  50% {
    transform: scale(1.02);
    box-shadow: 0 8rpx 24rpx rgba(231, 76, 60, 0.25);
  }
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #6D6A65;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #B8B2A7;
  line-height: 1.6;
}
