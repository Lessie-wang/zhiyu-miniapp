/* 模拟对话训练页面样式 - 高级透明质感版 */
page {
  box-sizing: border-box;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 25% 35%, rgba(196, 212, 181, 0.12) 0%, transparent 45%),
    radial-gradient(circle at 75% 65%, rgba(196, 181, 216, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 50% 85%, rgba(245, 198, 203, 0.08) 0%, transparent 40%),
    linear-gradient(180deg, #FFE8E0 0%, #FAF9F7 50%, #F5E6D3 100%);
}

.container {
  min-height: 100vh;
  background: transparent;
  padding: calc(env(safe-area-inset-top) + 60rpx) 0 0;
  align-items: stretch;
  justify-content: flex-start;
}

/* ==================== 加载阶段 ==================== */
.phase-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(212, 184, 165, 0.3);
  border-top-color: #D4B8A5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #B8B2A7;
}

/* ==================== 介绍阶段 ==================== */
.phase-intro {
  padding: 40rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.intro-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 253, 248, 0.65) 100%
  );
  backdrop-filter: blur(40rpx) saturate(180%);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.intro-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FAF0EB 0%, #F0E0D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

/* CSS 场景图标 */
/* 日常沟通 - 对话气泡 */
.scene-icon-chat {
  width: 44rpx;
  height: 36rpx;
  position: relative;
}
.scene-icon-chat .si-part1 {
  width: 32rpx;
  height: 22rpx;
  background: #D4B8A5;
  border-radius: 12rpx;
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0.8;
}
.scene-icon-chat .si-part2 {
  position: absolute;
  bottom: 8rpx;
  left: 6rpx;
  width: 0;
  height: 0;
  border-right: 8rpx solid #D4B8A5;
  border-bottom: 6rpx solid transparent;
  opacity: 0.8;
}
.scene-icon-chat .si-part3 {
  width: 24rpx;
  height: 16rpx;
  border: 3rpx solid #C4A893;
  border-radius: 10rpx;
  position: absolute;
  bottom: 0;
  right: 0;
  opacity: 0.6;
}

/* 表达拒绝 - 盾牌 */
.scene-icon-shield {
  width: 36rpx;
  height: 42rpx;
  position: relative;
}
.scene-icon-shield .si-part1 {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #D4B8A5;
  border-radius: 4rpx 4rpx 18rpx 18rpx;
  position: absolute;
  top: 0;
  left: 0;
}
.scene-icon-shield .si-part2 {
  width: 3rpx;
  height: 20rpx;
  background: #D4B8A5;
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
}
.scene-icon-shield .si-part3 {
  width: 16rpx;
  height: 3rpx;
  background: #D4B8A5;
  position: absolute;
  top: 18rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 处理冲突 - 闪电 */
.scene-icon-bolt {
  width: 28rpx;
  height: 40rpx;
  position: relative;
}
.scene-icon-bolt .si-part1 {
  width: 16rpx;
  height: 22rpx;
  background: #D4B8A5;
  position: absolute;
  top: 0;
  left: 4rpx;
  clip-path: polygon(100% 0, 0 100%, 60% 100%);
}
.scene-icon-bolt .si-part2 {
  width: 16rpx;
  height: 22rpx;
  background: #C4A893;
  position: absolute;
  bottom: 0;
  right: 4rpx;
  clip-path: polygon(40% 0, 0% 0%, 100% 100%);
}
.scene-icon-bolt .si-part3 {
  display: none;
}

/* 安慰他人 - 爱心 */
.scene-icon-heart {
  width: 40rpx;
  height: 36rpx;
  position: relative;
}
.scene-icon-heart .si-part1 {
  width: 20rpx;
  height: 20rpx;
  background: #D4B8A5;
  border-radius: 50% 50% 0 0;
  position: absolute;
  top: 0;
  left: 2rpx;
  transform: rotate(-45deg);
  opacity: 0.8;
}
.scene-icon-heart .si-part2 {
  width: 20rpx;
  height: 20rpx;
  background: #D4B8A5;
  border-radius: 50% 50% 0 0;
  position: absolute;
  top: 0;
  right: 2rpx;
  transform: rotate(45deg);
  opacity: 0.8;
}
.scene-icon-heart .si-part3 {
  display: none;
}

/* 自定义场景 - 铅笔 */
.scene-icon-custom {
  width: 36rpx;
  height: 36rpx;
  position: relative;
}
.scene-icon-custom .si-part1 {
  width: 6rpx;
  height: 28rpx;
  background: #D4B8A5;
  border-radius: 2rpx 2rpx 0 0;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%) rotate(-30deg);
  transform-origin: bottom center;
}
.scene-icon-custom .si-part2 {
  position: absolute;
  bottom: 2rpx;
  left: 6rpx;
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 8rpx solid #C4A893;
  transform: rotate(-30deg);
}
.scene-icon-custom .si-part3 {
  display: none;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 16rpx;
}

.intro-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.difficulty-tag {
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: white;
  font-weight: 500;
}

.focus-text {
  font-size: 24rpx;
  color: #B8B2A7;
}

.intro-bg {
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.8;
  text-align: center;
  margin-bottom: 32rpx;
}

.intro-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  width: 100%;
}

/* 灯泡图标 */
.tip-icon {
  width: 28rpx;
  height: 32rpx;
  position: relative;
  flex-shrink: 0;
}
.tip-bulb {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #D4B8A5;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.tip-base {
  width: 10rpx;
  height: 6rpx;
  border: 2rpx solid #D4B8A5;
  border-top: none;
  border-radius: 0 0 4rpx 4rpx;
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
}

.tip-text {
  font-size: 24rpx;
  color: #B8B2A7;
  line-height: 1.6;
}

.start-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 16rpx;
  border: none;
  color: white;
}

.start-btn::after {
  border: none;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: white;
}

.btn-arrow {
  font-size: 30rpx;
  color: white;
}

.back-link {
  text-align: center;
  margin-top: 32rpx;
}

.back-text {
  font-size: 26rpx;
  color: #B8B2A7;
}

/* ==================== 对话阶段 ==================== */
.phase-dialogue {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.dialogue-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  margin-top: calc(env(safe-area-inset-top) + 60rpx);
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(30rpx);
  border-bottom: 1rpx solid rgba(212, 184, 165, 0.15);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
}

.header-round {
  font-size: 24rpx;
  color: #B8B2A7;
  padding: 4rpx 16rpx;
  background: #FAF9F7;
  border-radius: 12rpx;
}

.end-btn {
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(212, 184, 165, 0.5);
  border-radius: 20rpx;
}

.end-btn-text {
  font-size: 24rpx;
  color: #C4A893;
}

.scene-banner {
  padding: 16rpx 32rpx;
  background: rgba(212, 184, 165, 0.08);
  flex-shrink: 0;
}

.scene-banner-text {
  font-size: 22rpx;
  color: #B8B2A7;
  line-height: 1.5;
}

/* 对话滚动区 */
.dialogue-scroll {
  flex: 1;
  padding: 24rpx 0;
  overflow-y: auto;
  min-height: 0;
}

.dialogue-messages {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx 120rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.msg-npc {
  justify-content: flex-start;
  gap: 12rpx;
}

.msg-user {
  justify-content: flex-end;
}

.msg-coach {
  justify-content: center;
}

/* 头像 */
.msg-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FAF9F7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-avatar {
  font-size: 28rpx;
}

/* 气泡 */
.msg-bubble {
  max-width: 70%;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.npc-bubble {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(212, 184, 165, 0.1);
}

.user-bubble {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.msg-name {
  display: block;
  font-size: 22rpx;
  color: #B8B2A7;
  margin-bottom: 6rpx;
}

.npc-bubble .msg-text {
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.7;
}

.user-bubble .msg-text {
  font-size: 28rpx;
  color: white;
  line-height: 1.7;
}

/* 思考中动画 */
.thinking-bubble {
  padding: 24rpx 32rpx;
}

.thinking-dots {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.thinking-dots .dot {
  width: 10rpx;
  height: 10rpx;
  background: #D4B8A5;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.thinking-dots .d1 { animation-delay: 0s; }
.thinking-dots .d2 { animation-delay: 0.2s; }
.thinking-dots .d3 { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}

/* 小知旁白卡片 */
.coach-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 18rpx 24rpx;
  background: rgba(212, 184, 165, 0.08);
  border: 1rpx dashed rgba(212, 184, 165, 0.4);
  border-radius: 16rpx;
  max-width: 85%;
}

.coach-icon {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.coach-bulb {
  width: 16rpx;
  height: 16rpx;
  background: #D4B8A5;
  border-radius: 50%;
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  opacity: 0.7;
}

.coach-rays {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #D4B8A5;
  border-radius: 50%;
  position: absolute;
  top: -4rpx;
  left: 50%;
  transform: translateX(-50%);
  opacity: 0.3;
}

.coach-content {
  flex: 1;
}

.coach-label {
  display: block;
  font-size: 20rpx;
  color: #C4A893;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.coach-text {
  font-size: 24rpx;
  color: #8a8278;
  line-height: 1.6;
}

/* 输入区 - 固定在底部 */
.input-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx) saturate(180%);
  border-top: 1rpx solid rgba(212, 184, 165, 0.15);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.input-field {
  flex: 1;
  padding: 18rpx 24rpx;
  background: #FAF9F7;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #6D6A65;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn.disabled {
  opacity: 0.5;
}

.send-arrow {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid white;
  margin-left: 4rpx;
}

/* ==================== 总结阶段 ==================== */
.phase-summary {
  padding: 40rpx;
  min-height: 100vh;
}

.summary-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 32rpx;
}

/* 得分卡片 */
.score-card {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.75) 0%,
    rgba(255, 253, 248, 0.65) 100%
  );
  backdrop-filter: blur(40rpx) saturate(180%);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 8rpx 32rpx rgba(212, 184, 165, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  margin-bottom: 32rpx;
}

.score-ring {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid #D4B8A5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.score-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #6D6A65;
}

.score-rating {
  font-size: 36rpx;
  font-weight: 700;
  color: #D4B8A5;
  margin-bottom: 8rpx;
}

.score-scene {
  font-size: 24rpx;
  color: #B8B2A7;
}

/* 总结区块 */
.summary-section {
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.7) 0%,
    rgba(255, 253, 248, 0.6) 100%
  );
  backdrop-filter: blur(30rpx) saturate(160%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 4rpx 16rpx rgba(212, 184, 165, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.section-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

/* 星星图标 - 亮点 */
.star-icon {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}
.star-arm {
  position: absolute;
  background: #D4B8A5;
  border-radius: 2rpx;
}
.star-arm.sa1 {
  width: 3rpx;
  height: 24rpx;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.star-arm.sa2 {
  width: 24rpx;
  height: 3rpx;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
}
.star-arm.sa3 {
  width: 3rpx;
  height: 16rpx;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
}
.star-arm.sa4 {
  width: 3rpx;
  height: 16rpx;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-45deg);
}

/* 嫩芽图标 - 改进 */
.sprout-icon {
  width: 24rpx;
  height: 28rpx;
  position: relative;
}
.sprout-stem {
  width: 3rpx;
  height: 18rpx;
  background: #A8C5A0;
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 2rpx;
}
.sprout-leaf1 {
  width: 12rpx;
  height: 10rpx;
  border: 2rpx solid #A8C5A0;
  border-radius: 0 50% 50% 0;
  border-left: none;
  position: absolute;
  top: 4rpx;
  left: 50%;
}
.sprout-leaf2 {
  width: 10rpx;
  height: 8rpx;
  border: 2rpx solid #A8C5A0;
  border-radius: 50% 0 0 50%;
  border-right: none;
  position: absolute;
  top: 10rpx;
  right: 50%;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #6D6A65;
  margin-bottom: 20rpx;
}

.section-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.item-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.good-dot {
  background: #D4B8A5;
}

.improve-dot {
  background: #A8C5A0;
}

.item-text {
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.7;
}

/* 核心建议卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 32rpx;
  background: rgba(212, 184, 165, 0.1);
  border-radius: 20rpx;
  border: 1rpx dashed rgba(212, 184, 165, 0.4);
  margin-bottom: 40rpx;
}

.tip-card-icon {
  width: 32rpx;
  height: 36rpx;
  position: relative;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-card-text {
  font-size: 26rpx;
  color: #6D6A65;
  line-height: 1.8;
}

/* 操作按钮 */
.summary-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  text-align: center;
}

.action-btn::after {
  border: none;
}

.retry-btn {
  background: linear-gradient(135deg, #D4B8A5 0%, #C4A893 100%);
  color: white;
}

.next-btn {
  background: linear-gradient(135deg, #C4D4B5 0%, #A8C49A 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(164, 196, 154, 0.3);
}

.back-btn {
  background: white;
  color: #6D6A65;
  border: 2rpx solid rgba(212, 184, 165, 0.3);
}
