/* 游戏式互动引导样式 */

/* 引导容器 */
.guide-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  pointer-events: auto;
}

/* 半透明遮罩 */
.guide-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  animation: maskFadeIn 0.3s ease-out;
}

/* 高亮镂空区域 */
.guide-spotlight {
  position: absolute;
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.7);
  border: 3rpx solid #FFD700;
  pointer-events: none;
  animation: spotlightPulse 2s ease-in-out infinite;
  z-index: 10000;
}

/* 引导卡片 */
.guide-card {
  position: absolute;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAF9F7 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  z-index: 10001;
  pointer-events: auto;
}

.guide-card-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 箭头指示 */
.guide-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
}

.guide-arrow.top {
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  border-width: 0 20rpx 20rpx 20rpx;
  border-color: transparent transparent #FFFFFF transparent;
  filter: drop-shadow(0 -4rpx 8rpx rgba(0, 0, 0, 0.1));
}

.guide-arrow.bottom {
  bottom: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  border-width: 20rpx 20rpx 0 20rpx;
  border-color: #FFFFFF transparent transparent transparent;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

.guide-arrow.left {
  left: -20rpx;
  top: 50%;
  transform: translateY(-50%);
  border-width: 20rpx 20rpx 20rpx 0;
  border-color: transparent #FFFFFF transparent transparent;
  filter: drop-shadow(-4rpx 0 8rpx rgba(0, 0, 0, 0.1));
}

.guide-arrow.right {
  right: -20rpx;
  top: 50%;
  transform: translateY(-50%);
  border-width: 20rpx 0 20rpx 20rpx;
  border-color: transparent transparent transparent #FFFFFF;
  filter: drop-shadow(4rpx 0 8rpx rgba(0, 0, 0, 0.1));
}

/* 卡片头部 */
.guide-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.guide-icon {
  font-size: 48rpx;
  line-height: 1;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #D4B8A5;
  flex: 1;
}

/* 描述文本 */
.guide-description {
  font-size: 28rpx;
  color: #6D6A65;
  line-height: 1.6;
}

/* 操作提示 */
.guide-action-hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF5D6 100%);
  border-radius: 16rpx;
  border: 2rpx dashed #FFD700;
}

.hint-icon {
  font-size: 32rpx;
  animation: hintBounce 1s ease-in-out infinite;
}

.hint-text {
  font-size: 26rpx;
  color: #8A7A5E;
  font-weight: 500;
}

/* 底部操作栏 */
.guide-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

/* 进度指示器 */
.guide-progress {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.progress-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E8E8E8;
  transition: all 0.3s ease;
}

.progress-dot.active {
  width: 32rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
}

/* 操作按钮 */
.guide-buttons {
  display: flex;
  gap: 16rpx;
}

.guide-btn {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.skip-btn {
  color: #B8B2A7;
  background: rgba(184, 178, 167, 0.1);
}

.next-btn {
  color: white;
  background: linear-gradient(90deg, #D4B8A5 0%, #C4A893 100%);
  box-shadow: 0 8rpx 24rpx rgba(212, 184, 165, 0.3);
}

/* 手指点击动画 */
.guide-finger {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  z-index: 10002;
  pointer-events: none;
  animation: fingerBounce 1.5s ease-in-out infinite;
}

.finger-icon {
  font-size: 64rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.3));
}

.finger-ripple {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #FFD700;
  animation: rippleExpand 1.5s ease-out infinite;
}

/* 动画定义 */
@keyframes maskFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes spotlightPulse {
  0%, 100% {
    border-color: #FFD700;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.7),
                0 0 20rpx #FFD700;
  }
  50% {
    border-color: #FFA500;
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.7),
                0 0 40rpx #FFA500;
  }
}

@keyframes hintBounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-8rpx);
  }
}

@keyframes fingerBounce {
  0%, 100% {
    transform: translateY(0) scale(1);
  }
  50% {
    transform: translateY(-20rpx) scale(1.1);
  }
}

@keyframes rippleExpand {
  0% {
    width: 80rpx;
    height: 80rpx;
    opacity: 1;
  }
  100% {
    width: 160rpx;
    height: 160rpx;
    opacity: 0;
  }
}
