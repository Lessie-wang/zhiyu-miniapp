/**
 * 知愈小程序 - 加载组件样式
 */

.zh-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
}

/* ==================== 旋转加载 ==================== */

.zh-loading__spinner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.zh-loading__spinner-icon {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid;
  border-radius: var(--radius-full);
  animation: spin 0.8s linear infinite;
}

/* ==================== 点点加载 ==================== */

.zh-loading__dots {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.zh-loading__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  animation: bounce 1.4s ease-in-out infinite;
}

.zh-loading__dot:nth-child(1) {
  animation-delay: -0.32s;
}

.zh-loading__dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ==================== 波浪加载 ==================== */

.zh-loading__wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 60rpx;
}

.zh-loading__wave-bar {
  width: 6rpx;
  height: 100%;
  border-radius: var(--radius-sm);
  animation: wave 1.2s ease-in-out infinite;
}

.zh-loading__wave-bar:nth-child(1) {
  animation-delay: -1.2s;
}

.zh-loading__wave-bar:nth-child(2) {
  animation-delay: -1.1s;
}

.zh-loading__wave-bar:nth-child(3) {
  animation-delay: -1.0s;
}

.zh-loading__wave-bar:nth-child(4) {
  animation-delay: -0.9s;
}

.zh-loading__wave-bar:nth-child(5) {
  animation-delay: -0.8s;
}

@keyframes wave {
  0%, 40%, 100% {
    transform: scaleY(0.4);
  }
  20% {
    transform: scaleY(1);
  }
}

/* ==================== 加载文字 ==================== */

.zh-loading__text {
  font-size: var(--font-size-sm);
  opacity: 0.8;
}
